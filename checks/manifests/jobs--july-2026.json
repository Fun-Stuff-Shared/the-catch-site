      "id": "bls-empsit-2026-07",
      "title": "The Employment Situation, July 2026",
      "publisher": "Bureau of Labor Statistics",
      "date": "2026-08-07",
      "url": "https://www.bls.gov/news.release/empsit.nr0.htm",
      "pinned_path": "data/sources/bls-empsit-2026-07.txt",
