      "text_sha256": "sha256:7fbdbd10442d09d848888e8b208d209d78e025d7b91a6705f1c323cb918d2737",
      "quote": "Total nonfarm payroll employment changed little in July (-23,000)",
      "quote_span_check": "byte_exact",
      "about": "The government's monthly jobs report: the Bureau of Labor Statistics counts payroll jobs through a survey of employers and measures unemployment through a survey of households, and publishes both in this release."
    },
    {
      "id": "bls-prebmk-2026",
      "title": "Preliminary benchmark revision to establishment survey data",
      "publisher": "Bureau of Labor Statistics",
      "date": "2026-08-28",
      "url": "https://www.bls.gov/news.release/embargo/prebmk.nr0.htm",
      "pinned_path": "data/sources/bls-prebmk-2026.txt",
      "text_path": "data/sources/bls-prebmk-2026.txt",
      "text_sha256": "sha256:c31204e08e5e6746268d387176b3550d91f6c95f8ad5d2cb8428b8da7ea9cc8f",
      "quote": "to total nonfarm employment for March 2026 was -79,000 (-0.1 percent)",
      "quote_span_check": "byte_exact",
      "about": "Once a year the agency checks its survey-based payroll count against near-complete state unemployment-insurance records. This release reports how far off the survey was as of March 2026."
    },
