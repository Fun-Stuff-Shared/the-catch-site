    32	const minutesDueDate = new Date(`${decisionDate}T12:00:00Z`);
    33	minutesDueDate.setUTCDate(minutesDueDate.getUTCDate() + 21);
    34	const minutesDueLabel = new Intl.DateTimeFormat("en-US", { month: "long", day: "numeric", timeZone: "UTC" }).format(minutesDueDate);
    35	
    36	export const computed = {
    37	  observationCount: history.length,
    38	  lowerThanCurrentMidpoint: below,
    39	  equalToCurrentMidpoint: equal,
    40	  currentMidpoint: midpoint,
    41	  currentPercentile: Number(percentile.toFixed(1)),
    42	  priorRangeDays: daysBetween(priorChange.date, decisionDate),
    43	  priorRangeStart: priorChange.date,
    44	  voteFor: vote[0],
    45	  voteAgainst: vote[1],
    46	  minutesDueDate: minutesDueDate.toISOString().slice(0, 10),
    47	  minutesDueLabel,
