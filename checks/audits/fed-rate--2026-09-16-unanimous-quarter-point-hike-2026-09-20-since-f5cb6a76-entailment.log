     3	
     4	const source = (name) => readFileSync(join(process.cwd(), "data/sources/fed-rate", name), "utf8");
     5	const rows = (name, field) => source(name).trim().split(/\r?\n/).slice(1).flatMap((line) => {
     6	  const [date, raw] = line.split(",");
     7	  const value = Number(raw);
     8	  return date && Number.isFinite(value) ? [{ date, value, field }] : [];
     9	});
    10	const daysBetween = (a, b) => Math.round((Date.parse(b) - Date.parse(a)) / 86_400_000);
    11	
    12	const oldTarget = rows("DFEDTAR-2026-09-19.csv", "DFEDTAR");
    13	const upperTarget = rows("DFEDTARU-2026-09-19.csv", "DFEDTARU");
    14	const history = [...oldTarget, ...upperTarget];
    15	const decisionDate = "2026-09-16";
    16	const effectiveDate = "2026-09-17";
    17	const previousIncreaseDate = "2023-07-27";
    18	const range = { lower: 3.75, upper: 4 };
    19	const midpoint = (range.lower + range.upper) / 2;
    20	const upperChanges = upperTarget.filter((row, index) => index > 0 && row.value !== upperTarget[index - 1].value);
    21	const priorChange = [...upperChanges].reverse().find((row) => row.date < effectiveDate);
    22	const below = history.filter((row) => row.value < midpoint).length;
    23	const equal = history.filter((row) => row.value === midpoint).length;
    24	const percentile = ((below + equal / 2) / history.length) * 100;
    25	
    26	const pathRows = upperTarget.filter((row) => row.date >= "2024-01-01" && row.date <= "2026-09-19");
    27	const startRow = pathRows[0];
    28	const changes = upperChanges.filter((row) => row.date >= startRow.date && row.date <= "2026-09-19");
    29	
    30	const septemberStatement = source("fomc-statement-2026-09-16.txt");
