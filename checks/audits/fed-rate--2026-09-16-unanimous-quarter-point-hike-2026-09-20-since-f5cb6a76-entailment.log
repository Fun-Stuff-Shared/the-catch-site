    49	
    50	export const event = {
    51	  slug: "fed-rate/2026-09-16-unanimous-quarter-point-hike",
    52	  title: "Fed raises rates a quarter point on a unanimous vote",
    53	  dek: "The first increase since July 2023 was widely expected. The change was a 9–3 hold becoming a 12–0 hike, a tougher inflation message and 16 of 18 policymakers expecting another increase this year.",
    54	  name: "September 2026 rate increase",
    55	  date: decisionDate,
    56	  updated: "2026-09-19",
    57	  kpis: [
    58	    { value: `${range.lower}–${range.upper.toFixed(2)}`, unit: "%", label: "new target range" },
