    21	---
    22	<BaseLayout title={`${event.title} | The Catch`} current="Events">
    23	  <div slot="locator" class="locator"><a href="/events/">Series</a><a href="/events/jobs/">The job market</a><span>September jobs report &middot; October 2, 2026</span></div>
    24	  <div class="content">
    25	    <main class="story" id="story-root">
    26	      <p class="story-kicker" data-layer="narrative">The jobs report &middot; September 2026</p>
    27	      <h1 data-layer="fact">{event.title}</h1>
    28	      <p class="story-dek" data-layer="fact">{event.dek}<Cite s="bls-empsit-2026-09" passage="Both nonfarm payroll employment (+29,000) and the unemployment rate (4.2 percent) changed little in September" /></p>
