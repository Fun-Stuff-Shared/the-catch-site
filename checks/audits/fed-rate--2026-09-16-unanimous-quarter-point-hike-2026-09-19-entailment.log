checks/audits/kennedy-center--2026-09-17-30-day-notice-before-demolition-2026-09-19-r1-redteam.log:18796:dist/events/kennedy-center/2026-09-17-30-day-notice-before-demolition/index.html:3:</style><link rel="stylesheet" href="/_astro/story.CKJE-DQe.css"></head><body><a class="skip-link" href="#page-content">Skip to content</a><div class="sheet"><header class="band"><div class="band-inner"><a class="wordmark" href="/">The Catch<b>.</b></a><span class="desc">A permanent record of checked claims</span><button class="nav-toggle" aria-expanded="false" aria-controls="site-navigation">Menu <span aria-hidden="true">☰</span></button><nav id="site-navigation" aria-label="Main navigation"><a href="/">Latest</a><a href="/events/" aria-current="page">Series</a><a href="/officials/">People</a><a href="/methodology/">How we check</a></nav><button class="search-toggle" aria-label="Search" aria-expanded="false" aria-controls="global-search"><span>Search</span><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m16 16 5 5"></path></svg></button><form class="global-search" id="global-search" action="/" role="search"><label class="sr-only" for="story-query">Search stories</label><input id="story-query" name="q" type="search" placeholder="Search stories" autocomplete="off"><button type="submit" aria-label="Search stories"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m16 16 5 5"></path></svg></button></form><section id="search-results" class="search-results" aria-label="Matching stories" hidden><p role="status" aria-live="polite" data-search-message></p><ul data-search-matches></ul><a data-all-results href="/">View all results</a></section></div></header><div class="locator"><a href="/events/">Series</a><a href="/events/kennedy-center/">Kennedy Center</a><span>September 17, 2026</span></div><span id="page-content" tabindex="-1"></span><div class="content"><main class="story" id="story-root"><p class="story-kicker" data-layer="narrative">Kennedy Center &middot; September 17, 2026</p><h1 data-layer="fact">The judge required notice before a Kennedy Center demolition</h1><p class="story-dek" data-layer="fact">The September 17 order denied an emergency hearing but required written notice more than 30 days before the defendants implement a change to the project plans previously presented to the court, including demolition of the main building. It did not decide whether demolition would be lawful.</p><div class="mode-switcher" role="radiogroup" aria-label="Reading mode"><a class="mode-btn active" href="?mode=story" data-mode="story" role="radio" aria-checked="true">The story</a><a class="mode-btn" href="?mode=facts" data-mode="facts" role="radio" aria-checked="false">Just the facts</a><a class="mode-btn" href="?mode=work" data-mode="work" role="radio" aria-checked="false">Show the work</a></div><script type="module">document.addEventListener(`DOMContentLoaded`,()=>{let e=document.getElementById(`story-root`),t=document.querySelectorAll(`.mode-btn`);if(!e||!t.length)return;let n=new URLSearchParams(window.location.search),r=[`story`,`facts`,`work`].includes(n.get(`mode`))?n.get(`mode`):`story`;e.classList.add(`mode-${r}`);let i=e.querySelector(`[data-record-ledger]`);i&&(i.open=r===`work`),t.forEach(e=>{let t=e.getAttribute(`data-mode`)===r;e.classList.toggle(`active`,t),e.setAttribute(`aria-checked`,t?`true`:`false`),e.setAttribute(`tabindex`,t?`0`:`-1`)}),t.forEach((n,r)=>{n.addEventListener(`keydown`,e=>{let n=e.key===`ArrowRight`||e.key===`ArrowDown`?1:e.key===`ArrowLeft`||e.key===`ArrowUp`?-1:0;if(!n&&e.key!==`Home`&&e.key!==`End`&&e.key!==` `)return;e.preventDefault();let i=e.key===`Home`?t[0]:e.key===`End`?t[t.length-1]:t[(r+n+t.length)%t.length];i.click(),i.focus()}),n.addEventListener(`click`,r=>{r.preventDefault();let a=[...e.querySelectorAll(`section[id], aside[id]`)],o=a.find(e=>`#`+e.id===location.hash&&e.getBoundingClientRect().top>=0&&e.getBoundingClientRect().top<innerHeight)??a.filter(e=>e.getBoundingClientRect().height&&e.getBoundingClientRect().top<=160).at(-1),s=n.getAttribute(`data-mode`);i&&(i.open=s===`work`),e.className=e.className.replace(/mode-\w+/g,``).trim()+` mode-${s}`,t.forEach(e=>{let t=e===n;e.classList.toggle(`active`,t),e.setAttribute(`aria-checked`,t?`true`:`false`),e.setAttribute(`tabindex`,t?`0`:`-1`)});let c=new URL(window.location.href);if(c.searchParams.set(`mode`,s),o){let e=a.indexOf(o),t=o.getBoundingClientRect().height?o:[...a.slice(0,e).reverse(),...a.slice(e+1)].find(e=>e.getBoundingClientRect().height);t&&(requestAnimationFrame(()=>t.scrollIntoView({block:`start`})),c.hash=t.id)}history.replaceState(null,``,c.toString()),document.dispatchEvent(new Event(`reading-mode-change`))})})});</script><nav class="story-toc" aria-label="In this story" data-layer="fact"><details class="toc-disclosure" open><summary><span>In this story</span><span class="toc-current" aria-hidden="true"></span></summary><ol><li><a href="#what-happened">What happened</a></li><li><a href="#the-catch">The catch</a></li><li><a href="#where-this-sits">Where this sits</a></li><li><a href="#who-feels-it">Who feels it</a></li><li><a href="#outlets">What the coverage got right, and what it got wrong</a></li><li><a href="#claim-check">Claim checked against the record</a></li><li><a href="#what-happened-next">What happened next</a></li><li><a href="#unknowns">What we do not know yet</a></li><li><a href="#records">The records</a></li></ol></details></nav><div class="kpi-strip" data-layer="fact"><div class="kpi"><span class="kpi-value">&gt;30<small> days</small></span><span class="kpi-label">Notice before a covered change</span></div><div class="kpi"><span class="kpi-value">Sept. 23<small></small></span><span class="kpi-label">Court-ordered status report</span></div><div class="kpi"><span class="kpi-value">seven days<small></small></span><span class="kpi-label">Initial temporary closure</span></div></div><aside class="three-things" data-layer="fact"><p class="tt-label">Three things to know</p><ol><li>Judge Christopher Cooper denied Representative Joyce Beatty's request for an emergency hearing on September 17. In the same minute order, he required written notice more than 30 days before the defendants implement a change to the project plans previously presented to the court, including demolition of the main building.<sup class="src-ref"><a href="#src-21" data-record-href="/records/upi-kennedy-center-2026-09-17/" data-passage="more than 30 days before the implementation of any changes to the scope of the project plans presented to the Court" aria-label="Source 21: read the evidence">21</a></sup></li><li>The reproduced sentence does not say that every physical change is covered or state whether demolition would be lawful. It makes notice turn on changes to the scope of the project plans previously presented to the court.<sup class="src-ref"><a href="#src-21" data-record-href="/records/upi-kennedy-center-2026-09-17/" data-passage="changes to the scope of the project plans presented to the Court" aria-label="Source 21: read the evidence">21</a></sup></li><li>The executive director said the immediate closure was a seven-day safety measure unless extended. The defendants characterized it as separate from the board's renovation decision.<sup class="src-ref"><a href="#src-5" data-record-href="/records/floca-declaration-86-1-2026-09-17/" data-passage="which will last for seven days, unless extended" aria-label="Source 5: read the evidence">5</a></sup><sup class="src-ref"><a href="#src-4" data-record-href="/records/defendants-response-86-2026-09-17/" data-passage="separate from any Board decision related to closure for ongoing renovations" aria-label="Source 4: read the evidence">4</a></sup></li></ol></aside><p class="railed rail-note" data-layer="fact">The federal docket's September 17 minute order was not available as a court-hosted document in the public sources we could preserve. The operative sentence below is reproduced by UPI and by Beatty's counsel; the surrounding motions, declarations, earlier opinions and board records are preserved separately.<sup class="src-ref"><a href="#src-21" data-record-href="/records/upi-kennedy-center-2026-09-17/" data-passage="To avoid any confusion on that score given more recent events" aria-label="Source 21: read the evidence">21</a></sup><sup class="src-ref"><a href="#src-18" data-record-href="/records/beatty-counsel-reaction-2026-09-17/" data-passage="any changes to the scope of the project plans" aria-label="Source 18: read the evidence">18</a></sup></p><div data-layer="proof" class="event-record-context"><p class="sources-line">This story rests on filings in Beatty v. Trump and D.C. Preservation League v. Trump; the court's May 29 opinions; the board's August meeting record; the August 28 joint report; the September 16 scheduling order; federal statutes governing the Kennedy Center; the September 17 minute order as reproduced by two admitted carriers; and five coverage records checked against those documents.</p></div><section id="what-happened"><p class="sec-kicker" data-layer="narrative">The request and the ruling</p><h2 data-layer="fact">The judge refused the hearing and added an advance-notice rule</h2><p data-layer="narrative">Beatty asked for an emergency hearing after the main building closed and after the board voted to close it for renovation. The defendants answered that the immediate closure was separate from the renovation decision, while Floca described it as a temporary safety measure. Executive Director Matt Floca declared that structural deterioration created acute risks to public safety and that the initial closure would last seven days unless extended.<sup class="src-ref"><a href="#src-1" data-record-href="/records/beatty-motion-84-2026-09-16/" data-passage="MOTION FOR EMERGENCY HEARING" aria-label="Source 1: read the evidence">1</a></sup><sup class="src-ref"><a href="#src-4" data-record-href="/records/defendants-response-86-2026-09-17/" data-passage="separate from any Board decision related to closure for ongoing renovations" aria-label="Source 4: read the evidence">4</a></sup><sup class="src-ref"><a href="#src-5" data-record-href="/records/floca-declaration-86-1-2026-09-17/" data-passage="acute risks to public safety resulting from continued structural deterioration" aria-label="Source 5: read the evidence" data-passages="which will last for seven days, unless extended">5</a></sup></p><p data-layer="narrative">The filing also put two public signals before Cooper. Trump had told reporters that without recognition the building would close and end up being ripped down. The filing included a photograph of him reading a placard that appeared to say “Kennedy Center DEMOLISHED.” A Kennedy Center spokesperson separately said that nothing was being demolished.<sup class="src-ref"><a href="#src-3" data-record-href="/records/beatty-notice-85-2026-09-17/" data-passage="it will end up being ripped down" aria-label="Source 3: read the evidence" data-passages="appears to read “Kennedy Center DEMOLISHED.”">3</a></sup><sup class="src-ref"><a href="#src-26" data-record-href="/records/cbs-kennedy-center-2026-09-17/" data-passage="nothing is being demolished" aria-label="Source 26: read the evidence">26</a></sup></p><p data-layer="narrative">Cooper denied the hearing. He nevertheless ordered the defendants to give plaintiffs in both cases written notice before implementing a covered change.<sup class="src-ref"><a href="#src-21" data-record-href="/records/upi-kennedy-center-2026-09-17/" data-passage="Beatty's request for a hearing was denied" aria-label="Source 21: read the evidence" data-passages="provide such notice in writing to Plaintiffs in both cases">21</a></sup></p><figure class="quote-card" data-layer="fact"><figcaption class="qc-head"><span class="qc-speaker">U.S. District Judge Christopher Cooper</span><span class="qc-sep">&middot;</span><span class="qc-when">September 17, 2026</span><span class="qc-sep">&middot;</span><span class="qc-where">Minute order, as reproduced by UPI</span></figcaption><blockquote class="qc-words"><p>To avoid any confusion on that score given more recent events, the Court hereby ORDERS Defendants [the Kennedy Center board] to provide such notice in writing to Plaintiffs in both cases more than 30 days before the implementation of any changes to the scope of the project plans presented to the Court in D.C. Preservation League [a separate case], including but not limited to any 'demolition' of the Center's main building.<sup class="src-ref"><a href="#src-21" data-record-href="/records/upi-kennedy-center-2026-09-17/" data-passage="To avoid any confusion on that score given more recent events" aria-label="Source 21: read the evidence">21</a></sup></p></blockquote></figure><p data-layer="narrative">The order also required the administration to update Cooper by September 23 on the status of the temporary closure and emergency repairs. Beatty's counsel said Cooper also ordered discovery into the board's actions related to a potential demolition.<sup class="src-ref"><a href="#src-19" data-record-href="/records/abc-kennedy-center-2026-09-17/" data-passage="update him on the status of the" aria-label="Source 19: read the evidence" data-passages="emergency repairs">19</a></sup><sup class="src-ref"><a href="#src-18" data-record-href="/records/beatty-counsel-reaction-2026-09-17/" data-passage="ordered discovery into the Board’s actions related to a potential demolition" aria-label="Source 18: read the evidence">18</a></sup></p></section><section id="the-catch"><aside class="the-catch" data-layer="fact"><p class="tt-label">The catch</p><ol><li><h3>The period is more than 30 days.</h3>The operative sentence says notice must arrive more than 30 days before implementation. “30 days” is a useful shorthand, but it drops the word that sets the boundary.<sup class="src-ref"><a href="#src-21" data-record-href="/records/upi-kennedy-center-2026-09-17/" data-passage="more than 30 days before the implementation" aria-label="Source 21: read the evidence">21</a></sup></li><li><h3>The order follows the plans already put before the court.</h3>It does not say “any major physical changes” require notice. That phrase comes from the AP headline. The trigger in the reproduced order is a change to the scope of the project plans presented in the preservation case, with demolition named as an example.<sup class="src-ref"><a href="#src-20" data-record-href="/records/pbs-ap-kennedy-center-2026-09-17/" data-passage="any major physical changes" aria-label="Source 20: read the evidence">20</a></sup><sup class="src-ref"><a href="#src-21" data-record-href="/records/upi-kennedy-center-2026-09-17/" data-passage="changes to the scope of the project plans presented to the Court" aria-label="Source 21: read the evidence">21</a></sup></li><li><h3>Notice is not a final ruling on demolition.</h3>The reproduced sentence imposes an advance-notice requirement. It neither approves nor permanently bars demolition.<sup class="src-ref"><a href="#src-21" data-record-href="/records/upi-kennedy-center-2026-09-17/" data-passage="more than 30 days before the implementation" aria-label="Source 21: read the evidence">21</a></sup></li></ol></aside></section><section id="where-this-sits"><p class="sec-kicker" data-layer="narrative">The earlier record</p><h2 data-layer="fact">The court had relied on a no-demolition position</h2><p data-layer="narrative">In May, Cooper denied preliminary relief in the preservation case after considering sworn statements about the project. The opinion said the building's footprint and overall shape and size seemed unlikely to change permanently, and it described the anticipated open-space changes as relatively limited. The court said those findings were tentative and could change if the facts changed.<sup class="src-ref"><a href="#src-9" data-record-href="/records/preservation-opinion-45-2026-05-29/" data-passage="footprint and overall shape and size seem unlikely to change in a permanent manner" aria-label="Source 9: read the evidence" data-passages="these relatively limited alterations&#10;tentative">9</a></sup></p><p data-layer="narrative">The parties' August 28 joint report made the relevant promise explicit: the defendants would inform the plaintiffs and the court if the board's plans reversed the position that the building would not be demolished and no new structure would be built.<sup class="src-ref"><a href="#src-7" data-record-href="/records/preservation-joint-report-62-2026-08-28/" data-passage="Defendants have pledged to inform Plaintiffs and the Court" aria-label="Source 7: read the evidence" data-passages="building will not be demolished and that no new structure will be constructed">7</a></sup></p><figure class="story-figure" data-layer="fact"><figcaption><strong>How the notice order arose</strong><span>The dated sequence in the court and board records.</span></figcaption><div class="decision-timeline"><div class="dt-head"><span class="dt-date">Date</span><span class="dt-body">Decision</span></div><div class="dt-row"><span class="dt-date">May 29</span><span class="dt-body">The court denies preliminary relief in the preservation case. <span class="dt-sub">The ruling relies on sworn representations that the main building would not be demolished and no new structure would be built.</span></span></div><div class="dt-row"><span class="dt-date">Aug. 13</span><span class="dt-body">The board votes 23 to 3 to close the main building for renovation. <span class="dt-sub">Programming would continue at the REACH and off site.</span></span></div><div class="dt-row"><span class="dt-date">Aug. 28</span><span class="dt-body">The parties file a joint status report. <span class="dt-sub">The defendants again say the building will not be demolished and no new structure will be constructed.</span></span></div><div class="dt-row"><span class="dt-date">Sept. 15</span><span class="dt-body">The board votes again to close the main building. <span class="dt-sub">Its chairman says renovation is to wait while an appeal proceeds.</span></span></div><div class="dt-row"><span class="dt-date">Sept. 16</span><span class="dt-body">The main building closes temporarily. <span class="dt-sub">The executive director says the initial safety closure will last seven days unless extended.</span></span></div><div class="dt-row dt-current"><span class="dt-date">Sept. 17</span><span class="dt-body">The judge denies an emergency hearing and orders advance notice. <span class="dt-sub">Covered project-scope changes require written notice more than 30 days before implementation.</span></span></div><div class="dt-row"><span class="dt-date">Sept. 23</span><span class="dt-body">Status report due. <span class="dt-sub">The court requires a sworn declaration addressing the temporary closure and emergency repairs.</span></span></div></div></figure></section><section id="who-feels-it"><p class="sec-kicker" data-layer="narrative">What changes in practice</p><h2 data-layer="fact">The plaintiffs get warning; the parties dispute the immediate safety closure</h2><p data-layer="narrative">The reproduced order gives the plaintiffs in both cases a warning period before the defendants implement a covered project-scope change. It adds written notice to the earlier pledge to report a reversal of the no-demolition position.<sup class="src-ref"><a href="#src-21" data-record-href="/records/upi-kennedy-center-2026-09-17/" data-passage="provide such notice in writing to Plaintiffs in both cases" aria-label="Source 21: read the evidence">21</a></sup><sup class="src-ref"><a href="#src-7" data-record-href="/records/preservation-joint-report-62-2026-08-28/" data-passage="change in the Board’s plans that would constitute a reversal" aria-label="Source 7: read the evidence">7</a></sup></p><p data-layer="narrative">The defendants called the September 16 safety closure separate from the renovation decision. Beatty's reply disputed that account and argued that the temporary explanation was a pretext for an indefinite closure. Cooper denied the requested hearing.<sup class="src-ref"><a href="#src-4" data-record-href="/records/defendants-response-86-2026-09-17/" data-passage="separate from any Board decision related to closure for ongoing renovations" aria-label="Source 4: read the evidence">4</a></sup><sup class="src-ref"><a href="#src-6" data-record-href="/records/beatty-reply-87-2026-09-17/" data-passage="indefinitely" aria-label="Source 6: read the evidence">6</a></sup><sup class="src-ref"><a href="#src-21" data-record-href="/records/upi-kennedy-center-2026-09-17/" data-passage="Beatty's request for a hearing was denied" aria-label="Source 21: read the evidence">21</a></sup></p><p data-layer="narrative">Floca identified two immediate safety grounds: an engineering assessment of the roof-terrace canopy and the September 4 failure of a five-by-four-foot piece of ceiling plaster after water damage. The same declaration reported severe corrosion in 46 of 278 panels and said one-third of the panels required immediate replacement.<sup class="src-ref"><a href="#src-5" data-record-href="/records/floca-declaration-86-1-2026-09-17/" data-passage="a roof terrace canopy assessment" aria-label="Source 5: read the evidence" data-passages="failure of a five-by-four-foot piece of one-inch-thick ceiling plaster on September 4&#10;severe corrosion in 46 panels&#10;One-third of all panels require immediate replacement">5</a></sup></p><p data-layer="narrative">Bridget Kennedy-Bailey, whose declaration supported Beatty's motion, said she saw fencing block the building and saw a forklift hit exterior pillars several times. That observation was sworn testimony from one witness, not a finding by the court.<sup class="src-ref"><a href="#src-2" data-record-href="/records/kennedy-bailey-declaration-84-1-2026-09-16/" data-passage="Bridget Kennedy-Bailey" aria-label="Source 2: read the evidence" data-passages="forklift run into and hit the pillars">2</a></sup></p><p data-layer="narrative">The board's August minutes record a 23-to-3 vote directing closure of the main building for restoration and renovation and authorizing legal steps to dissolve the injunction that prevented that closure.<sup class="src-ref"><a href="#src-13" data-record-href="/records/board-minutes-68-3-2026-08-13/" data-passage="Motion carried by roll call, 23 in favor, 3 opposed" aria-label="Source 13: read the evidence" data-passages="seeking to dissolve the preliminary injunction">13</a></sup></p></section><section id="outlets"><p class="sec-kicker" data-layer="narrative">Cross-source check</p><h2 data-layer="fact">What the coverage got right, and what it got wrong</h2><div data-layer="fact"><article class="outlet-check warn"><h3>Associated Press via PBS NewsHour, September 17, 2026</h3><p class="oc-claim"><span>reported that the order required 30 days' notice before any major physical change, including demolition.</span></p><p class="oc-verdict"><strong>Too broad</strong><span>.</span></p><p class="oc-record"><span>The reproduced order says more than 30 days and ties the requirement to changes in the scope of the project plans previously presented to the court.</span></p><p class="oc-sources"><sup class="src-ref"><a href="#src-20" data-record-href="/records/pbs-ap-kennedy-center-2026-09-17/" data-passage="provide 30 days' notice before making any major physical changes" aria-label="Source 20: read the evidence">20</a></sup></p></article><article class="outlet-check ok"><h3>UPI, September 17, 2026</h3><p class="oc-claim"><span>reproduced the operative sentence tying advance notice to project-scope changes, including demolition.</span></p><p class="oc-verdict"><strong>Checks out</strong><span> against the same language reproduced by the parties' counsel and the surrounding filings.</span></p><p class="oc-sources"><sup class="src-ref"><a href="#src-21" data-record-href="/records/upi-kennedy-center-2026-09-17/" data-passage="more than 30 days before the implementation of any changes to the scope of the project plans presented to the Court" aria-label="Source 21: read the evidence">21</a></sup></p></article><article class="outlet-check ok"><h3>USA Today, September 17, 2026</h3><p class="oc-claim"><span>reported that the order blocked immediate demolition rather than deciding whether demolition could ever occur.</span></p><p class="oc-verdict"><strong>Checks out</strong><span>.</span></p><p class="oc-record"><span>The mechanism is advance notice; the order did not decide the legality of a future demolition plan.</span></p><p class="oc-sources"><sup class="src-ref"><a href="#src-23" data-record-href="/records/usa-today-kennedy-center-order-2026-09-17/" data-passage="blocked President Donald Trump from taking immediate action to demolish the Kennedy Center" aria-label="Source 23: read the evidence">23</a></sup></p></article></div></section><section id="claim-check"><p class="sec-kicker" data-layer="narrative">The headline claim</p><h2 data-layer="fact">Claim checked against the record</h2><div data-layer="fact"><div class="contested-block"><p class="cb-label">The judge said Trump must give 30 days&#39; notice before demolishing the Kennedy Center</p><p>Directionally right, but incomplete. The order binds the defendants and requires written notice to the plaintiffs in both cases more than 30 days before implementing a change to the scope of the project plans previously presented to the court, including demolition. It does not identify a demolition plan, decide whether one would be lawful or impose a general notice rule for every physical change.<sup class="src-ref"><a href="#src-21" data-record-href="/records/upi-kennedy-center-2026-09-17/" data-passage="more than 30 days before the implementation of any changes to the scope of the project plans presented to the Court" aria-label="Source 21: read the evidence">21</a></sup></p></div></div></section><section id="what-happened-next"><p class="sec-kicker" data-layer="narrative">The next dated steps</p><h2 data-layer="fact">The closure and renovation claims moved onto separate tracks</h2><p data-layer="narrative">The existing scheduling order had already opened expedited discovery on Beatty's closure claim. It set September 23 deadlines for written discovery requests and deposition notices, September 30 for written responses, October 7 for completed depositions and October 9 for the close of discovery.<sup class="src-ref"><a href="#src-15" data-record-href="/records/scheduling-order-82-2026-09-16/" data-passage="Requests for Written and Document Discovery" aria-label="Source 15: read the evidence" data-passages="All Discovery Closed">15</a></sup></p><p data-layer="narrative">The September 17 order added the update and advance-notice requirements. The September 16 scheduling order separately set deadlines for a motion to vacate the preliminary injunction and for discovery on the closure claim.<sup class="src-ref"><a href="#src-18" data-record-href="/records/beatty-counsel-reaction-2026-09-17/" data-passage="required the Board to update the Court by September 23" aria-label="Source 18: read the evidence">18</a></sup><sup class="src-ref"><a href="#src-21" data-record-href="/records/upi-kennedy-center-2026-09-17/" data-passage="more than 30 days before the implementation" aria-label="Source 21: read the evidence">21</a></sup><sup class="src-ref"><a href="#src-15" data-record-href="/records/scheduling-order-82-2026-09-16/" data-passage="Motion to Vacate the Preliminary" aria-label="Source 15: read the evidence">15</a></sup></p><p data-layer="narrative">On September 18, the defendants filed a motion to dissolve the May preliminary injunction and a renewed motion for partial summary judgment on Beatty's remaining closure and construction claims. Those motions asked the court for relief; they did not themselves dissolve the injunction or decide the claims.<sup class="src-ref"><a href="#src-24" data-record-href="/records/defendants-motion-vacate-88-2026-09-18/" data-passage="DEFENDANTS’ MOTION TO DISSOLVE PRELIMINARY INJUNCTION" aria-label="Source 24: read the evidence">24</a></sup><sup class="src-ref"><a href="#src-25" data-record-href="/records/defendants-summary-judgment-89-2026-09-18/" data-passage="DEFENDANTS’ RENEWED MOTION FOR" aria-label="Source 25: read the evidence">25</a></sup></p></section><section id="unknowns"><p class="sec-kicker" data-layer="narrative">Open questions</p><h2 data-layer="fact">What we do not know yet</h2><ul data-layer="fact"><li data-absence>Whether the September 23 status report was filed, and whether the initial safety closure was extended. Searched: the admitted docket material and coverage through September 19; the report was not yet due.</li><li data-absence>Whether the defendants have developed a project-scope change that would trigger the notice order. Searched: the admitted board records, plans, filings and coverage; none contains an identified demolition plan.</li><li data-absence>The court's minute order as a standalone, court-hosted document. Searched: the District Court docket, CourtListener and Justia; the docket routes were unavailable to the capture registry and the Justia mirror stopped before September 17. The page therefore labels the carriers of the quoted sentence.</li></ul></section><section id="records" data-layer="fact"><p class="sec-kicker">Sources</p><h2>The records</h2><p class="section-lede">Everything this page rests on, numbered where the story cites it. We keep a dated copy of each one.</p><h3 class="src-group">Primary documents</h3><ol class="src-list" start="1"><li id="src-1" value="1"><a href="/records/beatty-motion-84-2026-09-16/">Plaintiff motion for an emergency hearing</a> · U.S. District Court for the District of Columbia, 2026-09-16 <span class="src-usage" data-layer="proof"> &middot; Beatty’s request for an emergency hearing over the closure</span></li><li id="src-2" value="2"><a href="/records/kennedy-bailey-declaration-84-1-2026-09-16/">Declaration of Bridget Kennedy-Bailey</a> · U.S. District Court for the District of Columbia, 2026-09-16 <span class="src-usage" data-layer="proof"> &middot; firsthand observations submitted with the emergency motion</span></li><li id="src-3" value="3"><a href="/records/beatty-notice-85-2026-09-17/">Notice of supplemental authority</a> · U.S. District Court for the District of Columbia, 2026-09-17 <span class="src-usage" data-layer="proof"> &middot; the demolition placard and statements put before the court</span></li><li id="src-4" value="4"><a href="/records/defendants-response-86-2026-09-17/">Defendants’ response to the emergency-hearing motion</a> · U.S. District Court for the District of Columbia, 2026-09-17 <span class="src-usage" data-layer="proof"> &middot; the defendants’ account of the temporary closure</span></li><li id="src-5" value="5"><a href="/records/floca-declaration-86-1-2026-09-17/">Declaration of Charles Matthew Floca</a> · U.S. District Court for the District of Columbia, 2026-09-17 <span class="src-usage" data-layer="proof"> &middot; the sworn safety basis and initial duration of the closure</span></li><li id="src-6" value="6"><a href="/records/beatty-reply-87-2026-09-17/">Plaintiff’s reply in support of an emergency hearing</a> · U.S. District Court for the District of Columbia, 2026-09-17 <span class="src-usage" data-layer="proof"> &middot; Beatty’s response to the temporary-closure account</span></li><li id="src-7" value="7"><a href="/records/preservation-joint-report-62-2026-08-28/">Joint meet-and-confer report</a> · U.S. District Court for the District of Columbia, 2026-08-28 <span class="src-usage" data-layer="proof"> &middot; the defendants’ no-demolition and no-new-structure position</span></li><li id="src-8" value="8"><a href="/records/preservation-addendum-62-1-2026-08-28/">Preservation plaintiffs’ addendum</a> · U.S. District Court for the District of Columbia, 2026-08-28 <span class="src-usage" data-layer="proof"> &middot; the preservation plaintiffs’ contemporaneous response</span></li><li id="src-9" value="9"><a href="/records/preservation-opinion-45-2026-05-29/">Memorandum opinion in D.C. Preservation League v. Trump</a> · U.S. District Court for the District of Columbia, 2026-05-29 <span class="src-usage" data-layer="proof"> &middot; the ruling that relied on the represented project scope</span></li><li id="src-10" value="10"><a href="/records/beatty-opinion-50-2026-05-29/">Memorandum opinion in Beatty v. Trump</a> · U.S. District Court for the District of Columbia, 2026-05-29 <span class="src-usage" data-layer="proof"> &middot; the legal baseline for closure and repairs</span></li><li id="src-11" value="11"><a href="/records/beatty-opinion-77-2026-09-15/">Memorandum opinion on the proposed recognition additions</a> · U.S. District Court for the District of Columbia, 2026-09-15 <span class="src-usage" data-layer="proof"> &middot; the September 15 ruling preceding the closure dispute</span></li><li id="src-12" value="12"><a href="/records/board-resolution-66-2-2026-08-13/">Kennedy Center board resolution on recognition additions</a> · Kennedy Center Board of Trustees, 2026-08-13 <span class="src-usage" data-layer="proof"> &middot; the board’s separate recognition proposal</span></li><li id="src-13" value="13"><a href="/records/board-minutes-68-3-2026-08-13/">Kennedy Center board meeting minutes</a> · Kennedy Center Board of Trustees, 2026-08-13 <span class="src-usage" data-layer="proof"> &middot; the main-building closure resolution and vote</span></li><li id="src-14" value="14"><a href="/records/board-vote-notice-78-2026-09-15/">Notice of the September 15 board vote</a> · U.S. District Court for the District of Columbia, 2026-09-15 <span class="src-usage" data-layer="proof"> &middot; the second board action before the emergency motion</span></li><li id="src-15" value="15"><a href="/records/scheduling-order-82-2026-09-16/">Scheduling order for expedited closure discovery</a> · U.S. District Court for the District of Columbia, 2026-09-16 <span class="src-usage" data-layer="proof"> &middot; the deadlines for the closure claim</span></li><li id="src-18" value="18"><a href="/records/beatty-counsel-reaction-2026-09-17/">Beatty counsel reaction to the notice order</a> · Washington Litigation Group, 2026-09-17 <span class="src-usage" data-layer="proof"> &middot; a party carrier for the minute order and the September 23 deadline</span></li><li id="src-24" value="24"><a href="/records/defendants-motion-vacate-88-2026-09-18/">Defendants’ motion to dissolve the preliminary injunction</a> · U.S. District Court for the District of Columbia, 2026-09-18 <span class="src-usage" data-layer="proof"> &middot; the request to dissolve the May injunction</span></li><li id="src-25" value="25"><a href="/records/defendants-summary-judgment-89-2026-09-18/">Defendants’ renewed motion for partial summary judgment</a> · U.S. District Court for the District of Columbia, 2026-09-18 <span class="src-usage" data-layer="proof"> &middot; the renewed request for judgment on closure and construction claims</span></li></ol><h3 class="src-group">Official data</h3><ol class="src-list" start="16"><li id="src-16" value="16"><a href="/records/usc-20-76j-2026-09-19/">20 U.S.C. 76j, duties of the Board</a> · Office of the Law Revision Counsel, 2026-09-19 <span class="src-usage" data-layer="proof"> &middot; the Kennedy Center board’s statutory duties</span></li><li id="src-17" value="17"><a href="/records/usc-20-76l-2026-09-19/">20 U.S.C. 76l, board organization and powers</a> · Office of the Law Revision Counsel, 2026-09-19 <span class="src-usage" data-layer="proof"> &middot; the board’s statutory organization and powers</span></li></ol><h3 class="src-group">Coverage checked</h3><ol class="src-list" start="19"><li id="src-19" value="19"><a href="/records/abc-kennedy-center-2026-09-17/">ABC News on the notice order</a> · ABC News, 2026-09-17 <span class="src-usage" data-layer="proof"> &middot; the candidate headline and immediate closure account</span></li><li id="src-20" value="20"><a href="/records/pbs-ap-kennedy-center-2026-09-17/">Associated Press report carried by PBS NewsHour</a> · Associated Press via PBS NewsHour, 2026-09-17 <span class="src-usage" data-layer="proof"> &middot; the broad major-physical-changes formulation checked against the order</span></li><li id="src-21" value="21"><a href="/records/upi-kennedy-center-2026-09-17/">UPI on the notice order</a> · UPI, 2026-09-17 <span class="src-usage" data-layer="proof"> &middot; the reproduced operative sentence of the minute order</span></li><li id="src-22" value="22"><a href="/records/usa-today-kennedy-center-comments-2026-09-16/">USA Today on demolition remarks</a> · USA Today, 2026-09-16 <span class="src-usage" data-layer="proof"> &middot; the September 16 statements put before the court</span></li><li id="src-23" value="23"><a href="/records/usa-today-kennedy-center-order-2026-09-17/">USA Today on the notice order</a> · USA Today, 2026-09-17 <span class="src-usage" data-layer="proof"> &middot; the immediate-demolition characterization checked against the order</span></li><li id="src-26" value="26"><a href="/records/cbs-kennedy-center-2026-09-17/">CBS News on the demolition dispute</a> · CBS News, 2026-09-17 <span class="src-usage" data-layer="proof"> &middot; the Kennedy Center spokesperson’s no-demolition statement</span></li></ol><p class="sources-line"><a href="/methodology">How we check</a> <span data-layer="proof"> &middot; where this page says <em>computed</em>, the arithmetic was done from the saved data series; where it says <em>record</em> or <em>checked</em>, the words trace to a saved document</span>.</p></section><details class="record-ledger" data-record-ledger data-layer="fact" data-state-derived><summary>Figures in the source documents <span class="series-count">2</span></summary><article class="ledger-row" data-state-slot="slot-106afc94-7212-41ea-8fad-b160b224df14"><h3>Number in the more-than-30-days notice requirement</h3><strong class="ledger-value" data-state-figure="story-figure:ac13c39c1564750fcd0e38770fb3616169a32b95e0a8e37499ddbb7dcca276d1" data-state-figure-role="current" data-figure-value="30" data-figure-unit="days">30 days</strong><a class="ledger-source" href="/records/upi-kennedy-center-2026-09-17/" data-passage="more than 30 days before the implementation" aria-label="Read the source for Number in the more-than-30-days notice requirement">UPI <span aria-hidden="true">↗</span></a><details class="ledger-source-passage"><summary>Recorded passage</summary><blockquote data-source-copy>more than 30 days before the implementation</blockquote></details></article><article class="ledger-row" data-state-slot="slot-b105d119-6be2-42e2-b25c-8b9bc654574d"><h3>Votes in favor of the August closure resolution</h3><strong class="ledger-value" data-state-figure="story-figure:6d43ab5c88e2f31c776ae08be3143e7deb8c01414b0e7dd8808975f91760b897" data-state-figure-role="current" data-figure-value="23" data-figure-unit="votes in favor">23 votes in favor</strong><a class="ledger-source" href="/records/board-minutes-68-3-2026-08-13/" data-passage="23 in favor, 3 opposed" aria-label="Read the source for Votes in favor of the August closure resolution">Kennedy Center Board of Trustees <span aria-hidden="true">↗</span></a><details class="ledger-source-passage"><summary>Recorded passage</summary><blockquote data-source-copy>23 in favor, 3 opposed</blockquote></details></article></details><section class="revision-timeline" data-layer="fact" data-revision-confirmations="0" data-revision-changes="0"></section><section data-layer="proof"><h2>Sources</h2><ul><li><a href="/records/board-minutes-68-3-2026-08-13/" da