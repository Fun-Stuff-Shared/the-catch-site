data/sources/coverage/cnbc-house-funding.html:45:        </script></div></div></div><div class="PageBuilder-containerWidth100 PageBuilder-pageRow"><div class="PageBuilder-col-full PageBuilder-col PageBuilder-article"><div id="RegularArticle-ArticleHeader-2" data-test="articleHeader-0" data-analytics="RegularArticle-articleHeader-2-0"><header class="ArticleHeader-articleHeader" id="main-article-header"><div class="ArticleHeader-headerContentContainer" data-header-content-container="true"><div class="ArticleHeader-wrapperHeroNoImage ArticleHeader-wrapperHero ArticleHeader-wrapper ArticleHeader-wrapperNoImage"><a href="https://www.cnbc.com/politics/" class="ArticleHeader-eyebrow">Politics &amp; Policy</a><div><h1 class="ArticleHeader-headline">U.S. House votes to avoid government shutdown amid GOP hard-liner resistance</h1></div><div class="ArticleHeader-timeHidden"><time data-testid="published-timestamp" dateTime="2026-09-01T13:51:58+0000" itemProp="datePublished">Published Tue, Sep 1 2026<span class="ArticleHeader-datetimeDivider"></span>9:51 AM EDT</time><span class="ArticleHeader-timestampDivider"></span><time data-testid="lastpublished-timestamp" dateTime="2026-09-01T20:34:47+0000">Updated Tue, Sep 1 2026<span class="ArticleHeader-datetimeDivider"></span>4:34 PM EDT</time></div></div><div class="ArticleHeader-authorAndShareInline"><div class="ArticleHeader-authorContainer ArticleHeader-authorContainerWithWatchLive"><div class="ArticleHeader-author"><div class="Author-author"><div class="Author-authorInfo"><img class="Author-authorPortrait" style="border:0" src="https://image.cnbcfm.com/api/v1/image/108238597-1765371215221-108215909-1761225432895-108215909-1761222972139-IMG_9267.jpg?v=1765371229&amp;w=60&amp;h=60&amp;ffmt=webp" alt="thumbnail"/><div class="Author-authorNameAndSocial"><a href="https://www.cnbc.com/justin-papp/" class="Author-authorName">Justin Papp<span class="Author-authorUnderline"></span></a><a href="https://linkedin.com/in/justin-papp" class="Author-authorTwitter" target="_blank">@in/justin-papp</a><a href="https://twitter.com/@justinjpapp1" class="Author-authorTwitter" target="_blank">@justinjpapp1</a></div></div></div></div></div><span><a href="/live-tv/" class="WatchLive-container">WATCH LIVE</a></span></div></div></header></div></div></div><div class="PageBuilder-containerFluidWidths PageBuilder-pageRow"><div class="PageBuilder-col-9 PageBuilder-col PageBuilder-article"><div class="RenderKeyPoints-keyPoints" id="RegularArticle-KeyPoints-4" data-test="keyPoints-1" data-analytics="RegularArticle-keyPoints-4-1"><div class="RenderKeyPoints-wrapper"><div class="RenderKeyPoints-header">Key Points</div><div class="RenderKeyPoints-list"><div><div class="group"><ul><li>The U.S. House approved a measure to extend federal government funding to Dec. 11.</li><li>The measure averts a government shutdown this fall ahead of November&#x27;s midterm election, which will decide control of the House, with lawmakers eager to return to their districts to campaign.</li><li>It next heads to the White House for President Donald Trump&#x27;s signature.</li></ul></div></div></div></div></div><div class="ArticleBody-articleBody" id="RegularArticle-ArticleBody-5" data-module="ArticleBody" data-test="articleBody-2" data-analytics="RegularArticle-articleBody-5-2"><span class="HighlightShare-hidden" style="top:0;left:0"></span><div class="InlineImage-imageEmbed" id="ArticleBody-InlineImage-108148762" data-test="InlineImage"><div class="InlineImage-wrapper"><div class="InlineImage-imagePlaceholder" style="padding-bottom:55.55555555555556%"><div style="height:100%" class="lazyload-placeholder"></div></div><div><div class="InlineImage-imageEmbedCaption">UNITED STATES - MAY 21: Rep. Chip Roy, R-Texas, left, and House Freedom Caucus chair Rep. Andy Harris, R-Md., along with members of the House Freedom Caucus speak to reporters about the One Big Beautiful Bill Act reconciliation package in the U.S. Capitol on Wednesday, May 21, 2025. </div><div class="InlineImage-imageEmbedCredit">Bill Clark | Cq-roll Call, Inc. | Getty Images</div></div></div></div><div class="group"><p>The <a href="https://www.cnbc.com/congress/">U.S. House</a> on Tuesday voted, 370-48, in favor of a stopgap spending measure that is expected to avert a government shutdown this fall ahead of the <a href="https://www.cnbc.com/elections/">2026 midterm election</a>, despite objections from <a href="https://www.cnbc.com/republicans/">GOP</a> hard-liners.</p><p>The legislation, which the <a href="https://www.axios.com/2026/08/08/senate-government-funding-shutdown-stopgap" target="_blank">Senate passed in August</a> before breaking for its summer recess, would keep the government funded through Dec. 11. </p><div style="height:100%" class="lazyload-placeholder"></div><p>The measure now heads to President <a href="https://www.cnbc.com/donald-trump/">Donald Trump&#x27;s</a> desk for his signature. </p><p>Without passage, government funding is set to lapse at the end of the federal fiscal year, Sept. 30. That&#x27;s a prospect neither party was keen on as lawmakers hope to quickly return to their districts and continue campaigning ahead of the midterms. </p><p>House leadership brought the bill to the floor using a process known as &quot;<a href="https://www.congress.gov/crs-product/98-314" target="_blank">suspension of the rules</a>,&quot; which allows consensus measures to circumvent certain procedural hurdles but requires a two-thirds vote. That meant Democratic votes were needed in the narrowly divided chamber. The package ultimately got broad, bipartisan support. Just 19 Republicans and 29 Democrats <a href="https://clerk.house.gov/Votes/2026286?Page=2" target="_blank">voted against</a> the measure.</p><p>&quot;Thanks to the House Republicans&#x27; leadership and the foresight back in July, we began the necessary processes to ensure that the government would not be shut down,&quot; House Speaker <a href="https://www.cnbc.com/mike-johnson/">Mike Johnson</a>, R-La., said after the vote. &quot;We are not going to have our troops in harm&#x27;s way without getting paychecks.&quot;</p><p>But before the vote, members of the hard-right <a href="https://www.cnbc.com/2017/04/06/house-freedom-caucus-signals-support-for-health-care-bill-with-changes.html">House Freedom Caucus</a> raised concerns about both the bill and the process. The lawmakers threatened to hold up what Johnson expected would be a quick vote to pass the measure, which extends current government funding levels.</p><div style="height:100%" class="lazyload-placeholder"></div></div><div class="group"><div class="RelatedContent-relatedContent" id="RegularArticle-RelatedContent-1"><div class="RelatedContent-container"><div class="RelatedContent-nonCollapsibleContent"><h2 class="RelatedContent-header">Read more CNBC politics and policy coverage</h2><div class="group"><ul><li><a href="https://www.cnbc.com/2026/09/03/freedom-fuel-trump-lawsuit-detroit.html">Trump-touted Freedom Fuel expands to Detroit amid suit over supplier&#x27;s unpaid fuel</a></li><li><a href="https://www.cnbc.com/2026/09/03/vance-fed-interest-rates-trump-bond-yields.html">Vance says Fed should lower interest rates: &#x27;Would be nice to have some help&#x27;</a></li><li><a href="https://www.cnbc.com/2026/09/03/carney-lutnick-trump-trade-canada.html">Canada PM Carney swipes at Trump Commerce Sec. Lutnick over trade, tariff row</a></li></ul></div></div></div></div></div><div class="group"><p>Rep. <a href="https://www.cnbc.com/video/2025/08/28/rep-chip-roy-on-congressional-stock-trading-ban-u-s-governments-stake-in-intel.html">Chip Roy</a>, R-Texas, sent a letter on Monday to House Appropriations Committee Chair <a href="https://www.cnbc.com/tom-cole/">Tom Cole</a>, R-Okla., and House Budget Committee Chair <a href="https://www.cnbc.com/video/2026/07/30/this-is-emergency-funding-says-house-budget-chair-on-reconciliation-3-point-0.html">Jodey Arrington</a>, R-Texas, outlining his concerns with the stopgap spending measure, among them its funding for Planned Parenthood and the absence of a ban on hemp products that contain THC, the psychoactive chemical in marijuana.</p><p>&quot;I have serious concerns about simply extending the status quo. Members should be clear about what passage of this legislation would mean: Congress would once again affirmatively fund policies we have spent months fighting to change,&quot; Roy wrote.</p><p>And Rep. Andy Harris, R-Md., who chairs the Freedom Caucus, <a href="https://x.com/JakeSherman/status/2094533287830245683?s=20" target="_blank">told Punchbowl News</a> he would vote to block the rest of the GOP&#x27;s agenda for the week over his objection to the spending measure.</p><p>But their opposition was not enough to hinder the vote. With Democratic support, Johnson passed the funding measure even with some GOP defections.</p><p>Most lawmakers will be eager to get back to their districts this election season, as Republicans strive to overcome Trump&#x27;s low approval rating and hold on to narrow majorities in the House and Senate. Polling shows <a href="https://www.cnbc.com/democrats/">Democrats</a> are largely expected to win control of the House, while the GOP is favored in the Senate.</p><p>Senate Appropriations Committee Chair <a href="https://www.cnbc.com/patty-murray/">Patty Murray</a>, D-Wash., applauded the spending bills&#x27; passage in a statement on Tuesday, but said more work is needed to be done to curb the Trump administration.</p><p>&quot;We have a lot of work ahead in the coming months to negotiate spending bills that invest in families instead of President Trump&#x27;s war budget, and I will be pushing at every step of the way to invest in making life more affordable and rein in the corrupt abuses of this administration,&quot; Murray said.</p></div><div id="ArticleBody-MobileAdhesion" class="MobileAdhesion-container" data-module="mps-slot"></div><div class="ArticleBody-googlePreferredSourceContainer" data-module="GooglePreferredSource" data-id="RegularArticle-GooglePreferredSource-5"><div class="ArticleBody-googlePreferredSourceBorder"></div><a href="https://www.google.com/preferences/source?q=https://www.cnbc.com/" target="_blank" rel="noopener noreferrer">Choose CNBC as your preferred source on Google and never miss a moment from the most trusted name in business news.</a></div></div></div><div class="SidebarArticle-sidebar PageBuilder-sidebar" data-test="SidebarArticle"><div class="SidebarArticle-sticky" style="top:70px"><div></div><div></div><div style="margin-top:0px"></div><div><div style="height:100%" class="lazyload-placeholder"></div></div></div></div></div><div class="PageBuilder-containerFluidWidths PageBuilder-pageRow"><div class="PageBuilder-col-9 PageBuilder-col PageBuilder-article"></div></div><div class="PageBuilder-containerFluidWidths PageBuilder-pageRow"><div class="PageBuilder-col-12 PageBuilder-col PageBuilder-article"><div style="height:100%" class="lazyload-placeholder"></div></div></div></div></div></div></div><div id="MobileAdhesion-Homepage" class="MobileAdhesion-container" data-module="mps-slot"></div><footer id="GlobalFooter" class="CNBCFooter-footer" data-mini-video-player-dont-scroll-beyond-here="true" data-test="GlobalFooter" data-analytics="RegularArticle-GlobalFooter"><div class="CNBCFooter-wrapper"><div><a href="//www.cnbc.com" class="CNBCFooter-logo" target="_self"><img src="https://static-redesign.cnbcfm.com/dist/d6085c9e81f4d7365c8d.svg" class="CNBCFooter-logoImg CNBCFooter-versantLogo" alt="CNBC logo"/></a></div><ul class="CNBCFooter-social"><li class="CNBCFooter-socialItem"><a href="https://www.facebook.com/cnbc/" class="icon-social_facebook" target="_blank" aria-label="facebook"></a></li><li class="CNBCFooter-socialItem"><a href="https://www.twitter.com/cnbc/" class="icon-social_twitter" target="_blank" aria-label="twitter"></a></li><li class="CNBCFooter-socialItem"><a href="https://www.linkedin.com/company/cnbc/