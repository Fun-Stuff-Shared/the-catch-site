// Table 1 medians in the September Summary of Economic Projections.
export const projectionRows = [
  ["Real GDP growth", 2.3, 2.4, 2.2, 2.1, 2.0],
  ["Unemployment rate", 4.1, 4.1, 4.1, 4.1, 4.2],
