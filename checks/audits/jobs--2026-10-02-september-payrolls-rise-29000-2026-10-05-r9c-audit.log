:\u002F\u002Fplayer.cnbc.com\u002Fp\u002FgZWlPC\u002Fcnbc_global?playertype=synd&byGuid={VID}","hlshtml":true,"primary":"html5","share":true,"parsely":true,"playbackRateControls":false,"fwassetId":"cnbc_7000426215","mediaid":"cnbc_7000426215","key":"Y52d\u002FqsiqzaY8+ucPsAp7C+xgNdtLGZNVX77f7nClqcvQj2K","playList":false,"sharing":{"sites":["facebook","twitter","linkedin"],"link":"https:\u002F\u002Fwww.cnbc.com\u002Fvideo\u002F2026\u002F10\u002F01\u002Fits-a-low-hire-low-fire-job-market-says-revelio-labsa-evan-sohn.html","code":"\u003Ciframe width=560 height=349 src=https:\u002F\u002Fplayer.cnbc.com\u002Fp\u002FgZWlPC\u002Fcnbc_global?playertype=synd&byGuid=7000426215 frameborder=0 scrolling=no allowfullscreen webkitallowfullscreen mozallowfullscreen oallowfullscreen msallowfullscreen \u003E\u003C\u002Fiframe\u003E"},"mobileSFID":"23744321","IE11Profile":"535279:cnbc_web_vod_csai","advertising":{"client":"freewheel","creativeTimeout":4000,"requestTimeout":4000,"vpaidcontrols":true,"freewheel":{"sectionid":"cnbc_alldevice_allos_web_ondemand","networkid":535279,"profileid":"535279:cnbc_web_vod_csai","adManagerURL":"https:\u002F\u002Fmssl.fwmrm.net\u002Flibs\u002Fadm\u002F7.0.1\u002FAdManager.js","serverid":"https:\u002F\u002F82aef.v.fwmrm.net\u002Fad\u002Fg\u002F1","sfid":"23744321","afid":"440162248","custom":{"metr":"1031","sfid":"23744321","afid":"440162248"}},"schedule":{"adbreak":{"offset":"pre","tag":"placeholder_preroll"}}},"analytics":{"onSite":true,"omniture":{"playername":"JW_Player","playerversion":"Universal","daypart":"Others","assetstatus":"Unrestricted","videoprogram":{"live":"iconic"},"videocontent":"Linear","title":"{partnername} Vod","guid":"{partnername} Vod","share":{"linksharepev2":"Video Control Rack","providerepev2":"Share","eVar15":"Video:Vod:","linktrknav":"video:share:Vod:","eVar14":": Share Published"}}},"embed":"\u003Ciframe width=560 height=349 src=https:\u002F\u002Fplayer.cnbc.com\u002Fp\u002FgZWlPC\u002Fcnbc_global?playertype=synd&byGuid=7000426215 frameborder=0 scrolling=no allowfullscreen webkitallowfullscreen mozallowfullscreen oallowfullscreen msallowfullscreen \u003E\u003C\u002Fiframe\u003E"},"playerTech":"JW Player","subType":"clips","thumbnail":"https:\u002F\u002Fimage.cnbcfm.com\u002Fapi\u002Fv1\u002Fimage\u002F108371189-17908749111790874907-48726921699-1080pnbcnews.jpg?v=1790874910","usageRule":"NA","vcpsId":7000426215,"videoStatus":"Unrestricted","uploadDate":"2026-10-01T17:15:10+0000","__typename":"cnbcvideo"},"children":[],"__typename":"bodyContent"},{"tagName":"div","attributes":{"className":["group"]},"data":{"__typename":"asset"},"children":[{"tagName":"p","children":["\"In the labor market, a broad range of data indicates that conditions have stabilized,\" Fed Vice Chairman Philip Jefferson said in a speech Thursday. \"While job creation has been somewhat volatile, payroll gains have broadened to many sectors in recent months, which is encouraging. Layoffs have remained low, and job openings have moved a bit higher on net.\""]},{"tagName":"p","children":["Even with a solid jobs picture, Fed commentary this week has shifted market expectations for a rate hike near the end of October. "]},{"tagName":"p","children":["New York Fed President John Williams remarked earlier in the week that \"there is no need for urgency\" when policymakers weigh whether to follow up on September's ",{"tagName":"a","attributes":{"id":"108363682","href":"https:\u002F\u002Fwww.cnbc.com\u002F2026\u002F09\u002F16\u002Ffed-rate-decision-september-2026.html","type":"cnbcnewsstory","brand":"cnbc","section":{"subType":"section"},"premium":false,"contentClassification":[]},"children":["quarter percentage point rate hike"]}," with another increase. "]},{"tagName":"p","children":["\"On the employment side of [the Fed's twin goals of full employment and stable prices], the data show that the labor market continues to be solid — and has even strengthened a bit on the margin,\" Williams said."]},{"tagName":"p","children":["Markets subsequently sharply reduced the odds for a hike at the Oct. 27-28 meeting and see a move much more likely in December."]}],"__typename":"bodyContent"},{"tagName":"subtitle","attributes":{},"data":{"__typename":"asset"},"children":["Slow but steady"],"__typename":"bodyContent"},{"tagName":"div","attributes":{"className":["group"]},"data":{"__typename":"asset"},"children":[{"tagName":"p","children":["Central to the argument that the Fed needs to ",{"tagName":"a","attributes":{"id":"108367581","href":"https:\u002F\u002Fwww.cnbc.com\u002F2026\u002F09\u002F24\u002Fsurging-treasury-yields-are-posing-a-brand-new-problem-for-kevin-warsh-and-the-fed.html","type":"cnbcnewsstory","brand":"cnbc","section":{"subType":"section"},"premium":false,"contentClassification":[]},"children":["focus on inflation"]}," but doesn't need to be in a hurry for another hike is the stable if unspectacular labor picture."]},{"tagName":"p","children":["Payroll growth has averaged 80,000 a month in 2026 but has been erratic, from the loss of 156,000 jobs in February to growth of 214,000 the following month, with hits and misses in between. "]},{"tagName":"p","children":["Wage growth also has moderated, with average hourly earnings expected to show a 3.1% year-over-year increase in September, down from around 4% at the start of the year. Fed officials have emphasized that wages are not a significant source of inflation, with the lack of evidence of a wage-price spiral an important distinction when calibrating policy."]},{"tagName":"p","children":["Still, there are worries over labor market conditions."]},{"tagName":"p","children":["The most recent ",{"tagName":"a","attributes":{"href":"https:\u002F\u002Fwww.glassdoor.com\u002Fblog\u002Fglassdoor-employee-confidence-index-september-2026\u002F","section":{},"premium":false,"contentClassification":[]},"children":["Glassdoor survey"]}," shows employee confidence fell to a record low in September, the third time that has happened this year. Daniel Zhao, the job site's chief economist, said the concerns come as \"anxiety around job security, economic uncertainty and inflation mount.\""]},{"tagName":"p","children":["Workers also cite fear of artificial intelligence."]},{"tagName":"p","children":["However, layoffs remain low, with the latest data showing that first-time claims for unemployment insurance edged down to 197,000 last week. Job placement firm Challenger, Gray & Christmas reported Thursday that layoffs in September were off 18% from August and 20% from the same period a year ago."]},{"tagName":"p","children":["\"Job openings are going down, hiring's kind of creeping down, and you find out that anecdotally, anyway, and also in the data, that it's very hard for people to get a new job,\" said Dan North, senior economist at Allianz Trade. \"You have that unemployment rate which doesn't move much, and it's really important to see that historically it's pretty low. So, I think you're seeing a job market that is — 'stable' is a really good word for it.\""]}],"__typename":"bodyContent"},{"tagName":"cnbcvideo","attributes":{"id":108371201,"vcpsId":7000426218,"type":"cnbcvideo","headline":"Fed's Jefferson: Future policy adjustments should be determined carefully","title":"Fed's Jefferson: Future policy adjustments should be determined carefully","url":"https:\u002F\u002Fwww.cnbc.com\u002Fvideo\u002F2026\u002F10\u002F01\u002Ffeds-jefferson-future-policy-adjustments-should-be-determined-carefully.html","show":"The Exchange","description":"Fed Vice Chair Philip Jefferson is speaking Thursday about the economy and monetary policy. CNBC's Steve Liesman has the latest.","thumbnail":"https:\u002F\u002Fimage.cnbcfm.com\u002Fapi\u002Fv1\u002Fimage\u002F108371202-17908761131790876111-48727227356-1080pnbcnews.jpg?v=1790876112","duration":216,"uploadDate":"2026-10-01T17:35:12+0000","autoPlay":false,"contentClassification":[]},"data":{"id":108371201,"contentClassification":[],"type":"cnbcvideo","title":"Fed's Jefferso