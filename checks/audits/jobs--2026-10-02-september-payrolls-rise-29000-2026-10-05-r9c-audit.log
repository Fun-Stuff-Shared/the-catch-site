src/pages/events/jobs/2026-10-02-september-payrolls-rise-29000.astro:13:import { event, averages, multipleJobholders, wageGrowth, primeAgeParticipation, u6, chronology, revisionColumns, revisionRows, household, establishment, revisions, septemberPayrollChange, admitted } from "../../../data/jobs-2026-10-02-september-payrolls-rise-29000.mjs";
