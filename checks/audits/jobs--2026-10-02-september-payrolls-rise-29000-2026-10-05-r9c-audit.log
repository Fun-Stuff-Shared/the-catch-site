taByGDSMarketTable":{},"page":{"page":{"layout":[{"editable":false,"columns":[{"span":"full","editable":false,"modules":[{"name":"adTopBanner","source":null,"canChangeLayout":false,"canChangeSource":false,"serverRenderPolicy":null,"attributes":{},"options":null,"data":{"__typename":"asset"},"__typename":"module"}],"__typename":"column"}],"__typename":"layout"},{"editable":true,"columns":[{"span":"full","editable":true,"modules":[{"name":"articleHeader","source":"108371134","canChangeLayout":false,"canChangeSource":false,"serverRenderPolicy":null,"attributes":{"isSpecialReport":false},"options":{},"data":{"id":108371134,"brand":"cnbc","contentClassification":[],"type":"cnbcnewsstory","url":"https:\u002F\u002Fwww.cnbc.com\u002F2026\u002F10\u002F01\u002Fthe-september-jobs-report-will-be-released-friday-heres-what-to-expect.html","native":false,"premium":false,"datePublished":"2026-10-01T18:55:02+0000","dateModified":"2026-10-01T18:55:02+0000","dateLastPublished":"2026-10-01T18:55:02+0000","datePublishedFormatted":"Published Thu, Oct 1 2026 • 2:55 PM EDT","dateLastPublishedFormatted":null,"deck":null,"description":"Wall Street is looking for job growth of 84,000 to close out the summer.","socialtoolsEnabled":true,"shortestHeadline":null,"headline":"The September jobs report will be released Friday. Here's what to expect","title":"The September jobs report will be released Friday. Here's what to expect","jobTitle":null,"socialMediaInfo":null,"sourceOrganization":[{"id":80000022,"type":"source","url":"https:\u002F\u002Fwww.cnbc.com\u002Fsearch\u002F?query=CNBC%20US","name":"CNBC.com","logo":null,"creatorOverwrite":null,"__typename":"source"}],"creatorOverwrite":null,"author":[{"id":36003787,"name":"Jeff Cox","jobTitle":"Economics Editor","url":"https:\u002F\u002Fwww.cnbc.com\u002Fjeff-cox\u002F","image":"https:\u002F\u002Fimage.cnbcfm.com\u002Fapi\u002Fv1\u002Fimage\u002F107136383-1666097431576-2022_Headshots-6927.jpg?v=1666097477","sameAs":["https:\u002F\u002Fwww.twitter.com\u002FJeffCoxCNBCcom","https:\u002F\u002Fwww.facebook.com\u002Fjeff.cox.7528"],"socialMediaInfo":[{"url":"https:\u002F\u002Ftwitter.com\u002FJeffCoxCNBCcom","displayText":"JeffCoxCNBCcom","type":"twitter","__typename":"socialMediaInfo"},{"url":"https:\u002F\u002Ffacebook.com\u002Fjeff.cox.7528","displayText":"jeff.cox.7528","type":"facebook","__typename":"socialMediaInfo"}],"__typename":"creator"}],"featuredAudio":[{"id":108371295,"url":"https:\u002F\u002Ffm.cnbc.com\u002Fapplications\u002Fcnbc.com\u002Fresources\u002Faudio\u002F2026\u002F10\u002F01\u002F1790880594191-the_september_jo.mp3","fileFormat":"audio\u002Fmpeg","contentSize":3701490,"title":"Narration: The September jobs report will be released Friday. Here's what to expect Oct 1 02:50 PM EDT","__typename":"audio"}],"promoImage":{"id":108368226,"url":"https:\u002F\u002Fimage.cnbcfm.com\u002Fapi\u002Fv1\u002Fimage\u002F108368226-1790357107689-gettyimages-2297111114-jr_18726_qicaeixs.jpeg?v=1790357497","caption":"Victor Moreno (C), from Jiffy Lube, speaks to people about job opportunities during the Mega JobNewsUSA South Florida Job Fair held in the Amerant Bank Arena on Sept. 25, 2026 in Sunrise, Florida. ","__typename":"infographic"},"featuredMedia":null,"publisher":{"name":"CNBC","logo":"https:\u002F\u002Fsc.cnbcfm.com\u002Fapplications\u002Fcnbc.com\u002Fstaticcontent\u002Fimg\u002Fcnbc-hdr-logo2.png","__typename":"publisher"},"section":{"id":20910258,"brand":"cnbc","type":"franchise","color":null,"name":"Economy","eyebrow":"Economy","shortestHeadline":"Economy","url":"https:\u002F\u002Fwww.cnbc.com\u002Feconomy\u002F","subType":"section","section":{"subType":"marketsection","__typename":"franchise"},"image":null,"logo":{"id":null,"url":null,"__typename":"image"},"__typename":"franchise"},"upNext":null,"__typename":"articleHeader"},"__typename":"module"}],"__typename":"column"}],"__typename":"layout"},{"editable":true,"columns":[{"span":"9","editable":true,"modules":[{"name":"articleInlineMedia","source":"108371134","canChangeLayout":false,"canChangeSource":false,"serverRenderPolicy":null,"attributes":{},"options":{},"data":{"id":108371134,"brand":"cnbc","section":{"id":20910258,"color":null,"__typename":"franchise"},"featuredMedia":null,"__typename":"articleInlineMedia"},"__typename":"module"},{"name":"keyPoints","source":"108371134","canChangeLayout":false,"canChangeSource":false,"serverRenderPolicy":null,"attributes":{},"options":{},"data":{"id":108371134,"brand":"cnbc","keyPoints":[{"tagName":"group","children":[{"tagName":"div","attributes":{"className":["group"]},"children":[{"tagName":"ul","children":[{"tagName":"li","children":["The Bureau of Labor Statistics will release the September nonfarm payrolls report Friday at 8:30 a.m., with Wall Street expecting job growth of 84,000 and unemployment holding at 4.1%."]},{"tagName":"li","children":["Fed officials repeatedly have emphasized the stability of the labor market and say they're more concerned about inflation."]},{"tagName":"li","children":["Still, a survey showed worker sentiment is around record lows."]}]}]}]}],"section":{"id":20910258,"color":null,"__typename":"franchise"},"__typename":"keyPoints"},"__typename":"module"},{"name":"articleBody","source":"108371134","canChangeLayout":false,"canChangeSource":false,"serverRenderPolicy":null,"attributes":{},"options":{},"data":{"id":108371134,"type":"cnbcnewsstory","brand":"cnbc","articleBodyText":"Lingering questions over the state of the U.S. labor market could be answered Friday when the Bureau of Labor Statistics presents its nonfarm payrolls count for September. Wall Street is looking for job growth of 84,000 to close out the summer, with the unemployment rate holding at 4.1%, according to the Dow Jones consensus. While the top-line payrolls number represents a downshift from the pre-2025 trend, the jobless rate, which Federal Reserve officials watch more closely, is around a level indicating full employment. The September release follows a surprisingly strong gain of 162,000 in August , which also saw upward revisions to prior months. Fed officials likely will be looking to the number to confirm labor market strength while they simultaneously turn the balance of their attention to the more nettlesome inflation picture. \"In the labor market, a broad range of data indicates that conditions have stabilized,\" Fed Vice Chairman Philip Jefferson said in a speech Thursday. \"While job creation has been somewhat volatile, payroll gains have broadened to many sectors in recent months, which is encouraging. Layoffs have remained low, and job openings have moved a bit higher on net.\" Even with a solid jobs picture, Fed commentary this week has shifted market expectations for a rate hike near the end of October. New York Fed President John Williams remarked earlier in the week that \"there is no need for urgency\" when policymakers weigh whether to follow up on September's quarter percentage point rate hike with another increase. \"On the employment side of [the Fed's twin goals of full employment and stable prices], the data show that the labor market continues to be solid — and has even strengthened a bit on the margin,\" Williams said. Markets subsequently sharply reduced the odds for a hike at the Oct. 27-28 meeting and see a move much more likely in December. Slow but steady Central to the argument that the Fed needs to focus on inflation but doesn't need to be in a hurry for another hike is the stable if unspectacular labor picture. Payroll growth has averaged 80,000 a month in 2026 but has been erratic, from the loss of 156,000 jobs in February to growth of 214,000 the following month, with hits and misses in between. Wage growth also has moderated, with average hourly earnings expected to show a 3.1% year-over-year increase in September, down from around 4% at the start of the year. Fed officials have emphasized that wages are not a significant source of inflation, with the lack of evidence of a wage-price spiral an important distinction when calibrating policy. Still, there are worries over labor market conditions. The most recent Glassdoor survey shows employee confidence fell to a record low in September, the third time that has happened this year. Daniel Zhao, the job site's chief economist, said the concerns come as \"anxiety around job security, economic uncertainty and inflation mount.\" Workers also cite fear of artificial intelligence. However, layoffs remain low, with the latest data showing that first-time claims for unemployment insurance edged down to 197,000 last week. Job placement firm Challenger, Gray & Christmas reported Thursday that layoffs in September were off 18% from August and 20% from the same period a year ago. \"Job openings are going down, hiring's kind of creeping down, and you find out that anecdotally, anyway, and also in the data, that it's very hard for people to get a new job,\" said Dan North, senior economist at Allianz Trade. \"You have that unemployment rate which doesn't move much, and it's really important to see that historically it's pretty low. So, I think you're seeing a job market that is — 'stable' is a really good word for it.\"","contentClassification":[],"faqContent":null,"premium":false,"section":{"id":20910258,"color":null,"__typename":"franchise"},"native":false,"creatorOverwrite":null,"sourceOrganization":[{"id":80000022,"url":"https:\u002F\u002Fwww.cnbc.com\u002Fsearch\u002F?query=CNBC%20US","name":"CNBC.com","logo":null,"creatorOverwrite":null,"linkHeadline":null,"__typename":"source"}],"body":{"content":[{"tagName":"image","attributes":{"id":"108368226","type":"image","creatorOverwrite":"Joe Raedle | Getty Images","headline":"GP: Jobs, Career Fair, Now Hiring: Over 50 Employers Look To Hire At South Florida Job Fair","url":"https:\u002F\u002Fimage.cnbcfm.com\u002Fapi\u002Fv1\u002Fimage\u002F108368226-1790357107689-gettyimages-2297111114-jr_18726_qicaeixs.jpeg?v=1790357497","datePublished":"2026-09-25T17:31:37+0000","caption":"Victor Moreno (C), from Jiffy Lube, speaks to people about job opportunities during the Mega JobNewsUSA South Florida Job Fair held in the Amerant Bank Arena on Sept. 25, 2026 in Sunrise, Florida. ","copyrightHolder":"Joe Raedle | Getty Images","width":"6000","height":"3999","altText":"SUNRISE, FLORIDA - SEPTEMBER 25: Victor Moreno (C), from Jiffy Lube, speaks to people about job opportunities during the Mega JobNewsUSA South Florida Job Fair held in the Amerant Bank Arena on September 25, 2026 in Sunrise, Florida. Hiring managers and recruiters from more than 50 companies attended the job fair to recruit workers for opportunities across a range of companies.  (Photo by Joe Raedle\u002FGetty Images)"},"data":{"__typename":"image"},"children":[],"__typename":"bodyContent"},{"tagName":"div","attributes":{"className":["group"]},"data":{"__typename":"asset"},"children":[{"tagName":"p","children":["Lingering questions over the state of the U.S. labor market could be answered Friday when the Bureau of Labor Statistics presents its nonfarm payrolls count for September."]},{"tagName":"p","children":["Wall Street is looking for job growth of 84,000 to close out the summer, with the unemployment rate holding at 4.1%, according to the Dow Jones consensus. "]},{"tagName":"p","children":["While the top-line payrolls number represents a downshift from the pre-2025 trend, the jobless rate, which Federal Reserve officials watch more closely, is around a level indicating full employment. "]},{"tagName":"p","children":["The September release follows a surprisingly strong ",{"tagName":"a","attributes":{"id":"108358891","href":"https:\u002F\u002Fwww.cnbc.com\u002F2026\u002F09\u002F04\u002Fjobs-report-august-2026.html","type":"cnbcnewsstory","brand":"cnbc","section":{"subType":"section"},"premium":false,"contentClassification":[]},"children":["gain of 162,000 in August"]},", which also saw upward revisions to prior months."]},{"tagName":"p","children":["Fed officials likely will be looking to the number to confirm labor market strength while they simultaneously turn the balance of their attention to the more nettlesome inflation picture."]}],"__typename":"bodyContent"},{"tagName":"cnbcvideo","attributes":{"id":108371188,"vcpsId":7000426215,"type":"cnbcvideo","headline":"It's a low-hire, low-fire job market, says Revelio Labs’ Evan Sohn","title":"It's a low-hire, low-fire job market, says Revelio Labs’ Evan Sohn","url":"https:\u002F\u002Fwww.cnbc.com\u002Fvideo\u002F2026\u002F10\u002F01\u002Fits-a-low-hire-low-fire-job-market-says-revelio-labsa-evan-sohn.html","show":"The Exchange","description":"Evan Sohn, Revelio Labs managing director, joins 'The Exchange' to discuss the countdown to the September jobs report, what's happening in health care, and more.","thumbnail":"https:\u002F\u002Fimage.cnbcfm.com\u002Fapi\u002Fv1\u002Fimage\u002F108371189-17908749111790874907-48726921699-1080pnbcnews.jpg?v=1790874910","duration":315,"uploadDate":"2026-10-01T17:15:10+0000","autoPlay":false,"contentClassification":[]},"data":{"id":108371188,"contentClassification":[],"type":"cnbcvideo","title":"It's a low-hire, low-fire job market, says Revelio Labs’ Evan Sohn","seoTitle":"It's a low-hire, low-fire job market, says Revelio Labs’ Evan Sohn","premium":false,"native":false,"headline":"It's a low-hire, low-fire job market, says Revelio Labs’ Evan Sohn","shorterHeadline":"It's a low-hire, low-fire job market, says Revelio Labs’ Evan Sohn","tagName":null,"tagNameFormatted":"NA","tagNameFormattedFull":"NA","slug":"It's a low-hire, low-fire job market, says Revelio Labs’ Evan Sohn 1790874907","url":"https:\u002F\u002Fwww.cnbc.com\u002Fvideo\u002F2026\u002F10\u002F01\u002Fits-a-low-hire-low-fire-job-market-says-revelio-labsa-evan-sohn.html","description":"Evan Sohn, Revelio Labs managing director, joins 'The Exchange' to discuss the countdown to the September jobs report, what's happening in health care, and more.","encodings":[{"url":"https:\u002F\u002Fcnbc