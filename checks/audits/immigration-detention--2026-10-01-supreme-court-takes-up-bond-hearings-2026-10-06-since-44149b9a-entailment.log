?auth=6719de71df4b50bb71b3f4599e6a49174eb43286f07bfe666435ac87468f5a0c&width=400&smart=true","402x156":"https://www.abc.com.py/resizer/v2/2NG37KJIEZDSTL5J76UJAA7XII.jpg?auth=6719de71df4b50bb71b3f4599e6a49174eb43286f07bfe666435ac87468f5a0c&width=402&height=156&smart=true","402x85":"https://www.abc.com.py/resizer/v2/2NG37KJIEZDSTL5J76UJAA7XII.jpg?auth=6719de71df4b50bb71b3f4599e6a49174eb43286f07bfe666435ac87468f5a0c&width=402&height=85&smart=true","410x480":"https://www.abc.com.py/resizer/v2/2NG37KJIEZDSTL5J76UJAA7XII.jpg?auth=6719de71df4b50bb71b3f4599e6a49174eb43286f07bfe666435ac87468f5a0c&width=410&height=480&smart=true","420x545":"https://www.abc.com.py/resizer/v2/2NG37KJIEZDSTL5J76UJAA7XII.jpg?auth=6719de71df4b50bb71b3f4599e6a49174eb43286f07bfe666435ac87468f5a0c&width=420&height=545&smart=true","500x500":"https://www.abc.com.py/resizer/v2/2NG37KJIEZDSTL5J76UJAA7XII.jpg?auth=6719de71df4b50bb71b3f4599e6a49174eb43286f07bfe666435ac87468f5a0c&width=500&height=500&smart=true","540x250":"https://www.abc.com.py/resizer/v2/2NG37KJIEZDSTL5J76UJAA7XII.jpg?auth=6719de71df4b50bb71b3f4599e6a49174eb43286f07bfe666435ac87468f5a0c&width=540&height=250&smart=true","540x300":"https://www.abc.com.py/resizer/v2/2NG37KJIEZDSTL5J76UJAA7XII.jpg?auth=6719de71df4b50bb71b3f4599e6a49174eb43286f07bfe666435ac87468f5a0c&width=540&height=300&smart=true","600x908":"https://www.abc.com.py/resizer/v2/2NG37KJIEZDSTL5J76UJAA7XII.jpg?auth=6719de71df4b50bb71b3f4599e6a49174eb43286f07bfe666435ac87468f5a0c&width=600&height=908&smart=true","700x908":"https://www.abc.com.py/resizer/v2/2NG37KJIEZDSTL5J76UJAA7XII.jpg?auth=6719de71df4b50bb71b3f4599e6a49174eb43286f07bfe666435ac87468f5a0c&width=700&height=908&smart=true","770x190":"https://www.abc.com.py/resizer/v2/2NG37KJIEZDSTL5J76UJAA7XII.jpg?auth=6719de71df4b50bb71b3f4599e6a49174eb43286f07bfe666435ac87468f5a0c&width=770&height=190&smart=true","770x495":"https://www.abc.com.py/resizer/v2/2NG37KJIEZDSTL5J76UJAA7XII.jpg?auth=6719de71df4b50bb71b3f4599e6a49174eb43286f07bfe666435ac87468f5a0c&width=770&smart=true","770xorig":"https://www.abc.com.py/resizer/v2/2NG37KJIEZDSTL5J76UJAA7XII.jpg?auth=6719de71df4b50bb71b3f4599e6a49174eb43286f07bfe666435ac87468f5a0c&width=770&smart=true","800x600":"https://www.abc.com.py/resizer/v2/2NG37KJIEZDSTL5J76UJAA7XII.jpg?auth=6719de71df4b50bb71b3f4599e6a49174eb43286f07bfe666435ac87468f5a0c&width=800&smart=true","85x125":"https://www.abc.com.py/resizer/v2/2NG37KJIEZDSTL5J76UJAA7XII.jpg?auth=6719de71df4b50bb71b3f4599e6a49174eb43286f07bfe666435ac87468f5a0c&width=85&height=125&smart=true","90x100":"https://www.abc.com.py/resizer/v2/2NG37KJIEZDSTL5J76UJAA7XII.jpg?auth=6719de71df4b50bb71b3f4599e6a49174eb43286f07bfe666435ac87468f5a0c&width=90&height=100&smart=true","90x90":"https://www.abc.com.py/resizer/v2/2NG37KJIEZDSTL5J76UJAA7XII.jpg?auth=6719de71df4b50bb71b3f4599e6a49174eb43286f07bfe666435ac87468f5a0c&width=90&height=90&smart=true","910x590":"https://www.abc.com.py/resizer/v2/2NG37KJIEZDSTL5J76UJAA7XII.jpg?auth=6719de71df4b50bb71b3f4599e6a49174eb43286f07bfe666435ac87468f5a0c&width=910&height=590&smart=true","origx200":"https://www.abc.com.py/resizer/v2/2NG37KJIEZDSTL5J76UJAA7XII.jpg?auth=6719de71df4b50bb71b3f4599e6a49174eb43286f07bfe666435ac87468f5a0c&height=200&smart=true","origxorig":"https://www.abc.com.py/resizer/v2/2NG37KJIEZDSTL5J76UJAA7XII.jpg?auth=6719de71df4b50bb71b3f4599e6a49174eb43286f07bfe666435ac87468f5a0c&&smart=true"},"type":"image","url":"https://cloudfront-us-east-1.images.arcpublishing.com/abccolor/2NG37KJIEZDSTL5J76UJAA7XII.jpg"},{"_id":"723XORVVDRFC7AYU4D6GWTCTYM","content":"“Hay 1.200 millones de dólares aproximadamente de deuda por medicamentos, pero se ejecutó el 94% del rubro en 2024 y 77% en 2025. El ministro de Economía está mudo, no nos cuenta por qué se generó la deuda. El Ministerio tiene que ser más proactivo en cómo gestiona su stock. Hay 60 moléculas básicas que no pueden faltar. La prioridad es cortar lo que haga falta en el Presupuesto 2027 para que no falte medicina”, subrayó.","type":"text"},{"_id":"WT6BBUNSF5BYPO7XGVRF2MCRCM","content":"Crisis sanitaria: más de 200 anestesiólogos presentan renuncias ante el Ministerio de Salud","type":"interstitial_link","url":"https://www.abc.com.py/nacionales/2026/09/07/crisis-sanitaria-mas-de-200-anestesiologos-presentan-renuncias-ante-el-ministerio-de-salud/"},{"_id":"3XRRYKLJ7ZGUBKZECJ4KYP4KEQ","content":"Frente al señalamiento sobre una aparente apatía de la administración Peña ante las demandas de la salud, Leite marcó distancia. “Yo le veo al presidente del Partido Colorado y a nosotros muy preocupados y ocupados en tratar de que la gente reciba lo que se merece”, desligó.","type":"text"},{"_id":"ORQOEL3UGJB5ZJG6CRJIB3HQOM","raw_oembed":{"html":"<blockquote class=\"twitter-tweet\"><p lang=\"es\" dir=\"ltr\">🗣️ &quot;Hay una necesidad de deslindar responsabilidades, no hay que enojarse por pedir transparencia&quot;. <br><br>🗣️ &quot;El presidente Cartes no tiene absolutamente nada que ver, no es accionista ni fue accionista de Ueno&quot;.<br><br>El senador Gustavo Leite aclaró que el presidente del partido, Horacio… <a href=\"https://t.co/cwDYdsH81u\">pic.twitter.com/cwDYdsH81u</a></p>&mdash; ABC Cardinal 730 AM (@ABCCardinal) <a href=\"https://x.com/ABCCardinal/status/2097324572542419009?ref_src=twsrc%5Etfw\">September 8, 2026</a></blockquote>\n<script async src=\"https://platform.x.com/widgets.js\" charset=\"utf-8\"><\/script>\n\n","url":"https://x.com/ABCCardinal/status/2097324572542419009"},"type":"oembed_response"},{"_id":"GHADYG344JBPVMKT5F26XN7SUQ","content":"El pedido de informes sobre Ueno Bank","level":2,"type":"header"},{"_id":"CYI6FTXNP5GXBBKP36DN3BV6T4","content":"Respecto a la iniciativa impulsada por legisladores cartistas para que el BCP rinda cuentas sobre Ueno Bank —entidad que concentra millonarios fondos del <b>Instituto de Previsión Social</b> (IPS) y depósitos del sector público—, el legislador justificó la medida aduciendo la necesidad de cortar con las especulaciones.","type":"text"},{"_id":"RUBMTM4VRZCZVO5KDM2E2QPWRI","content":"Espínola califica de “técnicamente justificable” el pedido de informe sobre Ueno Bank","type":"interstitial_link","url":"https://www.abc.com.py/politica/2026/09/08/espinola-califica-de-tecnicamente-justificable-el-pedido-de-informe-sobre-ueno-bank/"},{"_id":"LI6APWUVFVCXTBJX2KCHFCOEWY","content":"“Tampoco somos extraterrestres, no vivimos en la Luna. Todo Paraguay habla de que Ueno tiene algunas circunstancias llamativas. Lo que corresponde es dilucidar: ¿es cierto que hay algo raro o no? Si es cierto, ¿quiénes son los responsables? Y si no es cierto, que se acabe este rumor. No es bueno que se esté hablando de un banco; el sistema financiero es muy sensible”, argumentó Leite.","type":"text"},{"_id":"VEOTM2DUSNBFXPDAXM2QQJKBOY","raw_oembed":{"html":"<blockquote class=\"twitter-tweet\"><p lang=\"es\" dir=\"ltr\">📍 Pedido de informe a BCP sobre Ueno Bank.<br><br>&quot;Lo que corresponde es dilucidar. Si es cierto que hay algo raro, ¿quiénes son los responsables? y si no que se acabe este rumor. Lo que si queda claro políticamente es que el presidente Cartes no tiene nada que ver&quot;, senador Gustavo… <a href=\"https://t.co/M0kW7WazmP\">pic.twitter.com/M0kW7WazmP</a></p>&mdash; ABC Cardinal 730 AM (@ABCCardinal) <a href=\"https://x.com/ABCCardinal/status/2097323097300877637?ref_src=twsrc%5Etfw\">September 8, 2026</a></blockquote>\n<script async src=\"https://platform.x.com/widgets.js\" charset=\"utf-8\"><\/script>\n\n","url":"https://x.com/ABCCardinal/status/2097323097300877637"},"type":"oembed_response"},{"_id":"7ZE2TE466ZEZFLMQFCYONDWP7Q","content":"Asimismo, procuró desvincular explícitamente al líder de la Junta de Gobierno de la ANR de cualquier nexo patrimonial con la firma financiera.","type":"text"},{"_id":"22KG7BLQIJBLLNZMZKUB5I5XFA","content":"Esto respondió Ueno sobre pedido de informe del Congreso","type":"interstitial_link","url":"https://www.abc.com.py/economia/2026/09/07/esto-respondio-ueno-sobre-pedido-de-informe-del-congreso/"},{"_id":"SAFM237ITNB5NMYU7CZPBC5MZY","content":"“Lo que queda claro políticamente es que el presidente Cartes no tiene absolutamente nada que ver con Ueno. No es accionista de Ueno, no fue accionista de Ueno y, como presidente del Partido Colorado, no puede hacerse responsable de lo que manejen los otros”, defendió.","type":"text"},{"_id":"QJRPFDO6SZB6RP6TCX3BVLAUBQ","caption":"Carlos Carvallo, presidente de BCP; Holger, titular de la Superintendencia de Bancos y Miguel Vázquez, CEO de Uen","credits":{},"resized_urls":{"1080x1270":"https://www.abc.com.py/resizer/v2/QJRPFDO6SZB6RP6TCX3BVLAUBQ.jpg?auth=793131fd63bcec415c2ac211448c3ff7222c711442b26c5939f2238c32659e66&width=1080&height=1270&smart=true","110x70":"https://www.abc.com.py/resizer/v2/QJRPFDO6SZB6RP6TCX3BVLAUBQ.jpg?auth=793131fd63bcec415c2ac211448c3ff7222c711442b26c5939f2238c32659e66&width=110&height=70&smart=true","1140x663":"https://www.abc.com.py/resizer/v2/QJRPFDO6SZB6RP6TCX3BVLAUBQ.jpg?auth=793131fd63bcec415c2ac211448c3ff7222c711442b26c5939f2238c32659e66&width=1140&height=663&smart=true","115x115":"https://www.abc.com.py/resizer/v2/QJRPFDO6SZB6RP6TCX3BVLAUBQ.jpg?auth=793131fd63bcec415c2ac211448c3ff7222c711442b26c5939f2238c32659e66&width=115&height=115&smart=true","1200x1080":"https://www.abc.com.py/resizer/v2/QJRPFDO6SZB6RP6TCX3BVLAUBQ.jpg?auth=793131fd63bcec415c2ac211448c3ff7222c711442b26c5939f2238c32659e66&width=1200&smart=true","1280x720":"https://www.abc.com.py/resizer/v2/QJRPFDO6SZB6RP6TCX3BVLAUBQ.jpg?auth=793131fd63bcec415c2ac211448c3ff7222c711442b26c5939f2238c32659e66&width=1280&height=720&smart=true","1300x900":"https://www.abc.com.py/resizer/v2/QJRPFDO6SZB6RP6TCX3BVLAUBQ.jpg?auth=793131fd63bcec415c2ac211448c3ff7222c711442b26c5939f2238c32659e66&width=1300&height=900&smart=true","140x191":"https://www.abc.com.py/resizer/v2/QJRPFDO6SZB6RP6TCX3BVLAUBQ.jpg?auth=793131fd63bcec415c2ac211448c3ff7222c711442b26c5939f2238c32659e66&width=140&height=191&sma