WUFKHHSBAAPP6YOJTTEH34G4.jpg?auth=f58ab03ea2c70b72a17539576ba68a57dfcab0df1014d750496d646973a7197c&width=260&height=110&smart=true","270x175":"https://www.abc.com.py/resizer/v2/W4WUFKHHSBAAPP6YOJTTEH34G4.jpg?auth=f58ab03ea2c70b72a17539576ba68a57dfcab0df1014d750496d646973a7197c&width=270&height=175&smart=true","270x270":"https://www.abc.com.py/resizer/v2/W4WUFKHHSBAAPP6YOJTTEH34G4.jpg?auth=f58ab03ea2c70b72a17539576ba68a57dfcab0df1014d750496d646973a7197c&width=270&height=270&smart=true","300x352":"https://www.abc.com.py/resizer/v2/W4WUFKHHSBAAPP6YOJTTEH34G4.jpg?auth=f58ab03ea2c70b72a17539576ba68a57dfcab0df1014d750496d646973a7197c&width=300&height=352&smart=true","320x180":"https://www.abc.com.py/resizer/v2/W4WUFKHHSBAAPP6YOJTTEH34G4.jpg?auth=f58ab03ea2c70b72a17539576ba68a57dfcab0df1014d750496d646973a7197c&width=320&height=180&smart=true","350x225":"https://www.abc.com.py/resizer/v2/W4WUFKHHSBAAPP6YOJTTEH34G4.jpg?auth=f58ab03ea2c70b72a17539576ba68a57dfcab0df1014d750496d646973a7197c&width=350&height=225&smart=true","400x225":"https://www.abc.com.py/resizer/v2/W4WUFKHHSBAAPP6YOJTTEH34G4.jpg?auth=f58ab03ea2c70b72a17539576ba68a57dfcab0df1014d750496d646973a7197c&width=400&smart=true","400x257":"https://www.abc.com.py/resizer/v2/W4WUFKHHSBAAPP6YOJTTEH34G4.jpg?auth=f58ab03ea2c70b72a17539576ba68a57dfcab0df1014d750496d646973a7197c&width=400&smart=true","402x156":"https://www.abc.com.py/resizer/v2/W4WUFKHHSBAAPP6YOJTTEH34G4.jpg?auth=f58ab03ea2c70b72a17539576ba68a57dfcab0df1014d750496d646973a7197c&width=402&height=156&smart=true","402x85":"https://www.abc.com.py/resizer/v2/W4WUFKHHSBAAPP6YOJTTEH34G4.jpg?auth=f58ab03ea2c70b72a17539576ba68a57dfcab0df1014d750496d646973a7197c&width=402&height=85&smart=true","410x480":"https://www.abc.com.py/resizer/v2/W4WUFKHHSBAAPP6YOJTTEH34G4.jpg?auth=f58ab03ea2c70b72a17539576ba68a57dfcab0df1014d750496d646973a7197c&width=410&height=480&smart=true","420x545":"https://www.abc.com.py/resizer/v2/W4WUFKHHSBAAPP6YOJTTEH34G4.jpg?auth=f58ab03ea2c70b72a17539576ba68a57dfcab0df1014d750496d646973a7197c&width=420&height=545&smart=true","500x500":"https://www.abc.com.py/resizer/v2/W4WUFKHHSBAAPP6YOJTTEH34G4.jpg?auth=f58ab03ea2c70b72a17539576ba68a57dfcab0df1014d750496d646973a7197c&width=500&height=500&smart=true","540x250":"https://www.abc.com.py/resizer/v2/W4WUFKHHSBAAPP6YOJTTEH34G4.jpg?auth=f58ab03ea2c70b72a17539576ba68a57dfcab0df1014d750496d646973a7197c&width=540&height=250&smart=true","540x300":"https://www.abc.com.py/resizer/v2/W4WUFKHHSBAAPP6YOJTTEH34G4.jpg?auth=f58ab03ea2c70b72a17539576ba68a57dfcab0df1014d750496d646973a7197c&width=540&height=300&smart=true","600x908":"https://www.abc.com.py/resizer/v2/W4WUFKHHSBAAPP6YOJTTEH34G4.jpg?auth=f58ab03ea2c70b72a17539576ba68a57dfcab0df1014d750496d646973a7197c&width=600&height=908&smart=true","700x908":"https://www.abc.com.py/resizer/v2/W4WUFKHHSBAAPP6YOJTTEH34G4.jpg?auth=f58ab03ea2c70b72a17539576ba68a57dfcab0df1014d750496d646973a7197c&width=700&height=908&smart=true","770x190":"https://www.abc.com.py/resizer/v2/W4WUFKHHSBAAPP6YOJTTEH34G4.jpg?auth=f58ab03ea2c70b72a17539576ba68a57dfcab0df1014d750496d646973a7197c&width=770&height=190&smart=true","770x495":"https://www.abc.com.py/resizer/v2/W4WUFKHHSBAAPP6YOJTTEH34G4.jpg?auth=f58ab03ea2c70b72a17539576ba68a57dfcab0df1014d750496d646973a7197c&width=770&smart=true","770xorig":"https://www.abc.com.py/resizer/v2/W4WUFKHHSBAAPP6YOJTTEH34G4.jpg?auth=f58ab03ea2c70b72a17539576ba68a57dfcab0df1014d750496d646973a7197c&width=770&smart=true","800x600":"https://www.abc.com.py/resizer/v2/W4WUFKHHSBAAPP6YOJTTEH34G4.jpg?auth=f58ab03ea2c70b72a17539576ba68a57dfcab0df1014d750496d646973a7197c&width=800&smart=true","85x125":"https://www.abc.com.py/resizer/v2/W4WUFKHHSBAAPP6YOJTTEH34G4.jpg?auth=f58ab03ea2c70b72a17539576ba68a57dfcab0df1014d750496d646973a7197c&width=85&height=125&smart=true","90x100":"https://www.abc.com.py/resizer/v2/W4WUFKHHSBAAPP6YOJTTEH34G4.jpg?auth=f58ab03ea2c70b72a17539576ba68a57dfcab0df1014d750496d646973a7197c&width=90&height=100&smart=true","90x90":"https://www.abc.com.py/resizer/v2/W4WUFKHHSBAAPP6YOJTTEH34G4.jpg?auth=f58ab03ea2c70b72a17539576ba68a57dfcab0df1014d750496d646973a7197c&width=90&height=90&smart=true","910x590":"https://www.abc.com.py/resizer/v2/W4WUFKHHSBAAPP6YOJTTEH34G4.jpg?auth=f58ab03ea2c70b72a17539576ba68a57dfcab0df1014d750496d646973a7197c&width=910&height=590&smart=true","origx200":"https://www.abc.com.py/resizer/v2/W4WUFKHHSBAAPP6YOJTTEH34G4.jpg?auth=f58ab03ea2c70b72a17539576ba68a57dfcab0df1014d750496d646973a7197c&height=200&smart=true","origxorig":"https://www.abc.com.py/resizer/v2/W4WUFKHHSBAAPP6YOJTTEH34G4.jpg?auth=f58ab03ea2c70b72a17539576ba68a57dfcab0df1014d750496d646973a7197c&&smart=true"},"type":"image","url":"https://cloudfront-us-east-1.images.arcpublishing.com/abccolor/W4WUFKHHSBAAPP6YOJTTEH34G4.jpg"}},"publish_date":"2026-09-08T00:06:38.389Z","related_content":{"basic":[]},"subheadlines":{"basic":"El director médico del Hospital Nacional de Itauguá, José Espínola Orrego, brindó una serie de detalles referentes al estado de salud del exgobernador Hugo Javier González tras su cirugía. ¿Cómo se encuentra? En la siguiente nota, más detalles. "},"taxonomy":{"primary_section":{"_id":"/nacionales","name":"Nacionales","path":"/nacionales"},"tags":[{"slug":"hugo-javier-gonzalez","text":"Hugo Javier González"},{"slug":"hospital-nacional-de-itaugua","text":" Hospital Nacional de Itauguá"},{"slug":"accidente-cerebrovascular-acv","text":"accidente cerebrovascular (acv)"}]},"type":"story","website_url":"/nacionales/2026/09/07/hugo-javier-medico-brinda-estos-detalles-sobre-el-estado-del-exgobernador-tras-cirugia/"},{"_id":"CI2KJGYWINEKJLRB2IEHJIJFPI","canonical_url":"/nacionales/2026/09/08/la-hipotesis-preliminar-de-la-fiscalia-sobre-las-lesiones-de-hugo-javier/","content_elements":[{"_id":"CVHG3BS64JDPBMDHYU7KDXK2QI","content":"Este martes, el <b>Ministerio Público</b> presentó su hipótesis preliminar sobre el caso de <a href=\"https://www.abc.com.py/tag/hugo-javier-gonzalez/\" target=\"_blank\" rel=\"noreferrer\" title=\"https://www.abc.com.py/tag/hugo-javier-gonzalez/\"><b>Hugo Javier González</b></a>, exgobernador del departamento <b>Central </b>condenado a prisión por desvío de fondos públicos, quien fue <b>trasladado ayer a un hospital</b> desde su lugar de reclusión tras haber sufrido una caída que le produjo importantes lesiones.","type":"text"},{"_id":"M5ZEIAKGOJFCDCL5AEDSUGK5J4","content":"González fue trasladado el domingo, en horas de la noche, al <b>Hospital General de Barrio Obrero</b>, en Asunción, luego de que su compañero de celda en la <b>Unidad Penitenciaria Industrial La Esperanza</b> alertara a los guardias penitenciarios de que el expolítico había sufrido una caída y quedó inconsciente.","type":"text"},{"_id":"HV5ABUSWIZAA5DR7BR5T7IAAYE","content":"Lea más: <a href=\"https://www.abc.com.py/nacionales/2026/09/08/caso-hugo-javier-fiscalia-remite-a-laboratorio-forense-filmaciones-de-la-carcel-y-llama-a-testigos/\" target=\"_blank\" rel=\"noreferrer\" title=\"https://www.abc.com.py/nacionales/2026/09/08/caso-hugo-javier-fiscalia-remite-a-laboratorio-forense-filmaciones-de-la-carcel-y-llama-a-testigos/\">Caso Hugo Javier: Fiscalía remite a laboratorio forense filmaciones de la cárcel y llama a testigos</a>","type":"text"},{"_id":"WUHIONU5L5FLVIAP67FOTMEBIA","content":"El exgobernador fue trasladado del Hospital de Barrio Obrero al <b>Hospital Nacional de Itauguá</b>, donde permanece internado en terapia intensiva y donde se determinó que había sufrido un <b>accidente cerebrovascular</b>.","type":"text"},{"_id":"QBEL5UBS45AOHGOFBRPVT4FIR4","content":"“Caída accidental”","level":2,"type":"header"},{"_id":"HJK43MLSIFFBTAEZM4CZE24LGQ","caption":"Hugo Javier González siendo trasladado en silla de ruedas para ser llevado a un hospital tras su caída en su celda.","credits":{},"resized_urls":{"1080x1270":"https://www.abc.com.py/resizer/v2/HJK43MLSIFFBTAEZM4CZE24LGQ.jpg?auth=e8a4c480ffefd7dbd33dd539228c5d8b866e8ea3d466c6690f67ca61d