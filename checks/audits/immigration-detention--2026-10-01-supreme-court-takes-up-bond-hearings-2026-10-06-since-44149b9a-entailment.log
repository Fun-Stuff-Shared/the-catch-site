?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=410&height=480&smart=true","420x545":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=420&height=545&smart=true","500x500":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=500&height=500&smart=true","540x250":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=540&height=250&smart=true","540x300":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=540&height=300&smart=true","600x908":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=600&height=908&smart=true","700x908":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=700&height=908&smart=true","770x190":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=770&height=190&smart=true","770x495":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=770&smart=true","770xorig":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=770&smart=true","800x600":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=800&smart=true","85x125":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=85&height=125&smart=true","90x100":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=90&height=100&smart=true","90x90":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=90&height=90&smart=true","910x590":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=910&height=590&smart=true","origx200":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&height=200&smart=true","origxorig":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&&smart=true"},"type":"image","url":"https://cloudfront-us-east-1.images.arcpublishing.com/abccolor/BTDKATM4ZZHHTKVABRDS4CU4II.jpg"},{"_id":"UZ62GQESCRHENKXCOCWHJZSAMA","content":"Lea más: <a href=\"https://www.abc.com.py/politica/2026/09/07/salud-tiene-prioridad-presupuestaria-senala-leite-tras-reunion-en-residencia-de-cartes/\" target=\"_blank\" rel=\"noreferrer\" title=\"https://www.abc.com.py/politica/2026/09/07/salud-tiene-prioridad-presupuestaria-senala-leite-tras-reunion-en-residencia-de-cartes/\">Salud “tiene prioridad presupuestaria”, señala Leite tras reunión en residencia de Cartes</a>","type":"text"},{"_id":"FIGYKCZYFRDA5OLUKT64PTRVUM","content":"Pedido sobre Ueno Bank abre interrogantes políticos","level":2,"type":"header"},{"_id":"E74ETZDG2BGJPF4VCZ53Z4P5TQ","content":"La coincidencia temporal entre la reunión y la presentación del proyecto legislativo generó interpretaciones dentro de distintos sectores políticos.","type":"text"},{"_id":"RRNJCX3ANBEMFJFVCOQTTHTOOE","content":"La iniciativa impulsada por los senadores cartistas busca que el BCP informe sobre las operaciones de<b> Ueno Bank</b>, especialmente respecto a posibles vínculos con empresas relacionadas, el cumplimiento de los límites establecidos por la legislación financiera y el nivel de supervisión ejercido por la banca matriz.","type":"text"},{"_id":"XR3STLZ7SNCSHAIYKHDAYA25D4","content":"El proyecto surge en un contexto marcado por cuestionamientos sobre la elevada concentración de fondos públicos y recursos del<b> Instituto de Previsión Social (IPS) </b>en dicha entidad financiera.","type":"text"},{"_id":"AQB77Q4WD5CL3ACZXRKZR5JX5Q","content":"Para algunos actores políticos, la medida podría interpretarse como una señal de presión hacia el entorno del presidente Peña. Otros, sin embargo, sostienen que el objetivo sería precisamente despejar las dudas existentes y “blanquear” la situación del banco ante las constantes críticas.","type":"text"},{"_id":"Z73IFPMA2NC4PDLDR32FF3MAY4","content":"Mensaje sobre salud pública genera lecturas internas","level":2,"type":"header"},{"_id":"3DFNJSZPVZAQVHEGS2SC2DQHJA","content":"Las especulaciones sobre una posible tensión dentro de Honor Colorado también se apoyan en el contenido de una publicación realizada en redes sociales tras el encuentro.","type":"text"},{"_id":"YOUAT6UPYRE6BC5OFHISWHF2G4","content":"El mensaje difundido por el senador Gustavo Leite señalaba: “Almuerzo de trabajo con el presidente del Partido Colorado. <b>Salud para la gente</b>, sin distinción. La prioridad presupuestaria para el 2027”.","type":"text"},{"_id":"7I5ZEKCQ5ND3FIJRMNMXX2S7EU","content":"La referencia a la salud pública llamó la atención debido a que se trata de una de las áreas más cuestionadas de la administración de Santiago Peña. Además, Leite es uno de los dirigentes cartistas que con mayor frecuencia ha expresado críticas hacia la gestión del Ejecutivo.","type":"text"},{"_id":"JW3J47GASZBEFAX4EGODNCRTSA","content":"Crisis sanitaria coincide con la reunión en el Comando","level":2,"type":"header"},{"_id":"NVCJH4DKYJGRNHMUQNROIHMJZY","content":"La reunión en la residencia de Cartes también se produjo en vísperas de una decisión relevante del Senado. La Cámara Alta prevé aprobar la creación de una Comisión Especial de Crisis para estudiar y evaluar la situación del sistema nacional de salud.","type":"text"},{"_id":"WLBZMFHZ3BGJTOD3CCPJCF3HAI","content":"La iniciativa surge en medio de la crisis provocada por la renuncia masiva de médicos especialistas tras las movilizaciones y la huelga desarrolladas por gremios del sector público a finales de agosto.","type":"text"},{"_id":"PA6TKMAQU5BC3KPMRKYEC4KVVI","content":"Antonio Barrios admite errores en el manejo del conflicto","level":2,"type":"header"},{"_id":"XE47EC53INDVLKW3BN5FNDYQPA","content":"Otro elemento que alimentó las versiones sobre diferencias internas fueron las declaraciones del senador cartista Antonio Barrios, quien reconoció públicamente que existió una demora del Gobierno para establecer canales de diálogo con los profesionales de la salud.","type":"text"},{"_id":"OEZAPQZKCZHLFDOAIJ25IFNOFM","content":"“Si puedo tener una crítica, es que <b>la parte del Ministerio tardó en llegar a un diálogo</b>. Tenés que sentarte a hablar de entrada, explicarles, porque cuando uno entra en una guerra ya pierde el sentido de la razón”, manifestó el legislador.","type":"text"},{"_id":"VXIJPHO2JRAXNCN2JANOETUBME","content":"Lea más: <a href=\"https://www.abc.com.py/politica/2026/09/07/renuncias-de-medicos-senado-creara-comision-especial-para-atender-crisis-sanitaria/\" rel=\"\">Renuncias de médicos: Senado creará comisión especial para atender crisis sanitaria</a>","type":"text"},{"_id":"JHYMME3AKZHY3IBROBI42KYOFQ","content":"Sus declaraciones fueron interpretadas como uno de los cuestionamientos más directos realizados desde el cartismo hacia la administración Peña en medio de la crisis sanitaria.","type":"text"}],"credits":{"by":[{"image":{"url":"https://author-service-images-prod-us-east-1.publishing.aws.arc.pub/abccolor/726d0038-1a5d-4e00-9a3d-72a94b8466dd.png"},"name":"Joaquín Tandé","slug":"joaquin-tande"}]},"description":{"basic":""},"display_date":"2026-09-08T12:54:59.744Z","headlines":{"basic":"¿Quiebre entre Peña y Cartes? Reunión en casa de HC y ofensiva sobre Ueno alimentan rumores"},"promo_items":{"basic":{"caption":"Sectores políticos apuntan a un distanciamiento entre el presidente Santiago Peña y el líder del cartismo, Horacio Cartes.","credits":{"by":[{"name":"Imagen original: Juan Pablo Pino - Edición: Leda Sostoa"}]},"resized_urls":{"1080x1270":"https://www.abc.com.py/resizer/v2/5IU3BEY5ZBFHBCBYFQVZFKCXKE.jpg?auth=e776831a747a2ae0ced053065132db5dff5dcaa437d01c9e21a2ae547a26f94e&width=1080&height=1270&smart=true","110x70":"https://www.abc.com.py/resizer/v2/5IU3BEY5ZBFHBCBYFQVZFKCXKE.jpg?auth=e776831a747a2ae0ced053065132db5dff5dcaa437d01c9e21a2ae547a26f94e&width=110&height=70&smart=true","1140x663":"https://www.abc.com.py/resizer/v2/5IU3BEY5ZBFHBCBYFQVZFKCXKE.jpg?auth=e776831a747a2ae0ced053065132db5dff5dcaa437d01c9e21a2ae547a26f94e&width=1140&height=663&smart=true","115x115":"https://www.abc.com.py/resizer/v2/5IU3BEY5ZBFHBCBYFQVZFKCXKE.jpg?auth=e776831a747a2ae0ced053065132db5dff5dcaa437d01c9e21a2ae547a26f94e&width=115&height=115&smart=true","1200x1080":"https://www.abc.com.py/resizer/v2/5IU3BEY5ZBFHBCBYFQVZFKCXKE.jpg?auth=e776831a747a2ae0ced053065132db5dff5dcaa437d01c9e21a2ae547a26f94e&width=1200&smart=true","1280x720":"https://www.abc.com.py/resizer/v2/5IU3BEY5ZBFHBCBYFQVZFKCXKE.jpg?auth=e776831a747a2ae0ced053065132db5dff5dcaa437d01c9e21a2ae547a26f94e&width=1280&height=720&smart=true","1300x900":"https://www.abc.com.py/resizer/v2/5IU3BEY5ZBFHBCBYFQVZFKCXKE.jpg?auth=e776831a747a2ae0ced053065132db5dff5dcaa437d01c9e21a2ae547a26f94e&width=1300&height=900&smart=true","140x191":"https://www.abc.com.py/resizer/v2/5IU3BEY5ZBFHBCBYFQVZFKCXKE.jpg?auth=e776831a747a2ae0ced053065132db5dff5dcaa437d01c9e21a2ae547a26f94e&width=140&height=191&smart=true","155x87":"https://www.abc.com.py/resizer/v2/5IU3BEY5ZBFHBCBYFQVZFKCXKE.jpg?auth=e776831a747a2ae0ced053065132db5dff5dcaa437d01c9e21a2ae547a26f94e&width=155&smart=true","170x110":"https://www.abc.com.py/resizer/v2/5IU3BEY5ZBFHBCBYFQVZFKCXKE.jpg?auth=e776831a747a2ae0ced053065132db5dff5dcaa437d01c9e21a2ae547a26f94e&width=170&height=110&smart=true","170x170":"https://www.abc.com.py/resizer/v2/5IU3BEY5ZBFHBCBYFQVZFKCXKE.jpg?auth=e776831a747a2ae0ced053065132db5dff5dcaa437d01c9e21a2ae547a26f94e&width=170&height=170&smart=true","170x250":"https://www.abc.com.py/resizer/v2/5IU3BEY5ZBFHBCBYFQVZFKCXKE.jpg?auth=e776831a747a2ae0ced053065132db5dff5dcaa437d01c9e21a2ae547a26f94e&width=170&height=250&smart=true","1900x1000":"https://www.abc.com.py/resizer/v2/5IU3BEY5ZBFHBCBYFQVZFKCXKE.jpg?auth=e776831a747a2ae0ced053065132db5dff5dcaa437d01c9e21a2ae547a26f94e&width=1900&height=1000&smart=true","1920x1080":"https://www.abc.com.py/resizer/v2/5IU3BEY5ZBFHBCBYFQVZFKCXKE.jpg?auth=e776831a747a2ae0ced053065132db5dff5dcaa437d01c9e21a2ae547a26f94e&width=1920&height=1080&smart=true","1920xorig":"https://www.abc.com.py/resizer/v2/5IU3BEY5ZBFHBCBYFQVZFKCXKE.jpg?auth=e776831a747a2ae0ced053065132db5dff5dcaa437d01c9e21a2ae547a26f94e&width=1920&smart=true","200x300":"https://www.abc.com.py/resizer/v2/5IU3BEY5ZBFHBCBYFQVZFKCXKE.jpg?auth=e776831a747a2ae0ced053065132db5dff5dcaa437d01c9e21a2ae547a26f94e&width=200&height=300&smart=true","200x303":"https://www.abc.com.py/resizer/v2/5IU3BEY5ZBFHBCBYFQVZFKCXKE.jpg?auth=e776831a747a2ae0ced053065132db5dff5dcaa437d01c9e21a2ae547a26f94e&width=200&height=303&smart=true","200x320":"https://www.abc.com.py/resizer/v2/5IU3BEY5ZBFHBCBYFQVZFKCXKE.jpg?auth=e776831a747a2ae0ced053065132db5dff5dcaa437d01c9e21a2ae547a26f94e&width=200&height=320&smart=true","200x95":"https://www.abc.com.py/resizer/v2/5IU3BEY5ZBFHBCBYFQVZFKCXKE.jpg?auth=e776831a747a2ae0ced053065132db5dff5dcaa437d01c9e21a2ae547a26f94e&width=200&height=95&smart=true","205x158":"https://www.abc.com.py/resizer/v2/5IU3BEY5ZBFHBCBYFQVZFKCXKE.jpg?auth=e776831a747a2ae0ced053065132db5dff5dca