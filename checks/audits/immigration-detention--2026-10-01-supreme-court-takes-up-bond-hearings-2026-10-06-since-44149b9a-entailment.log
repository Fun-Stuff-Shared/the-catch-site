idth=402&height=156&smart=true","402x85":"https://www.abc.com.py/resizer/v2/NHSMC2P6P5HTHDOJBD55W46UWE.jpg?auth=847dfeb9b8a190062359ac4cd811884fe86316994d68ba0aa2793dd997b774a4&width=402&height=85&smart=true","410x480":"https://www.abc.com.py/resizer/v2/NHSMC2P6P5HTHDOJBD55W46UWE.jpg?auth=847dfeb9b8a190062359ac4cd811884fe86316994d68ba0aa2793dd997b774a4&width=410&height=480&smart=true","420x545":"https://www.abc.com.py/resizer/v2/NHSMC2P6P5HTHDOJBD55W46UWE.jpg?auth=847dfeb9b8a190062359ac4cd811884fe86316994d68ba0aa2793dd997b774a4&width=420&height=545&smart=true","500x500":"https://www.abc.com.py/resizer/v2/NHSMC2P6P5HTHDOJBD55W46UWE.jpg?auth=847dfeb9b8a190062359ac4cd811884fe86316994d68ba0aa2793dd997b774a4&width=500&height=500&smart=true","540x250":"https://www.abc.com.py/resizer/v2/NHSMC2P6P5HTHDOJBD55W46UWE.jpg?auth=847dfeb9b8a190062359ac4cd811884fe86316994d68ba0aa2793dd997b774a4&width=540&height=250&smart=true","540x300":"https://www.abc.com.py/resizer/v2/NHSMC2P6P5HTHDOJBD55W46UWE.jpg?auth=847dfeb9b8a190062359ac4cd811884fe86316994d68ba0aa2793dd997b774a4&width=540&height=300&smart=true","600x908":"https://www.abc.com.py/resizer/v2/NHSMC2P6P5HTHDOJBD55W46UWE.jpg?auth=847dfeb9b8a190062359ac4cd811884fe86316994d68ba0aa2793dd997b774a4&width=600&height=908&smart=true","700x908":"https://www.abc.com.py/resizer/v2/NHSMC2P6P5HTHDOJBD55W46UWE.jpg?auth=847dfeb9b8a190062359ac4cd811884fe86316994d68ba0aa2793dd997b774a4&width=700&height=908&smart=true","770x190":"https://www.abc.com.py/resizer/v2/NHSMC2P6P5HTHDOJBD55W46UWE.jpg?auth=847dfeb9b8a190062359ac4cd811884fe86316994d68ba0aa2793dd997b774a4&width=770&height=190&smart=true","770x495":"https://www.abc.com.py/resizer/v2/NHSMC2P6P5HTHDOJBD55W46UWE.jpg?auth=847dfeb9b8a190062359ac4cd811884fe86316994d68ba0aa2793dd997b774a4&width=770&smart=true","770xorig":"https://www.abc.com.py/resizer/v2/NHSMC2P6P5HTHDOJBD55W46UWE.jpg?auth=847dfeb9b8a190062359ac4cd811884fe86316994d68ba0aa2793dd997b774a4&width=770&smart=true","800x600":"https://www.abc.com.py/resizer/v2/NHSMC2P6P5HTHDOJBD55W46UWE.jpg?auth=847dfeb9b8a190062359ac4cd811884fe86316994d68ba0aa2793dd997b774a4&width=800&smart=true","85x125":"https://www.abc.com.py/resizer/v2/NHSMC2P6P5HTHDOJBD55W46UWE.jpg?auth=847dfeb9b8a190062359ac4cd811884fe86316994d68ba0aa2793dd997b774a4&width=85&height=125&smart=true","90x100":"https://www.abc.com.py/resizer/v2/NHSMC2P6P5HTHDOJBD55W46UWE.jpg?auth=847dfeb9b8a190062359ac4cd811884fe86316994d68ba0aa2793dd997b774a4&width=90&height=100&smart=true","90x90":"https://www.abc.com.py/resizer/v2/NHSMC2P6P5HTHDOJBD55W46UWE.jpg?auth=847dfeb9b8a190062359ac4cd811884fe86316994d68ba0aa2793dd997b774a4&width=90&height=90&smart=true","910x590":"https://www.abc.com.py/resizer/v2/NHSMC2P6P5HTHDOJBD55W46UWE.jpg?auth=847dfeb9b8a190062359ac4cd811884fe86316994d68ba0aa2793dd997b774a4&width=910&height=590&smart=true","origx200":"https://www.abc.com.py/resizer/v2/NHSMC2P6P5HTHDOJBD55W46UWE.jpg?auth=847dfeb9b8a190062359ac4cd811884fe86316994d68ba0aa2793dd997b774a4&height=200&smart=true","origxorig":"https://www.abc.com.py/resizer/v2/NHSMC2P6P5HTHDOJBD55W46UWE.jpg?auth=847dfeb9b8a190062359ac4cd811884fe86316994d68ba0aa2793dd997b774a4&&smart=true"},"type":"image","url":"https://cloudfront-us-east-1.images.arcpublishing.com/abccolor/NHSMC2P6P5HTHDOJBD55W46UWE.jpg"},{"_id":"QOB4G7IJYVC65I55OGWZUSMUUY","content":"Un factor al que la OCDE atribuye en parte el rendimiento bajo registrado a nivel mundial es el creciente uso ocioso de <b>dispositivos electrónicos con pantalla</b> como teléfonos celulares o tabletas en el entorno escolar.","type":"text"},{"_id":"CEFSYLR6FZDPHKRPDM6GF3HJ2A","content":"En Paraguay, un 38 por ciento de los estudiantes evaluados dijeron que sus compañeros se distraen con dispositivos digitales durante sus lecciones. En paralelo, el informe reporta también un “incremento sustancial” en el número de instituciones educativas que implementan <b>prohibiciones de uso de dispositivos</b> durante las clases, con relación a la evaluación de 2022.","type":"text"},{"_id":"GZ5DBKYH4FD33LHYJC7K5XK6JM","content":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Tecnología, IA y Pantallas - Uso diario de dispositivos digitales en la escuela</title>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Lato:wght@300;400&family=Montserrat:wght@700&display=swap\" rel=\"stylesheet\">\n\n  <style>\n    /* ===================================================\n       1. VARIABLES & SISTEMA DE DISEÑO\n       =================================================== */\n    :root {\n      --primary: #ffe500;\n      --text-main: #000000;\n      --border-color: #e2e8f0;\n      --bg-neutral: #f8fafc;\n      --bar-secondary: #94a3b8;\n      --radius: 10px; /* Rango permitido: 8px a 12px */\n    }\n\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n\n    body {\n      font-family: 'Lato', sans-serif;\n      font-weight: 400;\n      color: var(--text-main);\n      background-color: #ffffff;\n      padding: 32px 16px;\n      display: flex;\n      justify-content: center;\n    }\n\n    /* Reglas tipográficas obligatorias */\n    h1, h2, h3, h4, .font-title {\n      font-family: 'Montserrat', sans-serif;\n      font-weight: 700;\n      color: var(--text-main);\n      line-height: 1.25;\n    }\n\n    p, span, button, input, text {\n      font-family: 'Lato', sans-serif;\n      color: var(--text-main);\n    }\n\n    /* ===================================================\n       2. CONTENEDOR PRINCIPAL Y ESTRUCTURA\n       =================================================== */\n    .dashboard-card {\n      width: 100%;\n      max-width: 640px;\n      border: 1px solid var(--border-color);\n      border-radius: var(--radius);\n      padding: 24px;\n      background-color: #ffffff;\n    }\n\n    /* Indicador utilitario de sección */\n    .section-tag {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      margin-bottom: 8px;\n    }\n\n    .tag-marker {\n      width: 4px;\n      height: 18px;\n      background-color: var(--text-main);\n    }\n\n    .tag-label {\n      font-size: 1rem;\n      letter-spacing: 0.04em;\n      text-transform: uppercase;\n    }\n\n    .card-header {\n      margin-bottom: 20px;\n    }\n\n    .chart-title {\n      font-size: 1.125rem;\n      margin-top: 4px;\n    }\n\n    /* ===================================================\n       3. BOTONES Y FILTROS INTERACTIVOS\n       =================================================== */\n    .controls {\n      display: flex;\n      gap: 8px;\n      margin-bottom: 20px;\n      flex-wrap: wrap;\n    }\n\n    .btn {\n      appearance: none;\n      border: none;\n      box-shadow: none;\n      border-radius: var(--radius);\n      background-color: var(--bg-neutral);\n      color: var(--text-main);\n      padding: 8px 16px;\n      font-size: 0.85rem;\n      font-weight: 400;\n      cursor: pointer;\n      transition: filter 0.15s ease;\n    }\n\n    /* Interacción estricta: sólo oscurecimiento, sin traslación */\n    .btn:hover {\n      filter: brightness(0.92);\n    }\n\n    .btn:active {\n      filter: brightness(0.85);\n    }\n\n    .btn.active {\n      background-color: var(--primary);\n      font-weight: 700;\n    }\n\n    /* Leyenda limpia */\n    .legend {\n      display: flex;\n      align-items: center;\n      gap: 20px;\n      margin-bottom: 16px;\n      font-size: 0.85rem;\n    }\n\n    .legend-item {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n    }\n\n    .legend-color {\n      width: 12px;\n      height: 12px;\n      border-radius: 2px;\n    }\n\n    .legend-color-py {\n      background-color: var(--primary);\n      border: 1px solid var(--text-main);\n    }\n\n    .legend-color-ocde {\n      background-color: var(--bar-secondary);\n    }\n\n    /* ===================================================\n       4. ÁREA DEL GRÁFICO (SVG RESPONSIVE)\n       =================================================== */\n    .chart-wrapper {\n      position: relative;\n      width: 100%;\n    }\n\n    svg {\n      width: 100%;\n      height: auto;\n      overflow: visible;\n    }\n\n    .grid-line {\n      stroke: var(--border-color);\n      stroke-width: 1;\n    }\n\n    .axis-title {\n      font-family: 'Lato', sans-serif;\n      font-size: 11px;\n      font-weight: 300;\n      fill: #64748b;\n    }\n\n    .axis-label {\n      font-family: 'Lato', sans-serif;\n      font-size: 11px;\n      font-weight: 400;\n      fill: #475569;\n    }\n\n    .category-label {\n      font-family: 'Montserrat', sans-serif;\n      font-size: 12px;\n      font-weight: 700;\n      fill: var(--text-main);\n      text-anchor: middle;\n    }\n\n    /* Barras */\n    .bar {\n      cursor: pointer;\n      transition: filter 0.15s ease;\n    }\n\n    .bar-py {\n      fill: var(--primary);\n      stroke: var(--text-main);\n      stroke-width: 1;\n    }\n\n    .bar-ocde {\n      fill: var(--bar-secondary);\n    }\n\n    .bar:hover {\n      filter: brightness(0.88);\n    }\n\n    /* Tooltip contextual plano */\n    .tooltip {\n      position: absolute;\n      display: none;\n      pointer-events: none;\n      background-color: var(--text-main);\n      color: #ffffff;\n      padding: 6px 12px;\n      border-radius: var(--radius);\n      font-size: 0.75rem;\n      white-space: nowrap;\n      transform: translate(-50%, -120%);\n      z-index: 20;\n    }\n\n    .tooltip strong {\n      font-family: 'Montserrat', sans-serif;\n      color: var(--primary);\n      font-weight: 700;\n    }\n\n    @media (max-width: 480px) {\n      .dashboard-card {\n        padding: 16px;\n      }\n      .tag-label {\n        font-size: 0.9rem;\n      }\n      .chart-title {\n        font-size: 1rem;\n      }\n      .category-label {\n        font-size: 11px;\n      }\n    }\n  </style>\n</head>\n<body>\n\n  <div class=\"dashboard-card\">\n    <!-- Encabezado con indicador utilitario -->\n    <div class=\"section-tag\">\n      <div class=\"tag-marker\"></div>\n      <h1 class=\"tag-label\">Tecnología, IA y Pantallas</h1>\n    </div>\n\n    <div class=\"card-header\">\n      <h2 class=\"chart-title\">Uso diario de dispositivos digitales en la escuela</h2>\n    </div>\n\n    <!-- Botones de filtrado -->\n    <div class=\"controls\">\n      <button class=\"btn active\" onclick=\"applyFilter('all', this)\">Ambos usos</button>\n      <button class=\"btn\" onclick=\"applyFilter('Para aprender', this)\">Para aprender</button>\n      <button class=\"btn\" onclick=\"applyFilter('Para ocio', this)\">Para ocio</button>\n    </div>\n\n    <!-- Leyenda plana -->\n    <div class=\"legend\">\n      <div class=\"legend-item\">\n        <span class=\"legend-color legend-color-py\"></span>\n        <span>Paraguay</span>\n      </div>\n      <div class=\"legend-item\">\n        <span class=\"legend-color legend-color-ocde\"></span>\n        <span>Promedio OCDE</span>\n      </div>\n    </div>\n\n    <!-- Gráfico SVG Interactivo -->\n    <div class=\"chart-wrapper\">\n      <div id=\"tooltip\" class=\"tooltip\"></div>\n      <svg id=\"chart-svg\" viewBox=\"0 0 500 280\" preserveAspectRatio=\"xMidYMid meet\"></svg>\n    </div>\n  </div>\n\n  <script>\n    const chartData = [\n      { category: \"Para aprender\", py: 1.3, ocde: 1.7 },\n      { category: \"Para ocio\", py: 1.8, ocde: 1.1 }\n    ];\n\n    const svg = document.getElementById('chart-svg');\n    const tooltip = document.getElementById('tooltip');\n\n    const chartHeight = 200;\n    const chartWidth = 430;\n    const originX = 55;\n    const originY = 25;\n    const maxVal = 2.0;\n\n    function render(data) {\n      svg.innerHTML = '';\n\n      // Título vertical del eje Y (Horas por día)\n      const axisTitle = document.createElementNS(\"http://www.w3.org/2000/svg\", \"text\");\n      axisTitle.setAttribute(\"x\", - (originY + chartHeight / 2));\n      axisTitle.setAttribute(\"y\", 16);\n      axisTitle.setAttribute(\"transform\", \"rotate(-90)\");\n      axisTitle.setAttribute(\"text-anchor\", \"middle\");\n      axisTitle.setAttribute(\"class\", \"axis-title\");\n      axisTitle.textContent = \"Horas por día\";\n      svg.appendChild(axisTitle);\n\n      // Líneas de grilla y valores del eje Y (de 0.0 a 2.0 en pasos de 0.2)\n      const steps = 10;\n      for (let i = 0; i <= steps; i++) {\n        const val = (i * 0.2);\n        const y = originY + chartHeight - (chartHeight * (val / maxVal));\n\n        const line = document.createElementNS(\"http://www.w3.org/2000/svg\", \"line\");\n        line.setAttribute(\"x1\", originX);\n        line.setAttribute(\"y1\", y);\n        line.setAttribute(\"x2\", originX + chartWidth);\n        line.setAttribute(\"y2\", y);\n        line.setAttribute(\"class\", \"grid-line\");\n        svg.appendChild(line);\n\n        const label = document.createElementNS(\"http://www.w3.org/2000/svg\", \"text\");\n        label.setAttribute(\"x\", originX - 8);\n        label.setAttribute(\"y\", y + 4);\n        label.setAttribute(\"text-anchor\", \"end\");\n        label.setAttribute(\"class\", \"axis-label\");\n        label.textContent = val.toFixed(1).replace('.', ',');\n        svg.appendChild(label);\n      }\n\n      // Cálculo de barras\n      const slotWidth = chartWidth / data.length;\n      const barWidth = Math.min(42, slotWidth * 0.24);\n      const barGap = 6;\n\n      data.forEach((d, idx) => {\n        const centerX = originX + (slotWidth * idx) + (slotWidth / 2);\n\n        // Barra Paraguay\n        const pyH = chartHeight * (d.py / maxVal);\n        const pyY = originY + chartHeight - pyH;\n        const pyX = centerX - barWidth - (barGap / 2);\n\n        const rectPy = document.createElementNS(\"http://www.w3.org/2000/svg\", \"rect\");\n        rectPy.setAttribute(\"x\", pyX);\n        rectPy.setAttribute(\"y\", pyY);\n        rectPy.setAttribute(\"width\", barWidth);\n        rectPy.setAttribute(\"height\", pyH);\n        rectPy.setAttribute(\"rx\", \"2\");\n        rectPy.setAttribute(\"class\", \"bar bar-py\");\n        attachTooltip(rectPy, `<strong>Paraguay:</strong> ${d.py} h/día (${d.category})`);\n        svg.appendChild(rectPy);\n\n        // Barra OCDE\n        const ocdeH = chartHeight * (d.ocde / maxVal);\n        const ocdeY = originY + chartHeight - ocdeH;\n        const ocdeX = centerX + (barGap / 2);\n\n        const rectOcde = document.createElementNS(\"http://www.w3.org/2000/svg\", \"rect\");\n        rectOcde.setAttribute(\"x\", ocdeX);\n        rectOcde.setAttribute(\"y\", ocdeY);\n        rectOcde.setAttribute(\"width\", barWidth);\n        rectOcde.setAttribute(\"height\", ocdeH);\n        rectOcde.setAttribute(\"rx\", \"2\");\n        rectOcde.setAttribute(\"class\", \"bar bar-ocde\");\n        attachTooltip(rectOcde, `<strong>Promedio OCDE:</strong> ${d.ocde} h/día (${d.category})`);\n        svg.appendChild(rectOcde);\n\n        // Etiqueta Eje X\n        const labelCategory = document.createElementNS(\"http://www.w3.org/2000/svg\", \"text\");\n        labelCategory.setAttribute(\"x\", centerX);\n        labelCategory.setAttribute(\"y\", originY + chartHeight + 24);\n        labelCategory.setAttribute(\"class\", \"category-label\");\n        labelCategory.textContent = d.category;\n        svg.appendChild(labelCategory);\n      });\n    }\n\n    function attachTooltip(element, content) {\n      element.addEventListener('mouseenter', () => {\n        tooltip.innerHTML = content;\n        tooltip.style.display = 'block';\n      });\n\n      element.addEventListener('mousemove', (e) => {\n        const rect = svg.getBoundingClientRect();\n        tooltip.style.left = (e.clientX - rect.left) + 'px';\n        tooltip.style.top = (e.clientY - rect.top) + 'px';\n      });\n\n      element.addEventListener('mouseleave', () => {\n        tooltip.style.display = 'none';\n      });\n    }\n\n    function applyFilter(category, button) {\n      document.querySelectorAll('.controls .btn').forEach(btn => btn.classList.remove('active'));\n      button.classList.add('active');\n\n      if (category === 'all') {\n        render(chartData);\n      } else {\n        render(chartData.filter(item => item.category === category));\n      }\n    }\n\n    // Inicialización\n    render(chartData);\n  <\/script>\n</body>\n</html>","type":"raw_html"},{"_id":"F7S56FS2ZNEHZIAWW2AALFHIWY","content":"Lea más: <a href=\"https://www.abc.com.py/internacionales/2026/09/08/los-resultados-de-pisa-son-peores-cuanto-mas-tiempo-se-pasa-con-pantallas-para-divertirse/\" target=\"_blank\" rel=\"noreferrer\" title=\"https://www.abc.com.py/internacionales/2026/09/08/los-resultados-de-pisa-son-peores-cuanto-mas-tiempo-se-pasa-con-pantallas-para-divertirse/\">Los resultados de PISA son peores cuanto más tiempo se pasa con pantallas para divertirse</a>","type":"text"},{"_id":"GSZXVKM5ORAHTLJGXDLCNRLGWI","content":"El informe analiza también el uso de <b>inteligencia artificial</b> (IA) en los colegios y reporta que en Paraguay un 45 por ciento de los estudiantes evaluados dijeron utilizar ‘chatbots’ como apoyo en sus estudios al menos una vez por semana.","type":"text"},{"_id":"2WDKZRP3KNGWPBJQORCLCP6UBI","content":"Los estudiantes afirmaron utilizar IA para investigación, para resumir textos que debían leer o para la redacción de textos.","type":"text"},{"_id":"SKSZMFQKB5F37EWZT3LREDDNBM","content":"Solo un 10 por ciento de los estudiantes dijo no utilizar herramientas de IA. ","type":"text"},{"_id":"TCMEBYTXPRBZFAVD3GISYEXMJM","content":"El impacto del ‘bullying’","level":2,"type":"header"},{"_id":"2LPULYDMLZCMVBDYUHVHL3I2UI","content":"El informe PISA hace también hincapié en la incidencia del ‘bullying’ en la educación y señala que, según los datos recabados, un <b>28 por ciento de los estudiantes evaluados</b> en Paraguay dijeron haber sido víctimas al menos una vez por mes.","type":"text"},{"_id":"6NDVN3DYAVALNLNVYBMUR6W4BI","content":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Acoso escolar (bullying) - Gráfico Interactivo</title>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Lato:wght@300;400&family=Montserrat:wght@700&display=swap\" rel=\"stylesheet\">\n\n  <style>\n    /* ===================================================\n       1. VARIABLES & DESIGN SYSTEM\n       =================================================== */\n    :root {\n      --primary: #ffe500;\n      --text-main: #000000;\n      --border-color: #e2e8f0;\n      --bg-neutral: #f8fafc;\n      --bar-secondary: #94a3b8;\n      --radius: 10px; /* Rango: 8px - 12px */\n    }\n\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n\n    body {\n      font-family: 'Lato', sans-serif;\n      font-weight: 400;\n      color: var(--text-main);\n      background-color: #ffffff;\n      padding: 32px 16px;\n      display: flex;\n      justify-content: center;\n    }\n\n    /* Tipografías estrictas */\n    h1, h2, h3, h4 {\n      font-family: 'Montserrat', sans-serif;\n      font-weight: 700;\n      color: var(--text-main);\n      line-height: 1.25;\n    }\n\n    p, span, button, text {\n      font-family: 'Lato', sans-serif;\n      color: var(--text-main);\n    }\n\n    /* ===================================================\n       2. CONTENEDOR DE TARJETA\n       =================================================== */\n    .chart-card {\n      width: 100%;\n      max-width: 640px;\n      border: 1px solid var(--border-color);\n      border-radius: var(--radius);\n      padding: 24px;\n      background-color: #ffffff;\n    }\n\n    .card-header {\n      margin-bottom: 20px;\n    }\n\n    .chart-title {\n      font-size: 1.25rem;\n      letter-spacing: -0.01em;\n    }\n\n    /* ===================================================\n       3. BOTONES Y CONTROLES (PLANOS, SIN SOMBRAS)\n       =================================================== */\n    .controls {\n      display: flex;\n      gap: 8px;\n      margin-bottom: 20px;\n      flex-wrap: wrap;\n    }\n\n    .btn {\n      appearance: none;\n      border: none;\n      box-shadow: none;\n      border-radius: var(--radius);\n      background-color: var(--bg-neutral);\n      color: var(--text-main);\n      padding: 8px 16px;\n      font-size: 0.85rem;\n      font-weight: 400;\n      cursor: pointer;\n      transition: filter 0.15s ease;\n    }\n\n    /* Interacción hover: oscurecimiento sutil, sin traslación */\n    .btn:hover {\n      filter: brightness(0.92);\n    }\n\n    .btn:active {\n      filter: brightness(0.85);\n    }\n\n    .btn.active {\n      background-color: var(--primary);\n      font-weight: 700;\n    }\n\n    /* ===================================================\n       4. LEYENDA\n       =================================================== */\n    .legend {\n      display: flex;\n      align-items: center;\n      gap: 20px;\n      margin-bottom: 20px;\n      font-size: 0.85rem;\n    }\n\n    .legend-item {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n    }\n\n    .legend-indicator {\n      width: 12px;\n      height: 12px;\n      border-radius: 2px;\n    }\n\n    .indicator-py {\n      background-color: var(--primary);\n      border: 1px solid var(--text-main);\n    }\n\n    .indicator-ocde {\n      background-color: var(--bar-secondary);\n    }\n\n    /* ===================================================\n       5. GRÁFICO SVG RESPONSIVE\n       =================================================== */\n    .chart-wrapper {\n      position: relative;\n      width: 100%;\n    }\n\n    svg {\n      width: 100%;\n      height: auto;\n      overflow: visible;\n    }\n\n    .grid-line {\n      stroke: var(--border-color);\n      stroke-width: 1;\n    }\n\n    .axis-label {\n      font-size: 11px;\n      fill: #64748b;\n      font-weight: 400;\n    }\n\n    .category-label {\n      font-size: 12px;\n      font-weight: 400;\n      fill: var(--text-main);\n    }\n\n    /* Barras Horizontales */\n    .bar {\n      cursor: pointer;\n      transition: filter 0.15s ease;\n    }\n\n    .bar-py {\n      fill: var(--primary);\n      stroke: var(--text-main);\n      stroke-width: 1;\n    }\n\n    .bar-ocde {\n      fill: var(--bar-secondary);\n    }\n\n    .bar:hover {\n      filter: brightness(0.88);\n    }\n\n    /* Tooltip contextual plano */\n    .tooltip {\n      position: absolute;\n      display: none;\n      pointer-events: none;\n      background-color: var(--text-main);\n      color: #ffffff;\n      padding: 6px 12px;\n      border-radius: var(--radius);\n      font-size: 0.75rem;\n      white-space: nowrap;\n      transform: translate(-50%, -120%);\n      z-index: 20;\n    }\n\n    .tooltip strong {\n      font-family: 'Montserrat', sans-serif;\n      color: var(--primary);\n      font-weight: 700;\n    }\n\n    @media (max-width: 520px) {\n      .chart-card {\n        padding: 16px;\n      }\n      .chart-title {\n        font-size: 1.1rem;\n      }\n      .category-label {\n        font-size: 10px;\n      }\n    }\n  </style>\n</head>\n<body>\n\n  <div class=\"chart-card\">\n    <div class=\"card-header\">\n      <h2 class=\"chart-title\">Acoso escolar (bullying)</h2>\n    </div>\n\n    <!-- Controles utilitarios -->\n    <div class=\"controls\">\n      <button class=\"btn active\" onclick=\"filterSeries('all', this)\">Comparativa general</button>\n      <button class=\"btn\" onclick=\"filterSeries('py', this)\">Solo Paraguay</button>\n      <button class=\"btn\" onclick=\"filterSeries('ocde', this)\">Solo Promedio OCDE</button>\n    </div>\n\n    <!-- Leyenda -->\n    <div class=\"legend\">\n      <div class=\"legend-item\">\n        <span class=\"legend-indicator indicator-py\"></span>\n        <span>Paraguay</span>\n      </div>\n      <div class=\"legend-item\">\n        <span class=\"legend-indicator indicator-ocde\"></span>\n        <span>Promedio OCDE</span>\n      </div>\n    </div>\n\n    <!-- Contenedor del gráfico -->\n    <div class=\"chart-wrapper\">\n      <div id=\"chart-tooltip\" class=\"tooltip\"></div>\n      <svg id=\"chart-svg\" viewBox=\"0 0 560 180\" preserveAspectRatio=\"xMidYMid meet\"></svg>\n    </div>\n  </div>\n\n  <script>\n    const metricData = {\n      label: \"Víctima de acoso (varias veces al mes)\",\n      py: 28,\n      ocde: 20\n    };\n\n    const svg = document.getElementById('chart-svg');\n    const tooltip = document.getElementById('chart-tooltip');\n\n    const originX = 195;\n    const originY = 15;\n    const chartWidth = 340;\n    const chartHeight = 110;\n    const maxVal = 40; // Rango eje X: 0% a 40%\n\n    function render(seriesMode) {\n      svg.innerHTML = '';\n\n      // Líneas verticales auxiliares (0%, 10%, 20%, 30%, 40%)\n      const steps = 4;\n      for (let i = 0; i <= steps; i++) {\n        const val = i * 10;\n        const x = originX + (chartWidth * (val / maxVal));\n\n        const line = document.createElementNS(\"http://www.w3.org/2000/svg\", \"line\");\n        line.setAttribute(\"x1\", x);\n        line.setAttribute(\"y1\", originY);\n        line.setAttribute(\"x2\", x);\n        line.setAttribute(\"y2\", originY + chartHeight);\n        line.setAttribute(\"class\", \"grid-line\");\n        svg.appendChild(line);\n\n        const label = document.createElementNS(\"http://www.w3.org/2000/svg\", \"text\");\n        label.setAttribute(\"x\", x);\n        label.setAttribute(\"y\", originY + chartHeight + 18);\n        label.setAttribute(\"text-anchor\", \"middle\");\n        label.setAttribute(\"class\", \"axis-label\");\n        label.textContent = val + \"%\";\n        svg.appendChild(label);\n      }\n\n      // Etiqueta del eje Y\n      const catLabel = document.createElementNS(\"http://www.w3.org/2000/svg\", \"text\");\n      catLabel.setAttribute(\"x\", originX - 12);\n      catLabel.setAttribute(\"y\", originY + (chartHeight / 2) + 4);\n      catLabel.setAttribute(\"text-anchor\", \"end\");\n      catLabel.setAttribute(\"class\", \"category-label\");\n      catLabel.textContent = metricData.label;\n      svg.appendChild(catLabel);\n\n      // Barras horizontales\n      const barHeight = 28;\n      const pyY = originY + 16;\n      const ocdeY = originY + 58;\n\n      if (seriesMode === 'all' || seriesMode === 'py') {\n        const pyWidth = chartWidth * (metricData.py / maxVal);\n        const rectPy = document.createElementNS(\"http://www.w3.org/2000/svg\", \"rect\");\n        rectPy.setAttribute(\"x\", originX);\n        rectPy.setAttribute(\"y\", pyY);\n        rectPy.setAttribute(\"width\", pyWidth);\n        rectPy.setAttribute(\"height\", barHeight);\n        rectPy.setAttribute(\"rx\", \"2\");\n        rectPy.setAttribute(\"class\", \"bar bar-py\");\n        attachTooltip(rectPy, `<strong>Paraguay:</strong> ${metricData.py}%`);\n        svg.appendChild(rectPy);\n      }\n\n      if (seriesMode === 'all' || seriesMode === 'ocde') {\n        const ocdeWidth = chartWidth * (metricData.ocde / maxVal);\n        const rectOcde = document.createElementNS(\"http://www.w3.org/2000/svg\", \"rect\");\n        rectOcde.setAttribute(\"x\", originX);\n        rectOcde.setAttribute(\"y\", ocdeY);\n        rectOcde.setAttribute(\"width\", ocdeWidth);\n        rectOcde.setAttribute(\"height\", barHeight);\n        rectOcde.setAttribute(\"rx\", \"2\");\n        rectOcde.setAttribute(\"class\", \"bar bar-ocde\");\n        attachTooltip(rectOcde, `<strong>Promedio OCDE:</strong> ${metricData.ocde}%`);\n        svg.appendChild(rectOcde);\n      }\n    }\n\n    function attachTooltip(element, content) {\n      element.addEventListener('mouseenter', () => {\n        tooltip.innerHTML = content;\n        tooltip.style.display = 'block';\n      });\n\n      element.addEventListener('mousemove', (e) => {\n        const rect = svg.getBoundingClientRect();\n        tooltip.style.left = (e.clientX - rect.left) + 'px';\n        tooltip.style.top = (e.clientY - rect.top) + 'px';\n      });\n\n      element.addEventListener('mouseleave', () => {\n        tooltip.style.display = 'none';\n      });\n    }\n\n    function filterSeries(mode, btn) {\n      document.querySelectorAll('.controls .btn').forEach(b => b.classList.remove('active'));\n      btn.classList.add('active');\n      render(mode);\n    }\n\n    // Inicialización por defecto\n    render('all');\n  <\/script>\n</body>\n</html>","type":"raw_html"},{"_id":"JL3GJ5S7ZNCIHLQJ43KE4ULKRA","content":"La incidencia del <b>‘ciberbullying’</b> en Paraguay es menor, pero sí se reportaron casos en un 5 por ciento de los alumnos examinados, los cuales tuvieron en promedio resultados mucho más bajos que los demás. ","type":"text"},{"_id":"UJJKO5I3PFEPJEEVIKUBGFSWLE","content":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Resultados PISA 2025 - Ciencias</title>\n\n  <!-- Google Fonts: Montserrat (700) & Lato (300, 400) -->\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Lato:wght@300;400&family=Montserrat:wght@700&display=swap\" rel=\"stylesheet\">\n\n  <style>\n    :root {\n      --color-primary: #ffe500;\n      --color-primary-hover: #ebd300;\n      --color-text: #000000;\n      --color-border: #e2e8f0;\n      --color-bg: #ffffff;\n      --color-bg-hover: #f8fafc;\n      --color-global: #1d70b8;\n      --color-latam: #d4351c;\n      --radius-sm: 8px;\n      --radius-md: 10px;\n      --radius-lg: 12px;\n      --font-heading: 'Montserrat', sans-serif;\n      --font-body: 'Lato', sans-serif;\n    }\n\n    *, *::before, *::after {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n\n    body {\n      background-color: #f1f5f9;\n      color: var(--color-text);\n      font-family: var(--font-body);\n      font-weight: 400;\n      line-height: 1.5;\n      padding: 32px 16px;\n      display: flex;\n      justify-content: center;\n    }\n\n    /* Contenedor Principal / Tarjeta */\n    .card {\n      background: var(--color-bg);\n      border: 1px solid var(--color-border);\n      border-radius: var(--radius-lg);\n      width: 100%;\n      max-width: 860px;\n      padding: 32px;\n    }\n\n    /* Tipografía */\n    h1, h2, h3, h4 {\n      font-family: var(--font-heading);\n      font-weight: 700;\n      color: var(--color-text);\n    }\n\n    .card-header h1 {\n      font-size: 24px;\n      letter-spacing: -0.02em;\n      margin-bottom: 6px;\n    }\n\n    .card-header p {\n      font-size: 15px;\n      font-weight: 300;\n      color: var(--color-text);\n      margin-bottom: 24px;\n    }\n\n    /* Panel de Control Interactivo (Filtros y Búsqueda) */\n    .controls-panel {\n      display: flex;\n      flex-wrap: wrap;\n      align-items: center;\n      justify-content: space-between;\n      gap: 16px;\n      padding-bottom: 20px;\n      margin-bottom: 24px;\n      border-bottom: 1px solid var(--color-border);\n    }\n\n    .search-box {\n      flex: 1;\n      min-width: 220px;\n    }\n\n    .search-input {\n      width: 100%;\n      font-family: var(--font-body);\n      font-size: 14px;\n      font-weight: 400;\n      color: var(--color-text);\n      padding: 10px 14px;\n      border: 1px solid var(--color-border);\n      border-radius: var(--radius-sm);\n      outline: none;\n      background-color: #ffffff;\n      transition: border-color 0.15s ease;\n    }\n\n    .search-input:focus {\n      border-color: #000000;\n    }\n\n    .filters-group {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 8px;\n    }\n\n    /* Botones de Control Utilitarios */\n    .btn-filter, .btn-sort {\n      font-family: var(--font-heading);\n      font-weight: 700;\n      font-size: 12px;\n      text-transform: uppercase;\n      letter-spacing: 0.04em;\n      padding: 10px 14px;\n      border: none;\n      border-radius: var(--radius-sm);\n      background-color: #f1f5f9;\n      color: var(--color-text);\n      cursor: pointer;\n      transition: background-color 0.15s ease;\n    }\n\n    .btn-filter:hover, .btn-sort:hover {\n      background-color: #e2e8f0;\n    }\n\n    /* Botón Activo usando el color primario estricto */\n    .btn-filter.active {\n      background-color: var(--color-primary);\n    }\n\n    .btn-filter.active:hover {\n      background-color: var(--color-primary-hover);\n    }\n\n    /* Leyenda e Indicadores */\n    .legend-bar {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      font-size: 13px;\n      margin-bottom: 12px;\n    }\n\n    .legend-items {\n      display: flex;\n      gap: 20px;\n    }\n\n    .legend-tag {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n    }\n\n    .legend-circle {\n      width: 10px;\n      height: 10px;\n      border-radius: 50%;\n    }\n\n    .circle-global { background-color: var(--color-global); }\n    .circle-latam { background-color: var(--color-latam); }\n\n    /* Escala Superior */\n    .scale-row {\n      display: grid;\n      grid-template-columns: 200px repeat(6, 1fr);\n      padding: 10px 0;\n      border-top: 1px solid var(--color-border);\n      border-bottom: 1px solid var(--color-border);\n      font-size: 12px;\n      font-weight: 300;\n      color: #64748b;\n      text-align: center;\n    }\n\n    .scale-row span:first-child {\n      text-align: left;\n    }\n\n    /* Grilla y Contenedor de Datos */\n    .chart-body {\n      position: relative;\n      margin-top: 8px;\n    }\n\n    /* Línea de Promedio OCDE (482 pts) -> ((482 - 350) / 250) * 100 = 52.8% */\n    .ocde-benchmark {\n      position: absolute;\n      left: calc(200px + (100% - 200px) * 0.528);\n      top: 0;\n      bottom: 0;\n      width: 1px;\n      border-left: 1px dashed #94a3b8;\n      z-index: 1;\n      pointer-events: none;\n    }\n\n    .ocde-tag {\n      position: absolute;\n      top: 4px;\n      right: 10px;\n      text-align: right;\n      font-size: 11px;\n      font-family: var(--font-heading);\n      font-weight: 700;\n      line-height: 1.2;\n      background: rgba(255, 255, 255, 0.9);\n      padding: 2px 4px;\n      border-radius: var(--radius-sm);\n    }\n\n    .ocde-tag span {\n      display: block;\n      font-family: var(--font-body);\n      font-weight: 400;\n      font-size: 10px;\n    }\n\n    /* Filas Interactivas */\n    .data-row {\n      display: flex;\n      align-items: center;\n      height: 32px;\n      position: relative;\n      cursor: pointer;\n      border-radius: var(--radius-sm);\n      transition: background-color 0.15s ease;\n    }\n\n    .data-row:hover {\n      background-color: var(--color-bg-hover);\n    }\n\n    .data-row.selected {\n      background-color: #fff9db;\n    }\n\n    .country-label {\n      width: 200px;\n      font-size: 13px;\n      padding-left: 6px;\n      padding-right: 12px;\n      white-space: nowrap;\n      overflow: hidden;\n      text-overflow: ellipsis;\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n    }\n\n    .country-label.ocde-member {\n      font-family: var(--font-heading);\n      font-weight: 700;\n    }\n\n    .row-value {\n      font-family: var(--font-body);\n      font-weight: 400;\n      font-size: 12px;\n      color: #64748b;\n    }\n\n    .plot-track {\n      flex: 1;\n      height: 100%;\n      position: relative;\n      border-left: 1px solid var(--color-border);\n    }\n\n    /* Grilla de fondo */\n    .grid-lines {\n      position: absolute;\n      inset: 0;\n      display: grid;\n      grid-template-columns: repeat(5, 1fr);\n      pointer-events: none;\n    }\n\n    .grid-lines span {\n      border-right: 1px solid #f8fafc;\n      height: 100%;\n    }\n\n    /* Marcador de Punto */\n    .dot {\n      position: absolute;\n      top: 50%;\n      width: 10px;\n      height: 10px;\n      border-radius: 50%;\n      transform: translate(-50%, -50%);\n      z-index: 2;\n      transition: width 0.1s ease, height 0.1s ease;\n    }\n\n    .dot.global { background-color: var(--color-global); }\n    .dot.latam { background-color: var(--color-latam); }\n\n    .data-row:hover .dot,\n    .data-row.selected .dot {\n      width: 14px;\n      height: 14px;\n    }\n\n    /* Mensaje sin resultados */\n    .no-results {\n      padding: 32px 0;\n      text-align: center;\n      font-size: 14px;\n      font-weight: 300;\n      color: #64748b;\n      display: none;\n    }\n\n    /* Pie de Tarjeta */\n    .card-footer {\n      margin-top: 24px;\n      padding-top: 16px;\n      border-top: 1px solid var(--color-border);\n      font-size: 12px;\n      font-weight: 300;\n      color: #334155;\n      line-height: 1.6;\n    }\n\n    .card-footer strong {\n      font-weight: 700;\n      color: var(--color-text);\n    }\n\n    @media (max-width: 640px) {\n      .card { padding: 20px 16px; }\n      .country-label { width: 140px; font-size: 12px; }\n      .scale-row { grid-template-columns: 140px repeat(6, 1fr); font-size: 10px; }\n      .ocde-benchmark { left: calc(140px + (100% - 140px) * 0.528); }\n      .controls-panel { flex-direction: column; align-items: stretch; }\n      .filters-group { justify-content: flex-start; }\n    }\n  </style>\n</head>\n<body>\n\n  <main class=\"card\">\n    <header class=\"card-header\">\n      <h1>Resultados de prueba PISA 2025 en Ciencias</h1>\n      <p>Puntuación media de los países y economías seleccionadas</p>\n    </header>\n\n    <!-- Barra de Controles Interactivos -->\n    <div class=\"controls-panel\">\n      <div class=\"search-box\">\n        <input \n          type=\"text\" \n          id=\"searchInput\" \n          class=\"search-input\" \n          placeholder=\"Buscar país o economía...\" \n          aria-label=\"Buscar país\">\n      </div>\n      \n      <div class=\"filters-group\">\n        <button class=\"btn-filter active\" data-filter=\"all\">Todos</button>\n        <button class=\"btn-filter\" data-filter=\"latam\">Latinoamérica</button>\n        <button class=\"btn-filter\" data-filter=\"global\">Global</button>\n        <button class=\"btn-filter\" data-filter=\"ocde\">OCDE</button>\n        <button class=\"btn-sort\" id=\"sortToggle\">Ordenar: Puntaje ▼</button>\n      </div>\n    </div>\n\n    <!-- Leyenda -->\n    <div class=\"legend-bar\">\n      <div class=\"legend-items\">\n        <span class=\"legend-tag\">\n          <span class=\"legend-circle circle-global\"></span> Referencia global\n        </span>\n        <span class=\"legend-tag\">\n          <span class=\"legend-circle circle-latam\"></span> Latinoamérica\n        </span>\n      </div>\n      <div id=\"counter\" style=\"font-size: 12px; color: #64748b;\">19 países</div>\n    </div>\n\n    <!-- Gráfico / Tabla interactiva -->\n    <section class=\"chart-container\">\n      <div class=\"scale-row\">\n        <span>Economía</span>\n        <span>350</span>\n        <span>400</span>\n        <span>450</span>\n        <span>500</span>\n        <span>550</span>\n        <span>600</span>\n      </div>\n\n      <div class=\"chart-body\" id=\"chartBody\">\n        <!-- Promedio OCDE Referencial -->\n        <div class=\"ocde-benchmark\">\n          <div class=\"ocde-tag\">\n            Promedio OCDE\n            <span>482 puntos</span>\n          </div>\n        </div>\n\n        <div id=\"rowsContainer\"></div>\n        <div id=\"noResults\" class=\"no-results\">No se encontraron resultados para los filtros seleccionados.</div>\n      </div>\n    </section>\n\n    <footer class=\"card-footer\">\n      <p><strong>* País miembro de la OCDE</strong></p>\n      <p>B-S-J-Z (China) comprende Beijing, Shanghai, Jiangsu y Zhejiang.</p>\n    </footer>\n  </main>\n\n  <script>\n    // Dataset estructurado\n    const dataset = [\n      { name: \"B-S-J-Z (China)\", score: 590, type: \"global\", ocde: false },\n      { name: \"Singapur\", score: 561, type: \"global\", ocde: false },\n      { name: \"Macao (China)\", score: 544, type: \"global\", ocde: false },\n      { name: \"Taipéi Chino\", score: 542, type: \"global\", ocde: false },\n      { name: \"Japón*\", score: 539, type: \"global\", ocde: true },\n      { name: \"Estados Unidos*\", score: 502, type: \"global\", ocde: true },\n      { name: \"Uruguay\", score: 461, type: \"latam\", ocde: false },\n      { name: \"Chile*\", score: 455, type: \"latam\", ocde: true },\n      { name: \"Costa Rica*\", score: 436, type: \"latam\", ocde: true },\n      { name: \"Colombia*\", score: 420, type: \"latam\", ocde: true },\n      { name: \"México*\", score: 419, type: \"latam\", ocde: true },\n      { name: \"Brasil\", score: 410, type: \"latam\", ocde: false },\n      { name: \"Perú\", score: 404, type: \"latam\", ocde: false },\n      { name: \"Ecuador\", score: 393, type: \"latam\", ocde: false },\n      { name: \"Argentina\", score: 392, type: \"latam\", ocde: false },\n      { name: \"El Salvador\", score: 380, type: \"latam\", ocde: false },\n      { name: \"República Dominicana\", score: 366, type: \"latam\", ocde: false },\n      { name: \"Paraguay\", score: 360, type: \"latam\", ocde: false },\n      { name: \"Guatemala\", score: 357, type: \"latam\", ocde: false }\n    ];\n\n    const minScale = 350;\n    const maxScale = 600;\n\n    // Estado interactivo\n    let currentFilter = 'all';\n    let searchQuery = '';\n    let sortMode = 'desc'; // 'desc' | 'asc' | 'alpha'\n\n    const rowsContainer = document.getElementById('rowsContainer');\n    const searchInput = document.getElementById('searchInput');\n    const filterButtons = document.querySelectorAll('.btn-filter');\n    const sortToggle = document.getElementById('sortToggle');\n    const counterDisplay = document.getElementById('counter');\n    const noResults = document.getElementById('noResults');\n\n    function renderRows() {\n      // 1. Filtrado\n      let filtered = dataset.filter(item => {\n        const matchesFilter = \n          currentFilter === 'all' ? true :\n          currentFilter === 'latam' ? item.type === 'latam' :\n          currentFilter === 'global' ? item.type === 'global' :\n          currentFilter === 'ocde' ? item.ocde === true : true;\n\n        const matchesSearch = item.name.toLowerCase().includes(searchQuery.toLowerCase());\n        return matchesFilter && matchesSearch;\n      });\n\n      // 2. Ordenamiento\n      if (sortMode === 'desc') {\n        filtered.sort((a, b) => b.score - a.score);\n      } else if (sortMode === 'asc') {\n        filtered.sort((a, b) => a.score - b.score);\n      } else if (sortMode === 'alpha') {\n        filtered.sort((a, b) => a.name.localeCompare(b.name));\n      }\n\n      // 3. Render en DOM\n      rowsContainer.innerHTML = '';\n      counterDisplay.textContent = `${filtered.length} ${filtered.length === 1 ? 'país' : 'países'}`;\n\n      if (filtered.length === 0) {\n        noResults.style.display = 'block';\n        return;\n      } else {\n        noResults.style.display = 'none';\n      }\n\n      filtered.forEach(item => {\n        // Cálculo del porcentaje de posición relativo al rango [350 - 600]\n        const percentage = ((item.score - minScale) / (maxScale - minScale)) * 100;\n\n        const row = document.createElement('div');\n        row.className = 'data-row';\n        row.tabIndex = 0;\n        row.setAttribute('role', 'button');\n        row.setAttribute('aria-label', `${item.name}: ${item.score} puntos`);\n\n        row.innerHTML = `\n          <span class=\"country-label ${item.ocde ? 'ocde-member' : ''}\">\n            <span>${item.name}</span>\n            <span class=\"row-value\">${item.score}</span>\n          </span>\n          <div class=\"plot-track\">\n            <div class=\"grid-lines\"><span></span><span></span><span></span><span></span><span></span></div>\n            <span class=\"dot ${item.type}\" style=\"left: ${percentage}%;\"></span>\n          </div>\n        `;\n\n        // Interacción por selección manual\n        row.addEventListener('click', () => {\n          document.querySelectorAll('.data-row').forEach(r => r.classList.remove('selected'));\n          row.classList.add('selected');\n        });\n\n        rowsContainer.appendChild(row);\n      });\n    }\n\n    // Escuchadores de eventos\n    searchInput.addEventListener('input', (e) => {\n      searchQuery = e.target.value.trim();\n      renderRows();\n    });\n\n    filterButtons.forEach(btn => {\n      btn.addEventListener('click', () => {\n        filterButtons.forEach(b => b.classList.remove('active'));\n        btn.classList.add('active');\n        currentFilter = btn.getAttribute('data-filter');\n        renderRows();\n      });\n    });\n\n    sortToggle.addEventListener('click', () => {\n      if (sortMode === 'desc') {\n        sortMode = 'asc';\n        sortToggle.textContent = 'Ordenar: Puntaje ▲';\n      } else if (sortMode === 'asc') {\n        sortMode = 'alpha';\n        sortToggle.textContent = 'Ordenar: Nombre (A-Z)';\n      } else {\n        sortMode = 'desc';\n        sortToggle.textContent = 'Ordenar: Puntaje ▼';\n      }\n      renderRows();\n    });\n\n    // Renderizado inicial\n    renderRows();\n  <\/script>\n\n</body>\n</html>","type":"raw_html"}],"credits":{"by":[{"image":{"url":""},"name":"Kike Sosa, ABC Color","slug":"kike-sosa"}]},"description":{"basic":""},"display_date":"2026-09-08T11:49:25.599Z","headlines":{"basic":"Informe PISA: nuevo retroceso de Paraguay en el rendimiento escolar"},"promo_items":{"basic":{"caption":"Unos 6.500 estudiantes fueron evaluados en Paraguay.","credits":{"by":[{"name":"Ministerio de Educación y Ciencias de la República del Paraguay"}]},"resized_urls":{"1080x1270":"https://www.abc.com.py/resizer/v2/A6H3V5MPXVA2DBZN5DEBLDRPXM.jpg?auth=8a6048f82ff56dfd937c03b186ce9eaf3a1ed6e3df6fa9efe1b06c3dc1f59708&width=1080&height=1270&smart=true","110x70":"https://www.abc.com.py/resizer/v2/A6H3V5MPXVA2DBZN5DEBLDRPXM.jpg?auth=8a6048f82ff56dfd937c03b186ce9eaf3a1ed6e3df6fa9efe1b06c3dc1f59708&width=110&height=70&smart=true","1140x663":"https://www.abc.com.py/resizer/v2/A6H3V5MPXVA2DBZN5DEBLDRPXM.jpg?auth=8a6048f82ff56dfd937c03b186ce9eaf3a1ed6e3df6fa9efe1b06c3dc1f59708&width=1140&height=663&smart=true","115x115":"https://www.abc.com.py/resizer/v2/A6H3V5MPXVA2DBZN5DEBLDRPXM.jpg?auth=8a6048f82ff56dfd937c03b186ce9eaf3a1ed6e3df6fa9efe1b06c3dc1f59708&width=115&height=115&smart=true","1200x1080":"https://www.abc.com.py/resizer/v2/A6H3V5MPXVA2DBZN5DEBLDRPXM.jpg?auth=8a6048f82ff56dfd937c03b186ce9eaf3a1ed6e3df6fa9efe1b06c3dc1f59708&width=1200&smart=true","1280x720":"https://www.abc.com.py/resizer/v2/A6H3V5MPXVA2DBZN5DEBLDRPXM.jpg?auth=8a6048f82ff56dfd937c03b186ce9eaf3a1ed6e3df6fa9efe1b06c3dc1f59708&width=1280&height=720&smart=true","1300x900":"https://www.abc.com.py/resizer/v2/A6H3V5MPXVA2DBZN5DEBLDRPXM.jpg?auth=8a6048f82ff56dfd937c03b186ce9eaf3a1ed6e3df6fa9efe1b06c3dc1f59708&width=1300&height=900&smart=true","140x191":"https://www.abc.com.py/resizer/v2/A6H3V5MPXVA2DBZN5DEBLDRPXM.jpg?auth=8a6048f82ff56dfd937c03b186ce9eaf3a1ed6e3df6fa9efe1b06c3dc1f59708&width=140&height=191&smart=true","155x87":"https://www.abc.com.py/resizer/v2/A6H3V5MPXVA2DBZN5DEBLDRPXM.jpg?auth=8a6048f82ff56dfd937c03b186ce9eaf3a1ed6e3df6fa9efe1b06c3dc1f59708&width=155&smart=true","170x110":"https://www.abc.com.py/resizer/v2/A6H3V5MPXVA2DBZN5DEBLDRPXM.jpg?auth=8a6048f82ff56dfd937c03b186ce9eaf3a1ed6e3df6fa9efe1b06c3dc1f59708&width=170&height=110&smart=true","170x170":"https://www.abc.com.py/resizer/v2/A6H3V5MPXVA2DBZN5D