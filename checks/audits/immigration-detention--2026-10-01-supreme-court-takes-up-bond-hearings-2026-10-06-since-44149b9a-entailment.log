"/contacto/"}],"name":"ABC Color","node_type":"section","_id":"/"},"expires":1788901739640,"lastModified":1788901439566}},"logo-api":{"{}":{"data":[],"expires":1788901539642,"lastModified":1788901239601}},"most-read-content-api":{"undefined":{"data":[{"_id":"BY7J6IASSRA6RIRFNTZ4AS4GWI","canonical_url":"/politica/2026/09/08/quiebre-entre-pena-y-cartes-reunion-en-casa-de-hc-y-ofensiva-sobre-ueno-alimentan-rumores/","content_elements":[{"_id":"BQDBETMB5FADFJPOGQWS74Z2F4","content":"La reunión entre <b>Horacio Cartes </b>y figuras consideradas parte del “primer anillo” del cartismo volvió a instalar interrogantes sobre la relación política entre el expresidente y el mandatario <a href=\"https://www.abc.com.py/tag/santiago-pena/\" target=\"_blank\" rel=\"noreferrer\" title=\"https://www.abc.com.py/tag/santiago-pena/\"><b>Santiago Peña</b></a>. ","type":"text"},{"_id":"SZHZT6WI5ZBF3DAB5X73DENP3Y","content":"El encuentro se produjo ayer, apenas horas después de que senadores oficialistas presentaran un pedido de informes al Banco Central del Paraguay (BCP) sobre Ueno Bank, entidad que fue vinculada al actual jefe de Estado hasta marzo de 2025.","type":"text"},{"_id":"GVO7HYEIMNDTHH4TRDZMINKBMM","content":"Participaron del almuerzo con Cartes los senadores<b> Basilio “Bachi” Núñez, Antonio “Tony” Barrios, Natalicio Chase y Gustavo Leite, además del asesor del Senado Sergio Godoy</b>, el ministro de Urbanismo, <b>Juan Carlos Baruja</b>, y el jefe de Gabinete de la Asociación Nacional Republicana (ANR) y asesor jurídico de Yacyretá, <b>Eduardo “Presi” González Báez</b>.","type":"text"},{"_id":"BTDKATM4ZZHHTKVABRDS4CU4II","caption":"El expresidente Horacio Cartes recibió ayer al titular del Senado, Basilio \"Bachi\" Núñez; a los senadores Gustavo Leite, Antonio Barrios, Natalicio Chase; el ministro de la Vivienda, Juan Carlos Baruja; el asesor del Senado, Sergio Godoy y el jefe de gabinete de la ANR, Eduardo González Báez. Fue al mediodía del lunes en la residencia del exmandatario en Asunción.","credits":{"by":[]},"resized_urls":{"1080x1270":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=1080&height=1270&smart=true","110x70":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=110&height=70&smart=true","1140x663":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=1140&height=663&smart=true","115x115":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=115&height=115&smart=true","1200x1080":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=1200&smart=true","1280x720":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=1280&height=720&smart=true","1300x900":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=1300&height=900&smart=true","140x191":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=140&height=191&smart=true","155x87":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=155&smart=true","170x110":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=170&height=110&smart=true","170x170":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=170&height=170&smart=true","170x250":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=170&height=250&smart=true","1900x1000":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=1900&height=1000&smart=true","1920x1080":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=1920&height=1080&smart=true","1920xorig":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=1920&smart=true","200x300":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=200&height=300&smart=true","200x303":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=200&height=303&smart=true","200x320":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=200&height=320&smart=true","200x95":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=200&height=95&smart=true","205x158":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=205&height=158&smart=true","225x127":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=225&height=127&smart=true","233x303":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=233&height=303&smart=true","254x190":"https://w