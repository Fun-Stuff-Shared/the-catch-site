resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=770&height=190&smart=true","770x495":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=770&smart=true","770xorig":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=770&smart=true","800x600":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=800&smart=true","85x125":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=85&height=125&smart=true","90x100":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=90&height=100&smart=true","90x90":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=90&height=90&smart=true","910x590":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&width=910&height=590&smart=true","origx200":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&height=200&smart=true","origxorig":"https://www.abc.com.py/resizer/v2/BTDKATM4ZZHHTKVABRDS4CU4II.jpg?auth=d8640ab606315a9370ebbce6994ff8a48aa7a02b341a48d2768b062599b9182f&&smart=true"},"type":"image","url":"https://cloudfront-us-east-1.images.arcpublishing.com/abccolor/BTDKATM4ZZHHTKVABRDS4CU4II.jpg"}},"publish_date":"2026-09-08T15:45:59.194Z","related_content":{"basic":[{"_id":"BY7J6IASSRA6RIRFNTZ4AS4GWI","referent":{"type":"story"},"type":"reference"}]},"subheadlines":{"basic":"El senador Gustavo Leite, quien forma parte del “primer anillo” reunido ayer en la casa de Horacio Cartes, brindó detalles de lo conversado en aquel encuentro que despertó suspicacia y reavivó los rumores de quiebre entre el titular de la ANR y el presidente Santiago Peña. “Queda claro que Cartes no tiene nada que ver con Ueno y no puede hacerse responsable de lo que manejen otros”, adelantó."},"taxonomy":{"primary_section":{"_id":"/politica","name":"Política","path":"/politica"}},"type":"story","website_url":"/politica/2026/09/08/reunion-en-casa-de-hc-leite-revela-de-que-converso-cartes-con-su-primer-anillo/"},{"_id":"UEF6THKCG5FDFJMQ2PRALLDLMY","canonical_url":"/nacionales/2026/09/08/pisa-que-dice-la-evaluacion-internacional-sobre-la-educacion-en-paraguay/","content_elements":[{"_id":"E5Q4YOAPUFFCJGZ3LCGHGAG574","content":"Este martes, la <b>Organización para la Cooperación y el Desarrollo Económicos</b> (OCDE) publicó su <a href=\"https://www.abc.com.py/internacionales/2026/09/08/pisa-alerta-de-una-caida-historica-del-rendimiento-escolar-especialmente-en-lectura/\" target=\"_blank\" rel=\"noreferrer\" title=\"https://www.abc.com.py/internacionales/2026/09/08/pisa-alerta-de-una-caida-historica-del-rendimiento-escolar-especialmente-en-lectura/\">informe del <b>Programa para la Evaluación Internacional de los Estudiantes</b></a> (PISA, por sus siglas en inglés), un estudio que evalúa cada tres años el rendimiento académico de <b>estudiantes de 15 años</b> en decenas de países -entre ellos <b>Paraguay</b>– por medio de exámenes estandarizados de matemática, ciencia y lectura. ","type":"text"},{"_id":"5LFJG7VUA5BQDDGW4JR5UVA2J4","content":"Los exámenes fueron realizados en 2025 y fueron evaluados unos <b>760.000 estudiantes de 15 años en 91 países y territorios</b>, y la conclusión del informe a nivel global es que se registró el nivel medio de rendimiento más bajo jamás observado en el examen, con caídas especialmente importantes en lectura y matemática. ","type":"text"},{"_id":"L34ETBWSW5A6VP6JZJ45YLRDOI","content":"Sobre Paraguay, el informe indica que el país está muy por debajo de los promedios de porcentaje de estudiantes cuyas calificaciones superaron un nivel base de competencia en <b>lectura </b>(24 por ciento, contra un promedio de 69 por ciento), <b>matemática </b>(10%, contra 64%), <b>ciencia </b>(24%, contra 74%) y <b>solución de problemas computacionales</b> (14%, contra 64%).","type":"text"},{"_id":"6V645MG25VCRDPSE3J5JDRZOPA","content":"Casi ningún estudiante paraguayo ha logrado ubicarse entre los mejor posicionados en lectura, ciencia o matemática. ","type":"text"},{"_id":"OCDXEBGIHRHOFJVKVOFQC3QAWE","content":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Gráfico Interactivo - Nivel Mínimo Alcanzado</title>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Lato:wght@300;400&family=Montserrat:wght@600;700&display=swap\" rel=\"stylesheet\">\n  \n  <style>\n    /* =========================================\n       SISTEMA DE DISEÑO BASE\n       ========================================= */\n    :root {\n      --primary: #ffe500;\n      --text-main: #000000;\n      --border-color: #e2e8f0;\n      --bg-neutral: #f8fafc;\n      --bar-secondary: #94a3b8;\n      --radius: 10px;\n    }\n\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n\n    body {\n      font-family: 'Lato', sans-serif;\n      font-weight: 400;\n      color: var(--text-main);\n      background-color: #ffffff;\n      padding: 24px 16px;\n      display: flex;\n      justify-content: center;\n    }\n\n    /* Tipografías estructuradas */\n    h1, h2, h3, h4 {\n      font-family: 'Montserrat', sans-serif;\n      font-weight: 700;\n      color: var(--text-main);\n      line-height: 1.25;\n    }\n\n    p, span, button {\n      font-family: 'Lato', sans-serif;\n      font-weight: 400;\n    }\n\n    /* =========================================\n       CONTENEDOR Y LAYOUT\n       ========================================= */\n    .chart-card {\n      width: 100%;\n      max-width: 680px;\n      border: 1px solid var(--border-color);\n      border-radius: var(--radius);\n      padding: 24px;\n      background-color: #ffffff;\n    }\n\n    .header-section {\n      border-left: 4px solid var(--text-main);\n      padding-left: 12px;\n      margin-bottom: 20px;\n    }\n\n    .main-title {\n      font-size: 1.25rem;\n      letter-spacing: -0.02em;\n      text-transform: uppercase;\n    }\n\n    .main-subtitle {\n      font-size: 0.9rem;\n      color: #475569;\n      margin-top: 6px;\n      line-height: 1.4;\n    }\n\n    /* Subcabecera interior */\n    .subcard-header {\n      padding-top: 12px;\n      border-top: 1px solid var(--border-color);\n      margin-bottom: 16px;\n    }\n\n    .subcard-title {\n      font-size: 1rem;\n      font-weight: 700;\n    }\n\n    .subcard-caption {\n      font-size: 0.825rem;\n      color: #64748b;\n      margin-top: 4px;\n    }\n\n    /* =========================================\n       BOTONES Y CONTROLES (UTILITARIOS)\n       ========================================= */\n    .controls {\n      display: flex;\n      gap: 8px;\n      margin-bottom: 20px;\n      flex-wrap: wrap;\n    }\n\n    .btn {\n      border: none;\n      border-radius: var(--radius);\n      background-color: var(--bg-neutral);\n      color: var(--text-main);\n      padding: 8px 14px;\n      font-size: 0.85rem;\n      font-weight: 600;\n      cursor: pointer;\n      transition: background-color 0.15s ease;\n      box-shadow: none;\n    }\n\n    .btn:hover {\n      filter: brightness(0.93);\n    }\n\n    .btn.active {\n      background-color: var(--primary);\n    }\n\n    /* Leyenda */\n    .legend {\n      display: flex;\n      align-items: center;\n      gap: 16px;\n      margin-bottom: 16px;\n      font-size: 0.85rem;\n    }\n\n    .legend-item {\n      display: inline-flex;\n      align-items: center;\n      gap: 6px;\n    }\n\n    .legend-indicator {\n      width: 12px;\n      height: 12px;\n      border-radius: 2px;\n    }\n\n    .indicator-py {\n      background-color: var(--text-main);\n      outline: 2px solid var(--primary);\n      outline-offset: -2px;\n    }\n\n    .indicator-ocde {\n      background-color: var(--bar-secondary);\n    }\n\n    /* =========================================\n       GRÁFICO VECTORIAL (SVG)\n       ========================================= */\n    .chart-wrapper {\n      position: relative;\n      width: 100%;\n    }\n\n    svg {\n      width: 100%;\n      height: auto;\n      overflow: visible;\n      font-family: 'Lato', sans-serif;\n    }\n\n    .grid-line {\n      stroke: var(--border-color);\n      stroke-width: 1;\n      stroke-dasharray: 2, 2;\n    }\n\n    .axis-label {\n      fill: #64748b;\n      font-size: 11px;\n      font-weight: 400;\n    }\n\n    .category-label {\n      fill: var(--text-main);\n      font-family: 'Montserrat', sans-serif;\n      font-size: 12px;\n      font-weight: 600;\n      text-anchor: middle;\n    }\n\n    /* Barras */\n    .bar {\n      cursor: pointer;\n      transition: opacity 0.15s ease;\n    }\n\n    .bar-py {\n      fill: var(--primary);\n      stroke: var(--text-main);\n      stroke-width: 1.5;\n    }\n\n    .bar-ocde {\n      fill: var(--bar-secondary);\n    }\n\n    .bar:hover {\n      opacity: 0.85;\n    }\n\n    /* Tooltip contextual plano */\n    .tooltip {\n      position: absolute;\n      pointer-events: none;\n      background-color: var(--text-main);\n      color: #ffffff;\n      padding: 6px 10px;\n      border-radius: 6px;\n      font-size: 0.75rem;\n      display: none;\n      white-space: nowrap;\n      transform: translate(-50%, -110%);\n      z-index: 10;\n    }\n\n    .tooltip strong {\n      font-family: 'Montserrat', sans-serif;\n      color: var(--primary);\n    }\n\n    /* Adaptabilidad Mobile */\n    @media (max-width: 480px) {\n      .chart-card {\n        padding: 16px;\n      }\n      .main-title {\n        font-size: 1.1rem;\n      }\n      .category-label {\n        font-size: 11px;\n      }\n    }\n  </style>\n</head>\n<body>\n\n  <div class=\"chart-card\">\n    <div class=\"header-section\">\n      <h1 class=\"main-title\">Nivel Mínimo Alcanzado</h1>\n      <p class=\"main-subtitle\">Porcentaje de estudiantes que llega al menos al Nivel 2 de competencia, el umbral básico para desenvolverse en la vida adulta.</p>\n    </div>\n\n    <div class=\"subcard-header\">\n      <h2 class=\"subcard-title\">Paraguay vs. promedio OCDE</h2>\n      <p class=\"subcard-caption\">Ciencias, matemática y lectura — % con nivel de competencia igual o superior a Nivel 2</p>\n    </div>\n\n    <!-- Controles de filtrado e interactividad -->\n    <div class=\"controls\">\n      <button class=\"btn active\" onclick=\"filterData('all', this)\">Todas las áreas</button>\n      <button class=\"btn\" onclick=\"filterData('Ciencias', this)\">Ciencias</button>\n      <button class=\"btn\" onclick=\"filterData('Matemática', this)\">Matemática</button>\n      <button class=\"btn\" onclick=\"filterData('Lectura', this)\">Lectura</button>\n    </div>\n\n    <div class=\"legend\">\n      <div class=\"legend-item\">\n        <span class=\"legend-indicator indicator-py\"></span>\n        <span>Paraguay</span>\n      </div>\n      <div class=\"legend-item\">\n        <span class=\"legend-indicator indicator-ocde\"></span>\n        <span>Promedio OCDE</span>\n      </div>\n    </div>\n\n    <div class=\"chart-wrapper\">\n      <div id=\"tooltip\" class=\"tooltip\"></div>\n      <svg viewBox=\"0 0 500 280\" id=\"svg-chart\" preserveAspectRatio=\"xMidYMid meet\"></svg>\n    </div>\n  </div>\n\n  <script>\n    const data = [\n      { area: \"Ciencias\", py: 24, ocde: 74 },\n      { area: \"Matemática\", py: 10, ocde: 65 },\n      { area: \"Lectura\", py: 24, ocde: 69 }\n    ];\n\n    const svg = document.getElementById('svg-chart');\n    const tooltip = document.getElementById('tooltip');\n\n    const chartHeight = 220;\n    const chartWidth = 460;\n    const originX = 35;\n    const originY = 20;\n\n    function renderChart(items) {\n      svg.innerHTML = '';\n\n      // Eje Y y líneas horizontales auxiliares (0% a 100%)\n      for (let i = 0; i <= 5; i++) {\n        const val = i * 20;\n        const y = originY + chartHeight - (chartHeight * (val / 100));\n\n        const line = document.createElementNS(\"http://www.w3.org/2000/svg\", \"line\");\n        line.setAttribute(\"x1\", originX);\n        line.setAttribute(\"y1\", y);\n        line.setAttribute(\"x2\", originX + chartWidth);\n        line.setAttribute(\"y2\", y);\n        line.setAttribute(\"class\", \"grid-line\");\n        svg.appendChild(line);\n\n        const text = document.createElementNS(\"http://www.w3.org/2000/svg\", \"text\");\n        text.setAttribute(\"x\", originX - 6);\n        text.setAttribute(\"y\", y + 3);\n        text.setAttribute(\"text-anchor\", \"end\");\n        text.setAttribute(\"class\", \"axis-label\");\n        text.textContent = val + \"%\";\n        svg.appendChild(text);\n      }\n\n      // Distribución horizontal de columnas\n      const slotWidth = chartWidth / items.length;\n      const barWidth = Math.min(36, slotWidth * 0.22);\n      const gap = 4;\n\n      items.forEach((d, idx) => {\n        const centerX = originX + (slotWidth * idx) + (slotWidth / 2);\n\n        // Barra Paraguay\n        const pyHeight = (chartHeight * (d.py / 100));\n        const pyY = originY + chartHeight - pyHeight;\n        const pyX = centerX - barWidth - (gap / 2);\n\n        const rectPy = document.createElementNS(\"http://www.w3.org/2000/svg\", \"rect\");\n        rectPy.setAttribute(\"x\", pyX);\n        rectPy.setAttribute(\"y\", pyY);\n        rectPy.setAttribute(\"width\", barWidth);\n        rectPy.setAttribute(\"height\", pyHeight);\n        rectPy.setAttribute(\"rx\", \"4\");\n        rectPy.setAttribute(\"class\", \"bar bar-py\");\n        attachTooltip(rectPy, `Paraguay: <strong>${d.py}%</strong> (${d.area})`);\n        svg.appendChild(rectPy);\n\n        // Barra OCDE\n        const ocdeHeight = (chartHeight * (d.ocde / 100));\n        const ocdeY = originY + chartHeight - ocdeHeight;\n        const ocdeX = centerX + (gap / 2);\n\n        const rectOcde = document.createElementNS(\"http://www.w3.org/2000/svg\", \"rect\");\n        rectOcde.setAttribute(\"x\", ocdeX);\n        rectOcde.setAttribute(\"y\", ocdeY);\n        rectOcde.setAttribute(\"width\", barWidth);\n        rectOcde.setAttribute(\"height\", ocdeHeight);\n        rectOcde.setAttribute(\"rx\", \"4\");\n        rectOcde.setAttribute(\"class\", \"bar bar-ocde\");\n        attachTooltip(rectOcde, `Promedio OCDE: <strong>${d.ocde}%</strong> (${d.area})`);\n        svg.appendChild(rectOcde);\n\n        // Etiqueta Eje X\n        const label = document.createElementNS(\"http://www.w3.org/2000/svg\", \"text\");\n        label.setAttribute(\"x\", centerX);\n        label.setAttribute(\"y\", originY + chartHeight + 20);\n        label.setAttribute(\"class\", \"category-label\");\n        label.textContent = d.area;\n        svg.appendChild(label);\n      });\n    }\n\n    function attachTooltip(element, htmlContent) {\n      element.addEventListener('mouseenter', (e) => {\n        tooltip.innerHTML = htmlContent;\n        tooltip.style.display = 'block';\n      });\n\n      element.addEventListener('mousemove', (e) => {\n        const bounds = svg.getBoundingClientRect();\n        tooltip.style.left = (e.clientX - bounds.left) + 'px';\n        tooltip.style.top = (e.clientY - bounds.top) + 'px';\n      });\n\n      element.addEventListener('mouseleave', () => {\n        tooltip.style.display = 'none';\n      });\n    }\n\n    function filterData(area, btn) {\n      document.querySelectorAll('.controls .btn').forEach(b => b.classList.remove('active'));\n      btn.classList.add('active');\n\n      if (area === 'all') {\n        renderChart(data);\n      } else {\n        renderChart(data.filter(d => d.area === area));\n      }\n    }\n\n    // Carga inicial\n    renderChart(data);\n  <\/script>\n</body>\n</html>","type":"raw_html"},{"_id":"7J7CCUGE3JEERF53STETJL5IDQ","content":"Caída en rendimiento en ciencia y lectura","level":2,"type":"header"},{"_id":"QLOHLWV3TZAUFERFT3VK6GCZEU","caption":"","credits":{"by":[{"name":"Itaipú Binacional","type":"author"}]},"resized_urls":{"1080x1270":"https://www.abc.com.py/resizer/v2/QLOHLWV3TZAUFERFT3VK6GCZEU.jpg?auth=0699e04ce67155842a7a6dfc1e7b0e6cc6180c6348dd6855eda5f784e6cc6b01&width=1080&height=1270&smart=true","110x70":"https://www.abc.com.py/resizer/v2/QLOHLWV3TZAUFERFT3VK6GCZEU.jpg?auth=0699e04ce67155842a7a6dfc1e7b0e6cc6180c6348dd6855eda5f784e6cc6b01&width=110&height=70&smart=true","1140x663":"https://www.abc.com.py/resizer/v2/QLOHLWV3TZAUFERFT3VK6GCZEU.jpg?auth=0699e04ce67155842a7a6dfc1e7b0e6cc6180c6348dd6855eda5f784e6cc6b01&width=1140&height=663&smart=true","115x115":"https://www.abc.com.py/resizer/v2/QLOHLWV3TZAUFERFT3VK6GCZEU.jpg?auth=0699e04ce67155842a7a6dfc1e7b0e6cc6180c6348dd6855eda5f784e6cc6b01&width=115&height=115&smart=true","1200x1080":"https://www.abc.com.py/resizer/v2/QLOHLWV3TZAUFERFT3VK6GCZEU.jpg?auth=0699e04ce67155842a7a6dfc1e7b0e6cc6180c6348dd6855eda5f784e6cc6b01&width=1200&smart=true","1280x720":"https://www.abc.com.py/resizer/v2/QLOHLWV3TZAUFERFT3VK6GCZEU.jpg?auth=0699e04ce67155842a7a6dfc1e7b0e6cc6180c6348dd6855eda5f784e6cc6b01&width=1280&height=720&smart=true","1300x900":"https://www.abc.com.py/resizer/v2/QLOHLWV3TZAUFERFT3VK6GCZEU.jpg?auth=0699e04ce67155842a7a6dfc1e7b0e6cc6180c6348dd6855eda5f784e6cc6b01&width=1300&height=900&smart=true","140x191":"https://www.abc.com.py/resizer/v2/QLOHLWV3TZAUFERFT3VK6GCZEU.jpg?auth=0699e04ce67155842a7a6dfc1e7b0e6cc6180c6348dd6855eda