=true","402x156":"https://www.abc.com.py/resizer/v2/5IU3BEY5ZBFHBCBYFQVZFKCXKE.jpg?auth=e776831a747a2ae0ced053065132db5dff5dcaa437d01c9e21a2ae547a26f94e&width=402&height=156&smart=true","402x85":"https://www.abc.com.py/resizer/v2/5IU3BEY5ZBFHBCBYFQVZFKCXKE.jpg?auth=e776831a747a2ae0ced053065132db5dff5dcaa437d01c9e21a2ae547a26f94e&width=402&height=85&smart=true","410x480":"https://www.abc.com.py/resizer/v2/5IU3BEY5ZBFHBCBYFQVZFKCXKE.jpg?auth=e776831a747a2ae0ced053065132db5dff5dcaa437d01c9e21a2ae547a26f94e&width=410&height=480&smart=true","420x545":"https://www.abc.com.py/resizer/v2/5IU3BEY5ZBFHBCBYFQVZFKCXKE.jpg?auth=e776831a747a2ae0ced053065132db5dff5dcaa437d01c9e21a2ae547a26f94e&width=420&height=545&smart=true","500x500":"https://www.abc.com.py/resizer/v2/5IU3BEY5ZBFHBCBYFQVZFKCXKE.jpg?auth=e776831a747a2ae0ced053065132db5dff5dcaa437d01c9e21a2ae547a26f94e&width=500&height=500&smart=true","540x250":"https://www.abc.com.py/resizer/v2/5IU3BEY5ZBFHBCBYFQVZFKCXKE.jpg?auth=e776831a747a2ae0ced053065132db5dff5dcaa437d01c9e21a2ae547a26f94e&width=540&height=250&smart=true","540x300":"https://www.abc.com.py/resizer/v2/5IU3BEY5ZBFHBCBYFQVZFKCXKE.jpg?auth=e776831a747a2ae0ced053065132db5dff5dcaa437d01c9e21a2ae547a26f94e&width=540&height=300&smart=true","600x908":"https://www.abc.com.py/resizer/v2/5IU3BEY5ZBFHBCBYFQVZFKCXKE.jpg?auth=e776831a747a2ae0ced053065132db5dff5dcaa437d01c9e21a2ae547a26f94e&width=600&height=908&smart=true","700x908":"https://www.abc.com.py/resizer/v2/5IU3BEY5ZBFHBCBYFQVZFKCXKE.jpg?auth=e776831a747a2ae0ced053065132db5dff5dcaa437d01c9e21a2ae547a26f94e&width=700&height=908&smart=true","770x190":"https://www.abc.com.py/resizer/v2/5IU3BEY5ZBFHBCBYFQVZFKCXKE.jpg?auth=e776831a747a2ae0ced053065132db5dff5dcaa437d01c9e21a2ae547a26f94e&width=770&height=190&smart=true","770x495":"https://www.abc.com.py/resizer/v2/5IU3BEY5ZBFHBCBYFQVZFKCXKE.jpg?auth=e776831a747a2ae0ced053065132db5dff5dcaa437d01c9e21a2ae547a26f94e&width=770&smart=true","770xorig":"https://www.abc.com.py/resizer/v2/5IU3BEY5ZBFHBCBYFQVZFKCXKE.jpg?auth=e776831a747a2ae0ced053065132db5dff5dcaa437d01c9e21a2ae547a26f94e&width=770&smart=true","800x600":"https://www.abc.com.py/resizer/v2/5IU3BEY5ZBFHBCBYFQVZFKCXKE.jpg?auth=e776831a747a2ae0ced053065132db5dff5dcaa437d01c9e21a2ae547a26f94e&width=800&smart=true","85x125":"https://www.abc.com.py/resizer/v2/5IU3BEY5ZBFHBCBYFQVZFKCXKE.jpg?auth=e776831a747a2ae0ced053065132db5dff5dcaa437d01c9e21a2ae547a26f94e&width=85&height=125&smart=true","90x100":"https://www.abc.com.py/resizer/v2/5IU3BEY5ZBFHBCBYFQVZFKCXKE.jpg?auth=e776831a747a2ae0ced053065132db5dff5dcaa437d01c9e21a2ae547a26f94e&width=90&height=100&smart=true","90x90":"https://www.abc.com.py/resizer/v2/5IU3BEY5ZBFHBCBYFQVZFKCXKE.jpg?auth=e776831a747a2ae0ced053065132db5dff5dcaa437d01c9e21a2ae547a26f94e&width=90&height=90&smart=true","910x590":"https://www.abc.com.py/resizer/v2/5IU3BEY5ZBFHBCBYFQVZFKCXKE.jpg?auth=e776831a747a2ae0ced053065132db5dff5dcaa437d01c9e21a2ae547a26f94e&width=910&height=590&smart=true","origx200":"https://www.abc.com.py/resizer/v2/5IU3BEY5ZBFHBCBYFQVZFKCXKE.jpg?auth=e776831a747a2ae0ced053065132db5dff5dcaa437d01c9e21a2ae547a26f94e&height=200&smart=true","origxorig":"https://www.abc.com.py/resizer/v2/5IU3BEY5ZBFHBCBYFQVZFKCXKE.jpg?auth=e776831a747a2ae0ced053065132db5dff5dcaa437d01c9e21a2ae547a26f94e&&smart=true"},"type":"image","url":"https://cloudfront-us-east-1.images.arcpublishing.com/abccolor/5IU3BEY5ZBFHBCBYFQVZFKCXKE.jpg"}},"publish_date":"2026-09-08T14:20:42.045Z","related_content":{"basic":[]},"subheadlines":{"basic":"Una reunión entre Horacio Cartes y referentes de su círculo más cercano, tras un pedido de informes sobre Ueno Bank impulsado por senadores cartistas y a recientes cuestionamientos a la gestión sanitaria del Gobierno, reactivó las especulaciones sobre un eventual distanciamiento entre el expresidente y Santiago Peña."},"taxonomy":{"primary_section":{"_id":"/politica","name":"Política","path":"/politica"},"tags":[{"slug":"horacio-cartes","text":"Horacio  Cartes"},{"slug":"santiago-pena","text":"Santiago  Peña"},{"slug":"honor-colorado","text":" Honor Colorado"},{"slug":"ueno-bank","text":"ueno bank"}]},"type":"story","website_url":"/politica/2026/09/08/quiebre-entre-pena-y-cartes-reunion-en-casa-de-hc-y-ofensiva-sobre-ueno-alimentan-rumores/"},{"_id":"S5DAFPPIAJDERPUS6YBZJ7YN7A","canonical_url":"/nacionales/2026/09/07/hugo-javier-medico-brinda-estos-detalles-sobre-el-estado-del-exgobernador-tras-cirugia/","content_elements":[{"_id":"XOV33IWJVFEJPOHN2THVCWWPRU","content":"El exgobernador colorado de Central, <a href=\"https://www.abc.com.py/tag/hugo-javier-gonzalez/\" target=\"_blank\" rel=\"noreferrer\" title=\"https://www.abc.com.py/tag/hugo-javier-gonzalez/\">Hugo Javier González</a>, atravesó esta tarde sus <b>“primeros minutos postquirúrgicos”</b> luego de la cirugía para la colocación de un catéter de derivación ventricular externa, según confirmó el doctor <b>José Espínola Orrego</b>.","type":"text"},{"_id":"X3QOWZB2GBEGDLXMLXKREWB5YQ","content":"Al respecto, el profesional explicó que el mencionado catéter tiene dos funciones principales: <b>medir la presión intracraneal </b>tras casos de edemas, lesiones, traumáticas o por un accidente cerebrovascular (ACV), <b>al igual que para drenar líquido. </b>","type":"text"},{"_id":"3FAXW6Q35JGJDK6GAEJLAHIUXQ","content":"“El cerebro normalmente está flotando en un líquido, en casos de lesión, traumatismo o ACV, ese líquido puede puede aumentar y <b>se genera hidrocefalia.</b> Se está drenando ese líquido, también se extrajo y <b>se envío a laboratorio para su estudio</b>”, detalló.","type":"text"},{"_id":"36UNQ5SW75E7BEI3HI67B2T7WA","content":"Asimismo, confirmó que la instalación del catéter fue exitosa y posteriormente se le volvió a realizar una tomografía -la tercera del día-, luego de ya haber sido revisado de <b>“pies a cabeza”</b> para la detección de lesiones.","type":"text"},{"_id":"4GLRNOTTFVDEHBW3FP5ARJXA4E","content":"Caída por ataque o ACV? Las “sospechas” del director del Hospital Nacional sobre Hugo Javier","type":"interstitial_link","url":"https://www.abc.com.py/nacionales/2026/09/07/caida-por-ataque-o-acv-las-sospechas-del-director-del-hospital-nacional-sobre-hugo-javier/"},{"_id":"JG7F4OLFAVGKXPNNEMMP7TX3AQ","content":"El “plan” de tratamiento para González","level":2,"type":"header"},{"_id":"NAPH6J2UX5AQ5LABAU34R4S52Y","content":"Si bien el doctor precisó que aún faltan varios informes y estudios, de momento se encontraron varias lesiones a nivel <b>“encefálico”</b> y recordó que el paciente aparentemente fue encontrado convulsionando, algo que puede generar una <b>hipoxia </b>al no respirar durante las convulsiones. ","type":"text"},{"_id":"KD2L5DUD25AT7LSSZDX7I5PCQ4","content":"Por esto confirmó que el “plan” con González tras su cirugía es una <b>“sedación total con drogas”</b>, un coma inducido para<b> “evitar que el cerebro tenga cualquier tipo de estrés”.</b>","type":"text"},{"_id":"5N2JEX66EJBXFLWNUIUGOGWW4I","content":"“Se le seda totalmente y posteriormente, según protocolo,<b> normalmente en 48 horas se le retira paulatinamente</b> y se ve el estado neurológico. De acuerdo a los avances que pueda haber en terapia puede haber otro criterio para antes o un poco después”, comentó.","type":"text"},{"_id":"OJ3JTVRTUNCCXDAIOX5G3H5QMU","content":"Además, citó que existe un <b>hematoma bipalpebral</b>, una condición conocida como<b> “ojo de mapache”</b> donde los ojos están morados. También se localizó una <b>fractura en el techo de la órbita</b>, la cavidad ósea donde se aloja el globo ocular.","type":"text"},{"_id":"2V3BRZ45ORAK3IUQQ7VXQYDPHI","content":"Hugo Javier: en estado grave e intubado tras sufrir un probable ACV hemorrágico en prisión","type":"interstitial_link","url":"https://www.abc.com.py/nacionales/2026/09/07/hugo-javier-en-estado-grave-e-intubado-tras-sufrir-un-probable-acv-hemorragico-en-prision/"},{"_id":"SXQQJFYE7FFHNMATXFXNK4N6WE","content":"Hugo Javier: agresión o ACV","level":2,"type":"header"},{"_id":"AQ3F3VU5FVFTFIUYAS5EH7WLOI","content":"Al ser consultado sobre si Hugo Javier pudo haber sido agredido físicamente, el funcionario médico confirmó que “no está descartado eso”, sin embargo, reiteró que <b>“queremos ser prudentes” </b>en las informaciones, por lo que hasta ahora no se puede confirmar tal dato.","type":"text"},{"_id":"4Z7SZWQ42BBJZFNBQ553BE77KQ","content":"“Hay probabilidades de que haya sido agredido, pero queremos ser prudentes en ese caso. La otra hipótesis es que haya tenido un ACV, cayó en el baño y <b>llevó la cara fuerte por el inodoro</b>, esa es otra teoría. No descartamos para nada el tema de la agresión”, reiteró. ","type":"text"},{"_id":"TSCZTT47EREMDJKQOEXJPBN44I","content":"También confirmó que <b>representantes del Ministerio Público</b> se acercaron al hospital para labrar acta y verificar el estado en el que se encuentra González.","type":"text"},{"_id":"3A4FR5GAJNF5JMBGFP5QRXG4SQ","content":"Este lunes, el exgobernador de Central fue hallado inconsciente en su celda con un<b> traumatismo craneoencefálico.</b> ","type":"text"},{"_id":"OKU3MQI7EJGHZGW35JXEML6HKA","content":"Hugo Javier es trasladado de emergencia a un hospital: esto es lo que se sabe","type":"interstitial_link","url":"https://www.abc.com.py/policiales/2026/09/07/hugo-javier-es-trasladado-de-emergencia-de-la-carcel-a-un-hospital-esto-es-lo-que-se-sabe/"}],"credits":{"by":[{"image":{"url":""},"name":"José González Mazo","slug":"jose-gonzalez-mazo"}]},"description":{"basic":""},"display_date":"2026-09-08T00:06:38.389Z","headlines":{"basic":"Hugo Javier: médico brinda estos detalles sobre el estado del exgobernador tras cirugía"},"promo_items":{"basic":{"caption":"Imagen de archivo: el exgobernador de Central Hugo Javier González. ","credits":{"by":[{"name":"Gustavo Machado"}]},"resized_urls":{"1080x1270":"https://www.abc.com.py/resizer/v2/W4WUFKHHSBAAPP6YOJTTEH34G4.jpg?auth=f58ab03ea2c70b72a17539576ba68a57dfcab0df1014d750496d646973a7197c&width=1080&height=1270&smart=true","110x70":"https://www.abc.com.py/resizer/v2/W4WUFKHHSBAAPP6YOJTTEH34G4.jpg?auth=f58ab03ea2c70b72a17539576ba68a57dfcab0df1014d750496d646973a7197c&width=110&height=70&smart=true","1140x663":"https://www.abc.com.py/resizer/v2/W4WUFKHHSBAAPP6YOJTTEH34G4.jpg?auth=f58ab03ea2c70b72a17539576ba68a57dfcab0df1014d750496d646973a7197c&width=1140&height=663&smart=true","115x115":"https://www.abc.com.py/resizer/v2/W4WUFKHHSBAAPP6YOJTTEH34G4.jpg?auth=f58ab03ea2c70b72a17539576ba68a57dfcab0df1014d750496d646973a7197c&width=115&height=115&smart=true","1200x1080":"https://www.abc.com.py/resizer/v2/W4WUFKHHSBAAPP6YOJTTEH34G4.jpg?auth=f58ab03ea2c70b72a17539576ba68a57dfcab0df1014d750496d646973a7197c&width=1200&smart=true","1280x720":"https://www.abc.com.py/resizer/v2/W4WUFKHHSBAAPP6YOJTTEH34G4.jpg?auth=f58ab03ea2c70b72a17539576ba68a57dfcab0df1014d750496d646973a7197c&width=1280&height=720&smart=true","1300x900":"https://www.abc.com.py/resizer/v2/W4WUFKHHSBAAPP6YOJTTEH34G4.jpg?auth=f58ab03ea2c70b72a17539576ba68a57dfcab0df1014d750496d646973a7197c&width=1300&height=900&smart=true","140x191":"https://www.abc.com.py/resizer/v2/W4WUFKHHSBAAPP6YOJTTEH34G4.jpg?auth=f58ab03ea2c70b72a17539576ba68a57dfcab0df1014d750496d646973a7197c&width=140&height=191&smart=true","155x87":"https://www.abc.com.py/resizer/v2/W4WUFKHHSBAAPP6YOJTTEH34G4.jpg?auth=f58ab03ea2c70b72a17539576ba68a57dfcab0df1014d750496d646973a7197c&width=155&smart=true","170x110":"https://www.abc.com.py/resizer/v2/W4WUFKHHSBAAPP6YOJTTEH34G4.jpg?auth=f58ab03ea2c70b72a17539576ba68a57dfcab0df1014d750496d646973a7197c&width=170&height=110&smart=true","170x170":"https://www.abc.com.py/resizer/v2/W4WUFKHHSBAAPP6YOJTTEH34G4.jpg?auth=f58ab03ea2c70b72a17539576ba68a57dfcab0df1014d750496d646973a7197c&width=170&height=170&smart=true","170x250":"https://www.abc.com.py/resizer/v2/W4WUFKHHSBAAPP6YOJTTEH34G4.jpg?auth=f58ab03ea2c70b72a17539576ba68a57dfcab0df1014d750496d646973a7197c&width=170&height=250&smart=true","1900x1000":"h