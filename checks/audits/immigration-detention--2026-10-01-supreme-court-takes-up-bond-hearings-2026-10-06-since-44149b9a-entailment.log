2JKXL5CEBHXWFJNS7RHZMM.jpg?auth=bec4f819f6b954abc8b3b701f6baa7b3e00d10651a43a4b5f3b3245f89e3d4f9&width=770&smart=true","770xorig":"https://www.abc.com.py/resizer/v2/XLMM2JKXL5CEBHXWFJNS7RHZMM.jpg?auth=bec4f819f6b954abc8b3b701f6baa7b3e00d10651a43a4b5f3b3245f89e3d4f9&width=770&smart=true","800x600":"https://www.abc.com.py/resizer/v2/XLMM2JKXL5CEBHXWFJNS7RHZMM.jpg?auth=bec4f819f6b954abc8b3b701f6baa7b3e00d10651a43a4b5f3b3245f89e3d4f9&width=800&smart=true","85x125":"https://www.abc.com.py/resizer/v2/XLMM2JKXL5CEBHXWFJNS7RHZMM.jpg?auth=bec4f819f6b954abc8b3b701f6baa7b3e00d10651a43a4b5f3b3245f89e3d4f9&width=85&height=125&smart=true","90x100":"https://www.abc.com.py/resizer/v2/XLMM2JKXL5CEBHXWFJNS7RHZMM.jpg?auth=bec4f819f6b954abc8b3b701f6baa7b3e00d10651a43a4b5f3b3245f89e3d4f9&width=90&height=100&smart=true","90x90":"https://www.abc.com.py/resizer/v2/XLMM2JKXL5CEBHXWFJNS7RHZMM.jpg?auth=bec4f819f6b954abc8b3b701f6baa7b3e00d10651a43a4b5f3b3245f89e3d4f9&width=90&height=90&smart=true","910x590":"https://www.abc.com.py/resizer/v2/XLMM2JKXL5CEBHXWFJNS7RHZMM.jpg?auth=bec4f819f6b954abc8b3b701f6baa7b3e00d10651a43a4b5f3b3245f89e3d4f9&width=910&height=590&smart=true","origx200":"https://www.abc.com.py/resizer/v2/XLMM2JKXL5CEBHXWFJNS7RHZMM.jpg?auth=bec4f819f6b954abc8b3b701f6baa7b3e00d10651a43a4b5f3b3245f89e3d4f9&height=200&smart=true","origxorig":"https://www.abc.com.py/resizer/v2/XLMM2JKXL5CEBHXWFJNS7RHZMM.jpg?auth=bec4f819f6b954abc8b3b701f6baa7b3e00d10651a43a4b5f3b3245f89e3d4f9&&smart=true"},"type":"image","url":"https://cloudfront-us-east-1.images.arcpublishing.com/abccolor/XLMM2JKXL5CEBHXWFJNS7RHZMM.jpg"},{"_id":"KCAF27ZT4BGHRKO6F524Q7SL6U","content":"Según informó hoy el Hospital Nacional de Itauguá, el exgobernador González se encuentra en condición estable, pero no está fuera de peligro.","type":"text"},{"_id":"DWUFN5XC5RDS5AM62BXC6QBF5E","content":"Lea más: <a href=\"https://www.abc.com.py/nacionales/2026/09/08/no-pueden-determinar-causa-del-acv-de-hugo-javier-dice-director-del-hni/\" target=\"_blank\" rel=\"noreferrer\" title=\"https://www.abc.com.py/nacionales/2026/09/08/no-pueden-determinar-causa-del-acv-de-hugo-javier-dice-director-del-hni/\">No pueden determinar causa del ACV de Hugo Javier, dice director del HNI</a>","type":"text"},{"_id":"4HFUKT2PGZDJ7GQOF3BIC5OPLU","content":"El director del Hospital Nacional, el <b>doctor Miguel Ferreira</b>, dijo que la ficha médica del exgobernador no indicaba que este fuera hipertenso o diabético, por lo que las causas del accidente cerebrovascular aún son inciertas. ","type":"text"}],"credits":{"by":[{"image":{"url":""},"name":"Kike Sosa, ABC Color","slug":"kike-sosa"}]},"description":{"basic":""},"display_date":"2026-09-08T15:50:59.639Z","headlines":{"basic":"La hipótesis preliminar de la Fiscalía sobre las lesiones de Hugo Javier"},"promo_items":{"basic":{"caption":"Hugo Javier González.","credits":{"by":[{"name":"Gentileza"}]},"resized_urls":{"1080x1270":"https://www.abc.com.py/resizer/v2/4ORISJHPYRAD5F7DNUYM33IXPU.jpg?auth=276bf652be85d019a87e7fb740c03cd4762231e37109e4a9bfe09c053d9c7b9c&width=1080&height=1270&focal=312,241","110x70":"https://www.abc.com.py/resizer/v2/4ORISJHPYRAD5F7DNUYM33IXPU.jpg?auth=276bf652be85d019a87e7fb740c03cd4762231e37109e4a9bfe09c053d9c7b9c&width=110&height=70&focal=312,241","1140x663":"https://www.abc.com.py/resizer/v2/4ORISJHPYRAD5F7DNUYM33IXPU.jpg?auth=276bf652be85d019a87e7fb740c03cd4762231e37109e4a9bfe09c053d9c7b9c&width=1140&height=663&focal=312,241","115x115":"https://www.abc.com.py/resizer/v2/4ORISJHPYRAD5F7DNUYM33IXPU.jpg?auth=276bf652be85d019a87e7fb740c03cd4762231e37109e4a9bfe09c053d9c7b9c&width=115&height=115&focal=312,241","1200x1080":"https://www.abc.com.py/resizer/v2/4ORISJHPYRAD5F7DNUYM33IXPU.jpg?auth=276bf652be85d019a87e7fb740c03cd4762231e37109e4a9bfe09c053d9c7b9c&width=1200&focal=312,241","1280x720":"https://www.abc.com.py/resizer/v2/4ORISJHPYRAD5F7DNUYM33IXPU.jpg?auth=276bf652be85d019a87e7fb740c03cd4762231e37109e4a9bfe09c053d9c7b9c&width=1280&height