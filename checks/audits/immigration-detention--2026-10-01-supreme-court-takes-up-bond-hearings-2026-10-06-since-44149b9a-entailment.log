0d4cd50ef9596c3320d765e2bfd6ebf7f347b131&width=770&smart=true","800x600":"https://www.abc.com.py/resizer/v2/75L2U764TRADHGNLLIZDTEM6NE.jpeg?auth=35a9ad859821c506a6096a790d4cd50ef9596c3320d765e2bfd6ebf7f347b131&width=800&smart=true","85x125":"https://www.abc.com.py/resizer/v2/75L2U764TRADHGNLLIZDTEM6NE.jpeg?auth=35a9ad859821c506a6096a790d4cd50ef9596c3320d765e2bfd6ebf7f347b131&width=85&height=125&smart=true","90x100":"https://www.abc.com.py/resizer/v2/75L2U764TRADHGNLLIZDTEM6NE.jpeg?auth=35a9ad859821c506a6096a790d4cd50ef9596c3320d765e2bfd6ebf7f347b131&width=90&height=100&smart=true","90x90":"https://www.abc.com.py/resizer/v2/75L2U764TRADHGNLLIZDTEM6NE.jpeg?auth=35a9ad859821c506a6096a790d4cd50ef9596c3320d765e2bfd6ebf7f347b131&width=90&height=90&smart=true","910x590":"https://www.abc.com.py/resizer/v2/75L2U764TRADHGNLLIZDTEM6NE.jpeg?auth=35a9ad859821c506a6096a790d4cd50ef9596c3320d765e2bfd6ebf7f347b131&width=910&height=590&smart=true","origx200":"https://www.abc.com.py/resizer/v2/75L2U764TRADHGNLLIZDTEM6NE.jpeg?auth=35a9ad859821c506a6096a790d4cd50ef9596c3320d765e2bfd6ebf7f347b131&height=200&smart=true","origxorig":"https://www.abc.com.py/resizer/v2/75L2U764TRADHGNLLIZDTEM6NE.jpeg?auth=35a9ad859821c506a6096a790d4cd50ef9596c3320d765e2bfd6ebf7f347b131&&smart=true"},"type":"image","url":"https://cloudfront-us-east-1.images.arcpublishing.com/abccolor/75L2U764TRADHGNLLIZDTEM6NE.jpeg"},{"_id":"PG7DSV425FC5DI6YRA3NU5C2RM","content":"En entrevista con <b>ABC TV</b> y <b>ABC Cardinal</b>, el senador <b>Gustavo Leite</b> ofreció detalles sobre la conversación mantenida con el expresidente y abordó de lleno las aristas de esta coyuntura.","type":"text"},{"_id":"LQW5VAN5VZHONFD2NDMGYALZWM","content":"Salud “tiene prioridad presupuestaria”, señala Leite tras reunión en residencia de Cartes","type":"interstitial_link","url":"https://www.abc.com.py/politica/2026/09/07/salud-tiene-prioridad-presupuestaria-senala-leite-tras-reunion-en-residencia-de-cartes/"},{"_id":"FFIEVMSUF5DMBC25QYPNKWMD5E","content":"La crisis sanitaria en el centro de la agenda parlamentaria","level":2,"type":"header"},{"_id":"M27THXCPDVBFHOKE2SAKG6WREY","content":"Tras la difusión en redes sociales de un mensaje del cartismo enfocado en que “la salud es la prioridad y se trabajará en el presupuesto”, Leite confirmó que la discusión en la residencia de Cartes giró en torno a la precariedad de insumos en los hospitales estatales.","type":"text"},{"_id":"32BXILZDORF2BODTRXL3WDJJYM","raw_oembed":{"html":"<blockquote class=\"twitter-tweet\"><p lang=\"es\" dir=\"ltr\">🏥 Salud pública será la máxima prioridad y recortarán gastos superfluos para asegurar medicamentos. <br><br>🗣️ &quot;No podemos seguir inyectando fondos a ciegas: la salud de los paraguayos es innegociable&quot;. <br><br>El senador Gustavo Leite anunció que trabajan junto a exministros y exdirectores… <a href=\"https://t.co/gznWAzHyIQ\">pic.twitter.com/gznWAzHyIQ</a></p>&mdash; ABC Cardinal 730 AM (@ABCCardinal) <a href=\"https://x.com/ABCCardinal/status/2097323819161600046?ref_src=twsrc%5Etfw\">September 8, 2026</a></blockquote>\n<script async src=\"https://platform.x.com/widgets.js\" charset=\"utf-8\"><\/script>\n\n","url":"https://x.com/ABCCardinal/status/2097323819161600046"},"type":"oembed_response"},{"_id":"X3OSH3SND5B2TDDCKTVQ5MSBQY","content":"“Nosotros somos Partido Colorado, somos el partido de gobierno. Hay mucha gente en Paraguay que necesita que el Estado le asista en su salud, en medicamentos sobre todo, y vamos a trabajar en eso. Estoy trabajando con exministros de salud y exdirectores del Incan para entender cuánto dinero hace falta. Si seguimos poniendo plata sin saber cuánto se necesita, no habrá resultados”, aseveró el parlamentario.","type":"text"},{"_id":"2QWECS7LJBFF7FSNCTXA66XBSA","content":"Renuncias de médicos: Senado creará comisión especial para atender crisis sanitaria","type":"interstitial_link","url":"https://www.abc.com.py/politica/2026/09/07/renuncias-de-medicos-senado-creara-comision-especial-para-atender-crisis-sanitaria/"},{"_id":"HWRNZKG4JBHHTKARBVUCRM765A","content":"El legislador cuestionó con dureza el modelo de gestión del <b>Ministerio de Salud Pública</b> y apuntó a distorsiones presupuestarias e incoherencias entre la ejecución de fondos y las millonarias deudas con la industria farmacéutica.","type":"text"},{"_id":"2NG37KJIEZDSTL5J76UJAA7XII","caption":"Gustavo Leite cuestionó con dureza el modelo de gestión del Ministerio de Salud Pública, encabezado por María Teresa Barán.","credits":{"by":[{"name":"ABC TV","type":"author"}]},"resized_urls":{"1080x1270":"https://www.abc.com.py/resizer/v2/2NG37KJIEZDSTL5J76UJAA7XII.jpg?auth=6719de71df4b50bb71b3f4599e6a49174eb43286f07bfe666435ac87468f5a0c&width=1080&height=1270&smart=true","110x70":"https://www.abc.com.py/resizer/v2/2NG37KJIEZDSTL5J76UJAA7XII.jpg?auth=6719de71df4b50bb71b3f4599e6a49174eb43286f07bfe666435ac87468f5a0c&width=110&height=70&smart=true","1140x663":"https://www.abc.com.py/resizer/v2/2NG37KJIEZDSTL5J76UJAA7XII.jpg?auth=6719de71df4b50bb71b3f4599e6a49174eb43286f07bfe666435ac87468f5a0c&width=1140&height=663&smart=true","115x115":"https://www.abc.com.py/resizer/v2/2NG37KJIEZDSTL5J76UJAA7XII.jpg?auth=6719de71df4b50bb71b3f4599e6a49174eb43286f07bfe666435ac87468f5a0c&width=115&height=115&smart=true","1200x1080":"https://www.abc.com.py/resizer/v2/2NG37KJIEZDSTL5J76UJAA7XII.jpg?auth=6719de71df4b50bb71b3f4599e6a49174eb43286f07bfe666435ac87468f5a0c&width=1200&smart=true","1280x720":"https://www.abc.com.py/resizer/v2/2NG37KJIEZDSTL5J76UJAA7XII.jpg?auth=6719de71df4b50bb71b3f4599e6a49174eb43286f07bfe666435ac87468f5a0c&width=1280&height=720&smart=true","1300x900":"https://www.abc.com.py/resizer/v2/2NG37KJIEZDSTL5J76UJAA7XII.jpg?auth=6719de71df4b50bb71b3f4599e6a49174eb43286f07bfe666435ac87468f5a0c&width=1300&height=900&smart=true","140x191":"https://www.abc.com.py/resizer/v2/2NG37KJIEZDSTL5J76UJAA7XII.jpg?auth=6719de71df4b50bb71b3f4599e6a49174eb43286f07bfe666435ac87468f5a0c&width=140&height=191&