IN \n\n00:00:07.340 --> 00:00:08.541 align:start line:69% position:10% size:75%\nBALLOTS, A JUDGE BLOCKING THE \n\n00:00:08.541 --> 00:00:09.943 align:start line:69% position:10% size:73%\nPRESIDENT'S LATEST EFFORT TO \n\n00:00:09.943 --> 00:00:11.378 align:start line:69% position:10% size:60%\nRESTRICT VOTING BY MAIL.\n\n00:00:11.378 --> 00:00:13.680 align:start line:69% position:10% size:78%\nTHE TEMPORARY ORDER BLOCKS THE \n\n00:00:13.680 --> 00:00:15.215 align:start line:69% position:10% size:78%\nPOSTAL SERVICE FROM INCREASING \n\n00:00:15.215 --> 00:00:18.451 align:start line:69% position:10% size:65%\nITS OVERNIGHT OF MAIL INN \n\n00:00:18.451 --> 00:00:18.952 align:start line:69% position:10% size:18%\nVOTING.\n\n00:00:18.952 --> 00:00:20.320 align:start line:69% position:10% size:80%\nTHE JUDGE SAYING THE NEW RULE IS\n\n00:00:20.320 --> 00:00:21.855 align:start line:69% position:10% size:78%\nLIKELY UNCONSTITUTIONAL AND IT \n\n00:00:21.855 --> 00:00:23.123 align:start line:69% position:10% size:80%\nWOULD BE PRACTICALLY IMPOSSIBLE \n\n00:00:23.123 --> 00:00:24.224 align:start line:69% position:10% size:78%\nFOR STATES TO COMPLY WITH THIS \n\n00:00:24.224 --> 00:00:26.326 align:start line:69% position:10% size:63%\nFOR THE UPCOMING MIDTERM \n\n00:00:26.326 --> 00:00:28.595 align:start line:69% position:10% size:80%\nELECTIONS WITH THE FIRST MAIL-IN\n\n00:00:28.595 --> 00:00:29.763 align:start line:69% position:10% size:80%\nBALLOTS SET TO THE MAILED OUT IN\n\n00:00:29.763 --> 00:00:30.830 align:start line:69% position:10% size:28%\nJUST WEEKS.\n\n00:00:30.830 --> 00:00:31.381 align:start line:69% position:10% size:35%\nTHIS BATTLE IS\n"},"alertTag":"40392639","sectionRoot":"GMA","adFlag":true,"noAds":false,"isAmbient":false,"sponsored":false,"hideDate":false,"hideReportTypo":false,"defaultPlaylistID":"2808950","ads":{"tags":["SoftNews/Politics"]},"classification":"Shows - Clips"},"featuredImage":null,"dateline":"","seo":{},"LivePromotion":{},"PersonalizedRec