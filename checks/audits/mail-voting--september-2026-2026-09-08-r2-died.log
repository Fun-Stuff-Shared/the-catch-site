le":false,"modules":[{"name":"adTopBanner","source":null,"canChangeLayout":false,"canChangeSource":false,"serverRenderPolicy":null,"attributes":{},"options":null,"data":{"__typename":"asset"},"__typename":"module"}],"__typename":"column"}],"__typename":"layout"},{"editable":true,"columns":[{"span":"full","editable":true,"modules":[{"name":"articleHeader","source":"108359331","canChangeLayout":false,"canChangeSource":false,"serverRenderPolicy":null,"attributes":{"isSpecialReport":false},"options":{},"data":{"id":108359331,"brand":"cnbc","contentClassification":[],"type":"wirestory","url":"https:\u002F\u002Fwww.cnbc.com\u002F2026\u002F09\u002F06\u002Ftrump-supreme-court-appeal-mail-in-ballots.html","native":false,"premium":false,"datePublished":"2026-09-06T15:55:51+0000","dateModified":"2026-09-06T15:55:51+0000","dateLastPublished":"2026-09-06T15:55:51+0000","datePublishedFormatted":"Published Sun, Sep 6 2026 • 11:55 AM EDT","dateLastPublishedFormatted":null,"deck":null,"description":"The filing came after a U.S. District Court judge extended an order against the Postal Service enforcing an executive order for the November elections.","socialtoolsEnabled":true,"shortestHeadline":null,"headline":"Trump administration makes another appeal to the Supreme Court to allow mail-in ballot restrictions","title":"Trump administration makes another appeal to the Supreme Court to allow mail-in ballot restrictions","jobTitle":null,"socialMediaInfo":null,"sourceOrganization":[{"id":80000009,"type":"source","url":"https:\u002F\u002Fwww.cnbc.com\u002Fsearch\u002F?query=The%20Associated%20Press","name":"The Associated Press","logo":"https:\u002F\u002Ffm.cnbc.com\u002Fapplications\u002Fcnbc.com\u002Fresources\u002Fsource_logo\u002F2018\u002F04\u002F16\u002F133322893-byline-ap.png","creatorOverwrite":null,"__typename":"source"}],"creatorOverwrite":null,"author":[],"featuredAudio":[],"promoImage":{"id":108275626,"url":"https:\u002F\u002Fimage.cnbcfm.com\u002Fapi\u002Fv1\u002Fimage\u002F108275626-1773082484367-108275626-1773082180739-gettyimages-1229157705-AFP_8TD6HK.jpg?v=1773082522","caption":"People deposit their mail-in ballots for the US presidential election at a ballot collection box in Phoenix, Arizona on October 18, 2020.","__typename":"infographic"},"featuredMedia":null,"publisher":{"name":"CNBC","logo":"https:\u002F\u002Fsc.cnbcfm.com\u002Fapplications\u002Fcnbc.com\u002Fstaticcontent\u002Fimg\u002Fcnbc-hdr-logo2.png","__typename":"publisher"},"section":{"id":10000113,"brand":"cnbc","type":"franchise","color":null,"name":"Politics & Policy","eyebrow":"Politics & Policy","shortestHeadline":"Politics & Policy","url":"https:\u002F\u002Fwww.cnbc.com\u002Fpolitics\u002F","subType":"section","section":{"subType":"section","__typename":"franchise"},"image":null,"logo":null,"__typename":"franchise"},"upNext":null,"__typename":"articleHeader"},"__typename":"module"}],"__typename":"column"}],"__typename":"layout"},{"editable":true,"columns":[{"span":"9","editable":true,"modules":[{"name":"articleInlineMedia","source":"108359331","canChangeLayout":false,"canChangeSource":false,"serverRenderPolicy":null,"attributes":{},"options":{},"data":{"id":108359331,"brand":"cnbc","section":{"id":10000113,"color":null,"__typename":"franchise"},"featuredMedia":null,"__typename":"articleInlineMedia"},"__typename":"module"},{"name":"keyPoints","source":"108359331","canChangeLayout":false,"canChangeSource":false,"serverRenderPolicy":null,"attributes":{},"options":{},"data":{"id":108359331,"brand":"cnbc","keyPoints":[],"section":{"id":10000113,"color":null,"__typename":"franchise"},"__typename":"keyPoints"},"__typename":"module"},{"name":"articleBody","source":"108359331","canChangeLayout":false,"canChangeSource":false,"serverRenderPolicy":null,"attributes":{},"options":{},"data":{"id":108359331,"type":"wirestory","brand":"cnbc","articleBodyText":"The Trump administration on Sunday renewed its appeal to the Supreme Court after a federal judge blocked new restrictions on mail ballots ahead of the midterms. The filing came after U.S. District Court Judge Indira Talwani extended an order against the Postal Service enforcing President Donald Trump's executive order for the November elections. The legal wrangling comes even as states start sending out mail ballots, leaving the administration little time to make big changes in mail ballot rules. \"Ballots have already begun to be mailed in North Carolina, and more States will begin the mailing process as the injunction remains in place — including Alabama on September 9 and at least five States the week of September 13,\" Solicitor General John Sauer said in the filing. \"Once those ballot envelopes enter the mailstream, there is no retrieving them. And while the injunction allows the Postal Service and the States to continue taking steps to ensure that their envelopes satisfy the Rule's requirements ... each day the injunction is in place risks sowing confusion and chaos because the injunction makes those preparatory steps voluntary, rather than mandatory.\" The appeal marks the third time the administration has asked the high court to intervene. The high court has allowed the plan to move forward but not ruled on whether it is legal. The battle could have major ramifications for this year's elections, when control of Congress is at stake. Nearly one-third of voters in the U.S. cast mail ballots. Democratic states and voting rights groups say the changes are unconstitutional. Election officials contend they don't have enough time to revise their systems to comply with the new Postal Service directives. The Trump administration has framed the restrictions as commonsense changes that are within its power to regulate the mail. \"Simply put, the best way to address respondents' fears about inability to comply with the Rule is to grant an immediate administrative stay of the order, followed by a full stay pending further review,\" Sauer said. \"That will remove the improper cloud of uncertainty that the district court has cast over the Rule, making clear to all involved that compliance with the Rule is not optional and must start without further delay.\" The filing added that eligibility for mail-in and absentee voting will continue to be governed by state law, and state and local officials will determine who is eligible to use the method and which ballots are eligible to be counted. \"The Postal Service will not play any role in determining voter eligibility, maintaining voter rolls, or counting ballots.\" Trump has long sought to limit mail voting, even though he himself often uses that method to cast his own ballot. He has falsely blamed mail balloting for his 2020 election loss to Democrat Joe Biden , spreading baseless claims of fraud. But so far, he has been unable to change the longstanding voting procedure.","contentClassification":[],"faqContent":null,"premium":false,"section":{"id":10000113,"color":null,"__typename":"franchise"},"native":false,"creatorOverwrite":null,"sourceOrganization":[{"id":80000009,"url":"https:\u002F\u002Fwww.cnbc.com\u002Fsearch\u002F?query=The%20Associated%20Press","name":"The Associated Press","logo":"https:\u002F\u002Ffm.cnbc.com\u002Fapplications\u002Fcnbc.com\u002Fresources\u002Fsource_logo\u002F2018\u002F04\u002F16\u002F133322893-byline-ap.png","creatorOverwrite":null,"linkHeadline":"The Associated Press","__typename":"source"}],"body":{"content":[{"tagName":"image","attributes":{"id":"108275626","type":"image","creatorOverwrite":"Robyn Beck | Afp | Getty Images","headline":"GP: Maricopa County Arizona Drop Off Ballot Box 2020: US-vote-politics","url":"https:\u002F\u002Fimage.cnbcfm.com\u002Fapi\u002Fv1\u002Fimage\u002F108275626-1773082484367-108275626-1773082180739-gettyimages-1229157705-AFP_8TD6HK.jpg?v=1773082522","datePublished":"2026-03-09T18:50:09+0000","caption":"People deposit their mail-in ballots for the US presidential election at a ballot collection box in Phoenix, Arizona on October 18, 2020.","copyrightHolder":"Robyn Beck | Afp | Getty Images","width":"3875","height":"2433","altText":"People deposit their mail-in ballots for the US presidential election at a ballot collection box in Phoenix, Arizona on October 18, 2020. - Arizona is one of the eight critical swing states, along with Florida, Georgia, Michigan, Minnesota,  North Carolina, Pennsylvania and Wisconsin that will determine the outcome of the November 3 U.S. presidential election between Democratic challenger Joe Biden and President Donald Trump. (Photo by Robyn Beck \u002F AFP) (Photo by ROBYN BECK\u002FAFP via Getty Images)"},"data":{"__typename":"image"},"children":[],"__typename":"bodyContent"},{"tagName":"div","attributes":{"className":["group"]},"data":{"__typename":"asset"},"children":[{"tagName":"p","children":["The Trump administration on Sunday renewed its appeal to the Supreme Court after a federal judge blocked new restrictions on mail ballots ahead of the midterms."]},{"tagName":"p","children":["The filing came after U.S. District Court Judge Indira Talwani extended an order against the Postal Service enforcing President ",{"tagName":"a","attributes":{"id":"10000329","href":"https:\u002F\u002Fwww.cnbc.com\u002Fdonald-trump\u002F","type":"person","brand":"cnbc","section":{"subType":"section"},"premium":false,"contentClassification":[]},"children":["Donald Trump's"]}," executive order for the November elections."]},{"tagName":"p","children":["The legal wrangling comes even as states start sending out mail ballots, leaving the administration little time to make big changes in mail ballot rules."]},{"tagName":"p","children":["\"Ballots have already begun to be mailed in North Carolina, and more States will begin the mailing process as the injunction remains in place — including Alabama on September 9 and at least five States the week of September 13,\" Solicitor General John Sauer said in the filing."]},{"tagName":"p","children":["\"Once those ballot envelopes enter the mailstream, there is no retrieving them. And while the injunction allows the Postal Service and the States to continue taking steps to ensure that their envelopes satisfy the Rule's requirements ... each day the injunction is in place risks sowing confusion and chaos because the injunction makes those preparatory steps voluntary, rather than mandatory.\""]},{"tagName":"p","children":["The appeal marks the third time the administration has asked the high court to intervene. The high court has allowed the plan to move forward but not ruled on whether it is legal."]},{"tagName":"p","children":["The battle could have major ramifications for this year's elections, when control of Congress is at stake. Nearly one-third of voters in the U.S. cast mail ballots."]},{"tagName":"p","children":["Democratic states and voting rights groups say the changes are unconstitutional. Election officials contend they don't have enough time to revise their systems to comply with the new Postal Service directives."]},{"tagName":"p","children":["The Trump administration has framed the restrictions as commonsense changes that are within its power to regulate the mail."]},{"tagName":"p","children":["\"Simply put, the best way to address respondents' fears about inability to comply with the Rule is to grant an immediate administrative stay of the order, followed by a full stay pending further review,\" Sauer said. \"That will remove the improper cloud of uncertainty that the district court has cast over the Rule, making clear to all involved that compliance with the Rule is not optional and must start without further delay.\""]},{"tagName":"p","children":["The filing added that eligibility for mail-in and absentee voting will continue to be governed by state law, and state and local officials will determine who is eligible to use the method and which ballots are eligible to be counted. \"The Postal Service will not play any role in determining voter eligibility, maintaining voter rolls, or counting ballots.\""]},{"tagName":"p","children":["Trump has long sought to limit mail voting, even though he himself often uses that method to cast his own ballot. He has falsely blamed mail balloting for his 2020 election loss to Democrat ",{"tagName":"a","attributes":{"id":"10000451","href":"https:\u002F\u002Fwww.cnbc.com\u002Fjoe-biden\u002F","type":"person","brand":"cnbc","section":{"subType":"section"},"premium":false,"contentClassification":[]},"children":["Joe Biden"]},", spreading baseless claims of fraud. But so far, he has been unable to change the longstanding voting procedure."]}],"__typename":"bodyContent"}],"__typename":"body"},"shortestHeadline":null,"featuredMedia":null,"__typename":"articleBody"},"__typename":"module"},{"name":"articleRelatedVideo","source":"108359331","canChangeLayout":false,"canChangeSource":false,"serverRenderPolicy":null,"attributes":{},"options":{},"data":{"id":108359331,"url":"https:\u002F\u002Fwww.cnbc.com\u002F2026\u002F09\u002F06\u002Ftrump-supreme-court-appeal-mail-in-ballots.html","relatedVideo":null,"__typename":"articleRelatedVideo"},"__typename":"module"}],"__typename":"column"},{"span":"3","editable":true,"modules":[{"name":"liveEventModule","source":"106607926","canChangeLayout":false,"canChangeSource":false,"serverRenderPolicy":null,"attributes":{},"options":{"hideOnNonPremium":true,"hideDescription":true,"hideIfPastEvent":true,"hideQuestion":true,"addLinkToProTalks":true},"data":{"id":106607926,"assets":[{"id":108258744,"type":"event","title":"Pro Talks: Investor Shannon Saccocia talks whether geopolitics could upend a market rally in 2026","linkHeadline":null,"additionalMetadata":{},"descriptionStructured":[],"landingPage":null,"startDate":"2026-01-30T15:00:09+0000","endDate":"2026-01-30T15:01:09+0000","promoImage":{"id":108258746,"url":"https:\u002F\u002Fimage.cnbcfm.com\u002Fapi\u002Fv1\u002Fimage\u002F108258746-260121_ProTalks_Saccocia.jpg?v=1769664898","__typename":"infographic"},"__typename":"event"}],"__typename":"liveEventModu