import PayrollChart from "../../../components/PayrollChart.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import "../../../styles/story.css";
import ReadingModes from "../../../components/ReadingModes.astro";
import Cite from "../../../components/Cite.astro";
import SourcedBlock from "../../../components/SourcedBlock.astro";
import StorySources from "../../../components/StorySources.astro";
import StoryState from "../../../components/StoryState.astro";
import DecisionTimeline from "../../../components/story/DecisionTimeline.astro";
import DataTable from "../../../components/story/DataTable.astro";
import { readPublishedState, eventPath } from "../../../lib/state.mjs";
import { event, averages, multipleJobholders, wageGrowth, primeAgeParticipation, u6, chronology, revisionColumns, revisionRows, household, establishment, revisions, septemberPayrollChange, admitted, payrollChanges, october2025Levels, federalEmployment, federalEmploymentChange, yardsticks } from "../../../data/jobs-2026-10-02-september-payrolls-rise-29000.mjs";
const state = readPublishedState().events.get("event-jobs-2026-10-02-september-payrolls-rise-29000") ?? null;
if (state?.status === "merged") return Astro.redirect(eventPath(state.survivor), 301);
const jobs = (n) => Math.abs(n).toLocaleString("en-US");
const prior12Jobs = (averages.prior12 * 1000).toLocaleString("en-US");
