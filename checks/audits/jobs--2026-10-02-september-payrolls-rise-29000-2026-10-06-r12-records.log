near infinite both counter-ring-animated-2-7_t, 2s linear infinite forwards counter-ring-animated-2-7_v"><g transform="translate(-.49 -130.55)" opacity="0" style="animation:2s linear infinite both Ellipse-1-13_o"><path transform="translate(0) rotate(200)" d="m0-50.552v0c27.919 0 50.552 22.633 50.552 50.552s-22.633 50.552-50.552 50.552-50.552-22.633-50.552-50.552 22.633-50.552 50.552-50.552z" fill="none" stroke="#b0b9c1" stroke-dasharray="318" stroke-dashoffset="318" stroke-linecap="round" stroke-width="10" style="animation:2s linear infinite both Path-1-13_da, 2s linear infinite both Path-1-13_do"></path></g><g transform="translate(-.49 -130.55)" opacity="0" style="animation:2s linear infinite both Ellipse-1-14_o"><path transform="translate(0) rotate(-60)" d="m0-50.552c-27.919 0-50.552 22.633-50.552 50.552s22.633 50.552 50.552 50.552 50.552-22.633 50.552-50.552-22.633-50.552-50.552-50.552z" fill="none" stroke="#b0b9c1" stroke-dasharray="318" stroke-dashoffset="230" stroke-linecap="round" stroke-width="10" style="animation:2s linear infinite both Path-1-14_da, 2s linear infinite both Path-1-14_do"></path></g></g><g transform="translate(45.348 45.348) rotate(12.73) scale(.75) translate(.49 130.55)" visibility="hidden" style="animation:2s linear infinite both counter-ring-animated-2-6_t, 2s linear infinite forwards counter-ring-animated-2-6_v"><g transform="translate(-.49 -130.55)" opacity="0" style="animation:2s linear infinite both Ellipse-1-11_o"><path transform="translate(0) rotate(200)" d="m0-50.552v0c27.919 0 50.552 22.633 50.552 50.552s-22.633 50.552-50.552 50.552-50.552-22.633-50.552-50.552 22.633-50.552 50.552-50.552z" fill="none" stroke="#b0b9c1" stroke-dasharray="318" stroke-dashoffset="318" stroke-linecap="round" stroke-width="10" style="animation:2s linear infinite both Path-1-11_da, 2s linear infinite both Path-1-11_do"></path></g><g transform="translate(-.49 -130.55)" opacity="0" style="animation:2s linear infinite both Ellipse-1-12_o"><path transform="translate(0) rotate(-60)" d="m0-50.552c-27.919 0-50.552 22.633-50.552 50.552s22.633 50.552 50.552 50.552 50.552-22.633 50.552-50.552-22.633-50.552-50.552-50.552z" fill="none" stroke="#b0b9c1" stroke-dasharray="318" stroke-dashoffset="230" stroke-linecap="round" stroke-width="10" style="animation:2s linear infinite both Path-1-12_da, 2s linear infinite both Path-1-12_do"></path></g></g></g></svg> </div></div> </section></div> <div class="byline yf-z1ictt"><div class="byline-attr yf-z1ictt"> <div><div class="byline-attr-author yf-z1ictt">  Dave Smith </div> <div class="byline-attr-time-style"> <time class="byline-attr-meta-time" datetime="2026-05-11T20:55:00+00:00" data-timestamp="2026-05-11T20:55:00+00:00">May 11, 2026</time> <span class="byline-attr-mins-read yf-1pgkgts">3 min read</span></div></div></div> <div class="byline-share yf-z1ictt"><div><span class="share-dialog yf-15uzx9j"><div class="menuContainer  yf-1uspju" style="                    " role="presentation">    <button class="tertiary-btn fin-size-medium menuBtn tw-p-1    rounded   highlightWhenExpanded yf-7mptsx" data-ylk="elmt:menu;itc:1;elm:btn;sec:consolidated-share-popup;g:5533a9ec-fbfc-367e-bbcf-f0a8cd0a0df3;slk:share-menu-open" data-yga="{&quot;yLinkElementType&quot;:&quot;menu&quot;,&quot;yLinkElement&quot;:&quot;btn&quot;,&quot;yModuleName&quot;:&quot;consolidated-share-popup&quot;,&quot;yDestinationContentUUID&quot;:&quot;5533a9ec-fbfc-367e-bbcf-f0a8cd0a0df3&quot;,&quot;yLinkText&quot;:&quot;share-menu-open&quot;}" aria-haspopup="true" aria-controls="menu-q6wf2814" tabindex="0" title="Share links" data-testid="share-link" dialogAlignLeftValue="-240px" dialogAlignTopValue="40px" aria-label="Share links"> <div aria-hidden="true" class="icon fin-icon primary-icn sz-x-large  yf-15ilbqr" data-icon-type="ios-share" data-testid="desktop-share-icon"><!-- HTML_TAG_START --><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="m16 5-1.42 1.42-1.59-1.59V16h-1.98V4.83L9.42 6.42 8 5l4-4zm4 5v1