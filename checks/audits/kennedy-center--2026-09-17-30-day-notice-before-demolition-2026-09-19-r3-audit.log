"href":"https://abcnews.com/GMA/Wellness/2-year-twins-conjoined-head-underwent-successful-separation/story?id=136489246","isLabel":false,"redLabel":false,"blueLabel":false,"linkType":""},{"id":"136455180","title":"HIV emergency","href":"https://abcnews.com/International/fiji-declares-national-hiv-emergency-case-numbers-surge/story?id=136527942","isLabel":false,"redLabel":false,"blueLabel":false,"linkType":""}],"isGMA":false,"isGMADistroSection":false},"electionSidebarData":{"enableWidget":false,"widgetData":[]},"electionSubNavData":{"config":{},"dropdownData":{"state-results":{},"primary-schedule":{},"ee-polls":{},"nat-state-results":{},"nat-ee-polls":{"national":true}}},"electionsConfigs":{},"hasGMASponsored":false},"story":{"data":{"url":"https://abcnews.com/Politics/trump-photographed-kennedy-center-demolishedplacard-amid-fight-venues/story?id=136519219","mainComponents":[{"name":"Body","props":{"body":[[{"type":"p","content":["A federal judge on Thursday directed the Trump administration to provide 30 days' notice of any changes in the Kennedy Center's ",{"type":"a","content":["renovation plans"],"attrs":{"href":"https://abcnews.com/Politics/kennedy-center-boards-meeting-exclusively-focus-closure-court/story?id=136454609","target":"_blank","dir":"ltr"}},", \"including but not limited to any 'demolition' of the Center's main building,\" as the jockeying over the future of the performing arts center continued."]},{"type":"p","content":["U.S. District Judge Christopher Cooper made his ruling the afternoon after President ",{"type":"a","content":["Donald Trump"],"attrs":{"href":"https://abcnews.com/alerts/donald-trump","target":"_blank","dir":"ltr"}}," was photographed looking over a placard that appeared to include the words \"Kennedy Center DEMOLISHED\" over what appeared to be an image of a demolition."]},{"type":"p","content":["In a federal court filing Thursday morning, Kennedy Center executive director Matt Floca said the current closure of the main building is only \"temporary,\" set to last for seven days, and will be reevaluated on a weekly basis."," "]},{"type":"inline","content":{"name":"ContentPromo","props":{"cards":[{"headline":"Trump says Kennedy Center could be 'ripped down' if he doesn't get 'recognition'","link":"https://abcnews.com/Politics/trump-kennedy-center-ripped-recognition/story?id=136513298","isGMA":false,"type":"floating","inline":true,"image":null,"indicators":{"contentType":{"key":null,"ref":null,"props":{"icon":{"key":"general-arrowRight","paths":[{"d":"M0 14.398h26.006L17.361 5.42l2.309-2.221L32 16.001 19.67 28.799l-2.309-2.222 8.645-8.976H0v-3.203z","fill":"currentColor","clipRule":null,"fillRule":null}],"viewBox":"0 0 32 32","title":"Arrow Right"},"ariaLabel":null,"size":"1em","viewBox":"0 0 32 32"},"_owner":null}}}],"dividerEnabled":true,"recommendationId":"","recommendationList":"","recommendationMethod":"","trackingTitle":"related articles","type":"callout","style":{"IconsConfig":{"isArray":true,"arrayKey":"cards","propkey":"indicators.contentType","iconPath":"general.arrowRight","elementName":"ContentPromo","exceptionKey":"image"}}},"context":{},"config":{}}},{"type":"inline","content":{"name":"Image","props":{"link":{},"caption":{"credit":"Brendan Smialowski/AFP via Getty Images","text":"President Donald Trump is seen aboard Air Force One after landing at Joint Base Andrews, Maryland on Sept. 16, 2026.","lines":4,"showMoreAriaLabel":"Show More about Image Caption"},"image":{"alt":"","src":"https://i.abcnewsfe.com/a/fb6a84e9-6191-4e09-aeb4-ee4bab75b00c/embed-photo2_1789636664371_hpEmbed_3x2.jpg","loading":"lazy","sources":[{"src":{"x1":"https://i.abcnewsfe.com/a/fb6a84e9-6191-4e09-aeb4-ee4bab75b00c/embed-photo2_1789636664371_hpEmbed_3x2.jpg?w=375","x2":"https://i.abcnewsfe.com/a/fb6a84e9-6191-4e09-aeb4-ee4bab75b00c/embed-photo2_1789636664371_hpEmbed_3x2.jpg?w=750"},"max":414},{"src":{"x1":"https://i.abcnewsfe.com/a/fb6a84e9-6191-4e09-aeb4-ee4bab75b00c/embed-photo2_1789636664371_hpEmbed_3x2.jpg?w=750","x2":"https://i.abcnewsfe.com/a/fb6a84e9-6191-4e09-aeb4-ee4bab75b00c/embed-photo2_1789636664371_hpEmbed_3x2.jpg?w=1500"},"min":415}]},"ratio":"3x2"},"context":{},"config":{"align":"full"}}},{"type":"p","content":["Judge Cooper, in his ruling, ordered the administration to update him on the status of the \"'temporary closure' and emergency repairs\" by next Wednesday."]},{"type":"p","content":["The ruling came as Cooper turned down a request from Ohio Democratic Rep. Joyce Beatty for an emergency hearing in the case, citing the morning's announcement."]},{"type":"inline","content":{"name":"Ad","props":{"ad":{"kvps":{"pos":"fitt-article-inline-outstream-1"},"type":"fitt-article-inline-outstream","className":"fitt-article-inline-outstream"},"placeholders":{"compact":{"ratio":0.5625,"delay":1},"regular":{"ratio":0.5625,"delay":1}}},"context":{},"config":{}}},{"type":"p","content":["The photos of Trump examining the placard were taken Wednesday night through a cabin window on Air Force One by Agence France-Presse photojournalist Brendan Smialowski, who was acting as the pool photographer for White House coverage, as Trump landed at Joint Base Andrews."]},{"type":"p","content":["It was not immediately clear what the full contents of the placard were or how they were generated. The published images don't show the entire placard and the word that appears to be \"DEMOLISHED\" was not entirely visible, cut off as \"DEMOLIS.\""]},{"type":"inline","content":{"name":"Image","props":{"link":{},"caption":{"credit":"Jacquelyn Martin/AP Photo","text":"A sign directs people away from the Kennedy Center, which has been fenced off and closed to the public, Sept. 17, 2026, in Washington.","lines":4,"showMoreAriaLabel":"Show More about Image Caption"},"image":{"alt":"","src":"https://i.abcnewsfe.com/a/604e4800-1fbf-419f-b2e4-c7548c0ce454/kennedy-ctr-1-ap-gmh-260917_1789679256408_hpMain.jpg","loading":"lazy","sources":[{"src":{"x1":"https://i.abcnewsfe.com/a/604e4800-1fbf-419f