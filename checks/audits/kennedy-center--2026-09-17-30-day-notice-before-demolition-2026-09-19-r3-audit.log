1-<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>The judge required notice before a Kennedy Center demolition | The Catch</title><link rel="stylesheet" href="/assets/the-catch.css"><link rel="stylesheet" href="/assets/reader.css"><style>.mode-switcher{border:1px solid var(--rule);border-radius:3px;align-items:center;gap:0;margin:0 0 2rem;display:flex;overflow:hidden}.mode-btn{font-family:var(--sans);color:var(--slate);cursor:pointer;border:none;border-right:1px solid var(--rule);background:0 0;padding:.55rem 1.1rem;font-size:.82rem;font-weight:600;text-decoration:none;transition:background .15s,color .15s}.mode-btn:last-of-type{border-right:none}.mode-btn:hover{background:var(--blue-tint);color:var(--ink)}.mode-btn.active{background:var(--ink);color:#fff}.mode-hint{font-family:var(--sans);color:var(--slate);white-space:nowrap;margin-left:auto;padding:0 1rem;font-size:.78rem}@media (width<=640px){.mode-switcher{grid-template-columns:repeat(3,minmax(0,1fr));display:grid}.mode-btn{text-align:center;justify-content:center;align-items:center;min-height:44px;padding:.65rem .3rem;font-size:.72rem;display:flex}.mode-hint{display:none}}#story-root [data-layer=proof],#story-root.mode-facts [data-layer=narrative],#story-root:not(.mode-facts):not(.mode-work) .sourced-block.detail{display:none}#story-root.mode-work [data-layer=proof]{display:revert}#story-root.mode-work .receipt{display:block}#story-root [data-layer]{transition:opacity .15s}
