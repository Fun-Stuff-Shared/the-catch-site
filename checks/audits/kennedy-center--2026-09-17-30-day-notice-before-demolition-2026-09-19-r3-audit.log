ata-g-r=base_si href="https://x.com/intent/post?url=https%3A%2F%2Fwww.usatoday.com%2Fstory%2Fnews%2Fpolitics%2F2026%2F09%2F17%2Fkennedy-center-demolition-trump-judge-notice%2F91811453007%2F&text=Judge%20orders%20Trump%20to%20give%2030-day%20notice%20before%20any%20demolition%20of%20Kennedy%20Center&via=usatoday"><svg class=gnt_ss_a_svg><use xlink:href=#gnt_svg_share_twitter /></svg></a><a class=gnt_ss_a data-t-l=:h|v|c|email aria-label="Share by email" href="mailto:?subject=Judge%20orders%20Trump%20to%20give%2030-day%20notice%20before%20any%20demolition%20of%20Kennedy%20Center%20-%20from%20USA%20TODAY&body=Judge%20orders%20Trump%20to%20give%2030-day%20notice%20before%20any%20demolition%20of%20Kennedy%20Center%0A%0AA%20federal%20judge%20ordered%20the%20Kennedy%20Center%20provide%20a%2030-day%20notice%20before%20any%20demolition%20or%20other%20major%20changes%20to%20the%20center%20can%20begin.%0A%0ACheck%20out%20this%20story%20on%20usatoday.com%3A%20https%3A%2F%2Fwww.usatoday.com%2Fstory%2Fnews%2Fpolitics%2F2026%2F09%2F17%2Fkennedy-center-demolition-trump-judge-notice%2F91811453007%2F"><svg class=gnt_ss_a_svg><use xlink:href=#gnt_svg_share_email /></svg></a><button class="gnt_ss_a gnt_ss_a__sa" data-ss-a=s data-t-l=:h|v|c|shareapi aria-label="Share natively" data-g-r=base_si><svg class=gnt_ss_a_svg><use xlink:href=#gnt_svg_shareapi /></svg></button></div></div><div class=gnt_ar_b><aside aria-label=advertisement class="gnt_x__c gnt_x__lbl gnt_x__bv"><div data-g-r=lazy data-gl-method=llx id=~ad-slot-7103-usatoday-banner_videoplayer-news-politics-2-ac1 class="gnt_x_sl gnt_x_bv"></div></aside><aside aria-label=advertisement class="gnt_x__c gnt_x__bvd gnt_x__h"><div id=ad-slot-7103-usatoday-banner_videoplayer-dk-news-politics-3-ac1 class="gnt_x_sl gnt_x_bvd"></div></aside><aside class="gnt_em gnt_em__fp gnt_em_vp__tp gnt_em__el" aria-label="Video - Trump says Kennedy Center could be 'ripped down' without his support"><div class=gnt_em_vp_w data-g-r=vp_tp data-c-vt=exco data-c-vpa="pl=teal-hero&nm=1&exv=article_hero&de&plcmt=2&cc=news/politics/1&iu=/7103/usatoday/preroll_video/&cut" data-c-vpd="{&#34;adsEnabled&#34;:true,&#34;awsPath&#34;:&#34;news/politics&#34;,&#34;byline&#34;:&#34;Connor Ling&#34;,&#34;cd&#34;:1789601735671,&#34;credit&#34;:&#34;&#34;,&#34;length&#34;:32,&#34;headline&#34;:&#34;Trump says Kennedy Center could be 'ripped down' without his support&#34;,&#34;hlsURL&#34;:&#34;https://hlsmedia.gannett-cdn.com/authoring/videos/presto/renditions/91801034007/93add872-6abe-449d-805a-6028d45d7e6a/480p_30fps,720p_30fps,1080p_30fps,master.m3u8?subtitles=91801034007&#34;,&#34;id&#34;:&#34;91801034007&#34;,&#34;keywords&#34;:&#34;Vertical Video,VPC - Video Analytics,Politics,Executive Branch,Donald Trump,Overall Negative&#34;,&#34;mp4URL&#34;:&#34;https://www.gannett-cdn.com/authoring/videos/presto/renditions/91801034007/93add872-6abe-449d-805a-6028d45d7e6a/1080p_30fps.mp4&#34;,&#34;origin&#34;:&#34;Reuters&#34;,&#34;pageURL&#34;:{&#34;long&#34;:&#34;https://www.usatoday.com/videos/news/politics/2026/09/16/trump-says-kennedy-center-could-be-ripped-down-if-demands-not-met/91801034007/&#34;},&#34;promoBrief&#34;:&#34;President Trump said the Kennedy Center could be torn down without the support of his administration.&#34;,&#34;propertyName&#34;:&#34;USATODAY&#34;,&#34;series&#34;:&#34;&#34;,&#34;ssts&#34;:{&#34;section&#34;:&#34;news&#34;,&#34;subsection&#34;:&#34;politics&#34;,&#34;topic&#34;:&#34;&#34;,&#34;subtopic&#34;:&#34;&#34;},&#34;title&#34;:&#34;Trump says Kennedy Center could be ‘ripped down’ if demands not met&#34;,&#34;tna&#34;:[&#34;Vertical Video&#34;,&#34;VPC - Video Analytics&#34;,&#34;Politics&#34;,&#34;Executive Branch&#34;,&#34;Donald Trump&#34;,&#34;Overall Negative&#34;],&#34;videoStill&#34;:&#34;https://www.gannett-cdn.com/authoring/authoring-images/2026/09/16/USAT/91800936007-trump-kenney-center-mp-400-01-02-16-still-001.png?crop=607,1079,x576,y0&#34;}"><div class=gnt_em_vp_c><button class=gnt_em_vp_db aria-label="Close docked video player"><svg class=gnt_em_vp_db_svg viewBox="0 0 16 16"><path d="M9 7.625L13.125 3.5 14.5 4.875 10.375 9l4.125 4.125-1.375 1.375L9 10.375 4.875 14.5 3.5 13.125 7.625 9 3.5 4.875 4.875 3.5 9 7.625z"/></svg></button><div class=gnt_em_vp_c_pl__ec><div id=gnt_xp__1 class=pbs><div class=pbs__player><div class=pb-stream><div class=__exco_root_container><div class=__exco_content_container><video class=__exco_content_video poster="/gcdn/authoring/authoring-images/2026/09/17/USAT/91813152007-20260917-t-171022-z-1306150901-rc-24-lna-3-fscc-rtrmadp-3-usatrumpkennedycenter.JPG?crop=5782,3253,x0,y0&width=660&height=371&format=pjpg&auto=webp" muted playsinline elementtiming=ar-lead-video-exco data-g-r="vp_ap vp_tg" disablepictureinpicture></video></div></div></div></div></div></div></div></div><div class=gnt_em_vh data-c-et="Trump says Kennedy Center could be 'ripped down' without his support"></div><div class="gnt_em_vb gnt_em_vb__he" aria-label="President Trump said the Kennedy Center could be torn down without the support of his administration."></div></aside><p class=gnt_ar_b_p>WASHINGTON − A federal judge effectively blocked <a href=/news/politics/donald-trump/ data-t-l=:b|e|k|⚑u class=gnt_ar_b_a>President Donald Trump</a> from taking immediate action to <a href=/story/news/politics/2026/09/16/trump-kennedy-center-ripped-down-renovations/91802015007/ data-t-l=:b|e|k|⚑u class=gnt_ar_b_a>demolish the Kennedy Center</a>, ordering on Sept. 17 that the center provide a 30-day notice to plaintiffs before any demolition or other major changes to the center's main building can begin.</p><p class=gnt_ar_b_p>It means the legality of any attempt to demolish the Kennedy Center ‒ which Trump has argued is <a href=/story/news/politics/2026/08/25/trump-kennedy-center-cannot-be-saved-without-his-name/91462772007/ data-t-l=:b|e|k|⚑u class=gnt_ar_b_a>necessary without substantial renovations</a> ‒ would likely be subject to the judge's review during the 30-day period.</p><p class=gnt_ar_b_p>U.S. District Court Judge Christopher Cooper ordered the 30-day notice as he denied a request from Rep. Joyce Beatty ‒ the plaintiff suing Trump over the center ‒ for an emergency hearing. Beatty, a Democratic congresswoman from Ohio who serves on the board, is seeking the court's intervention to block the Kennedy Center board's vote this week to close the center for renovations.</p><aside class=gnt_ar_b_sp>More: <a href=/story/news/politics/2026/09/16/trump-kennedy-center-ripped-down-renovations/91802015007/ rel="noreferrer noopener" target=_blank data-t-l=":b|e|spike click:4|⚑u" class=gnt_ar_b_sp_a>Trump says Kennedy Center could be 'ripped down' without his overhaul</a></aside><figure class="gnt_em gnt_em_img"><img class=gnt_em_img_i style=height:440px fetchpriority=high data-g-r=lazy data-gl-src="/gcdn/authoring/authoring-images/2026/09/17/USAT/91813152007-20260917-t-171022-z-1306150901-rc-24-lna-3-fscc-rtrmadp-3-usatrumpkennedycenter.JPG?width=660&height=440&fit=crop&format=pjpg&auto=webp" data-gl-srcset="/gcdn/authoring/authoring-images/2026/09/17/USAT/91813152007-20260917-t-171022-z-1306150901-rc-24-lna-3-fscc-rtrmadp-3-usatrumpkennedycenter.JPG?width=1320&height=880&fit=crop&format=pjpg&auto=webp 2x" decoding=async alt="Workers replace parts of a temporary fence at the Kennedy Center, which was ordered to be closed for repairs by its board, in Washington, D.C., US, September 17, 2026."/><div class="gnt_em_img_ccw gnt_em_img_ccw__cap gnt_em_img_ccw__crd" data-c-caption="Workers replace parts of a temporary fence at the Kennedy Center, which was ordered to be closed for repairs by its board, in Washington, D.C., US, September 17, 2026. " data-c-credit="Jonathan Ernst, REUTERS"></div></figure><p class=gnt_ar_b_p>Instead, the judge ordered the Trump-aligned Kennedy Center to submit a sworn declaration from a knowledgeable representative of the center who can attest to the emergency repairs that necessitated the closure. Justice Department attorneys argued <a href=/story/news/politics/2026/09/17/kennedy-center-closure-one-week-trump-renovations/91807757007/ data-t-l=:b|e|k|⚑u class=gnt_ar_b_a>in a court filing Sept. 17</a> that the closure is "temporary" to address emergency repairs, not to begin a two-year renovation project Trump has pushed.</p><aside aria-label=advertisement class="gnt_x__c gnt_x__lbl gnt_x__al"><div data-g-r=lazy data-gl-method=llx id=~ad-slot-7103-usatoday-native-article_link-news-politics-4-ac1 class="gnt_x_sl gnt_x_al"></div></aside><aside class=gnt_ar_b_sp>More: <a href=/story/news/politics/2026/09/17/kennedy-center-closure-one-week-trump-renovations/91807757007/ rel="noreferrer noopener" target=_blank data-t-l=":b|e|spike click:8|⚑u" class=gnt_ar_b_sp_a>Kennedy Center's current closure is only 'temporary,' DOJ says</a></aside><p class=gnt_ar_b_p>Trump and Kennedy Center officials aligned with the president say the center's poor condition poses safety concerns for visitors that require significant renovations, which Trump has said he would help pay for.</p><p class=gnt_ar_b_p>But Trump wants recognition in return for his financial support. Trump has <a href=/story/news/politics/2026/09/15/kennedy-center-votes-to-immediately-close-trump-renovations/91778454007/ data-t-l=:b|e|k|⚑u class=gnt_ar_b_a>warned that he won't pursue renovations</a> to the Kennedy Center unless a separate decision from Cooper this week keeping Trump's name off the center's building is overturned on appeal.</p><aside aria-label=advertisement class="gnt_x__c gnt_x__lbl gnt_x__al"><div data-g-r=lazy data-gl-method=llx id=~ad-slot-7103-usatoday-native-article_link-news-politics-5-ac2 data-x-c=2 class="gnt_x_sl gnt_x_al"></div></aside><p class=gnt_ar_b_p>Cooper ruled the Kennedy Center's plan to add an inscription below the center's sign that says "renovated and restored by Donald J. Trump" cannot move forward. The judge said the inscription violates his previous order in May to remove Trump's name from the center's title and signage and violates the 1964 law that created the center to honor President Kennedy after his assassination.</p><figure class="gnt_em gnt_em_img"><img class=gnt_em_img_i style=height:444px fetchpriority=high data-g-r=lazy data-gl-src="/gcdn/authoring/authoring-images/2026/09/16/USAT/91790500007-20250317-t-203643-z-2042623554-rc-28-fdac-4-dr-0-rtrmadp-3-usatrump.JPG?width=660&height=444&fit=crop&format=pjpg&auto=webp" data-gl-srcset="/gcdn/authoring/authoring-images/2026/09/16/USAT/91790500007-20250317-t-203643-z-2042623554-rc-28-fdac-4-dr-0-rtrmadp-3-usatrump.JPG?width=1320&height=888&fit=crop&format=pjpg&auto=webp 2x" decoding=async alt="President Donald Trump speaks to the media after attending a board meeting at the Kennedy Center, in Washington, D.C., U.S., March 17, 2025."/><div class="gnt_em_img_ccw gnt_em_img_ccw__cap gnt_em_img_ccw__crd" data-c-caption="President Donald Trump speaks to the media after attending a board meeting at the Kennedy Center, in Washington, D.C., U.S., March 17, 2025. " data-c-credit="Carlos Barria, REUTERS"></div></figure><p class=gnt_ar_b_p>Without renovations, Trump told reporters on Sept. 16 that the Kennedy Center will <a href=/story/news/politics/2026/09/16/trump-kennedy-center-ripped-down-renovations/91802015007/ data-t-l=:b|e|k|⚑u class=gnt_ar_b_a>"end up being ripped down"</a> because of its dilapidated state. The same day, Trump was pictured through a window on Air Force One reading a poster that says, <a href=/story/news/politics/2026/09/17/trump-kennedy-center-demolished-poster-photos/91806101007/ data-t-l=:b|e|k|⚑u class=gnt_ar_b_a>"Kennedy Center DEMOLISHED."</a></p><aside class=gnt_ar_b_sp>More: <a href=/story/news/politics/2026/09/17/trump-kennedy-center-demolished-poster-photos/91806101007/ rel="noreferrer noopener" target=_blank data-t-l=":b|e|spike click:15|⚑u" class=gnt_ar_b_sp_a>Photos capture Trump reading 'Kennedy Center DEMOLISHED' poster</a></aside><aside class="gnt_em gnt_em_anc" id=gnt_atomsnc data-g-r=lazy data-gl-method=loadAnc aria-label="Newsletter signup form"></aside><p class=gnt_ar_b_p>Beatty's attorneys cited both examples in a court filing as evidence that Trump is actively considering the demolition of the Kennedy Center. They asked the judge to clarify that his order issued in May ‒ which blocked a previous attempt to close the Kennedy Center ‒ also prohibits its demolition.</p><p class=gnt_ar_b_p>"Closure is both a prelude to and the necessary consequence of demolition," Beatty's attorneys wrote. "But out of anabundance of caution, Plaintiff also respectfully requests the Court to make crystal clear that its order prohibits demolishing the structure."</p><aside aria-label=advertisement class="gnt_x__c gnt_x__lbl gnt_x__al"><div data-g-r=lazy data-gl-method=llx id=~ad-slot-7103-usatoday-native-article_link-news-politics-6-ac3 data-x-c=3 class="gnt_x_sl gnt_x_al"></div></aside><p class=gnt_ar_b_p><em>Reach Joey Garrison on X @joeygarrison.</em></p></div><div class=gnt_ss data-g-r=base_sc data-ss-u=https://www.usatoday.com/story/news/politics/2026/09/17/kennedy-center-demolition-trump-judge-notice/91811453007/ data-ss-t="Judge orders Trump to give 30-day notice before any demolition of Kennedy Center" data-ss-d="A federal judge ordered the Kennedy Center provide a 30-day notice before any demolition or other major changes to the center can begin."><a class=gnt_ss_a data-ss-a=f data-t-l=:i|v|c|facebook aria-label="Share to Facebook" rel=noreferrer data-g-r=base_si href="https://www.facebook.com/dialog/share?display=popup&app_id=1279862243338849&href=https%3A%2F%2Fwww.usatoday.com%2Fstory%2Fnews%2Fpolitics%2F2026%2F09%2F17%2Fkennedy-center-demolition-trump-judge-notice%2F91811453007%2F"><svg class=gnt_ss_a_svg><use xlink:href=#gnt_svg_share_facebook /></svg></a><a class=gnt_ss_a data-ss-a=t data-t-l=:i|v|c|twitter aria-label="Share to Twitter" rel=noreferrer data-g-r=base_si href="https://x.com/intent/post?url=https%3A%2F%2Fwww.usatoday.com%2Fstory%2Fnews%2Fpolitics%2F2026%2F09%2F17%2Fkennedy-center-demolition-trump-judge-notice%2F91811453007%2F&text=Judge%20orders%20Trump%20to%20give%2030-day%20notice%20before%20any%20demolition%20of%20Kennedy%20Center&via=usatoday"><svg class=gnt_ss_a_svg><use xlink:href=#gnt_svg_share_twitter /></svg></a><a class=gnt_ss_a data-t-l=:i|v|c|email aria-label="Share by email" href="mailto:?subject=Judge%20orders%20Trump%20to%20give%2030-day%20notice%20before%20any%20demolition%20of%20Kennedy%20Center%20-%20from%20USA%20TODAY&body=Judge%20orders%20Trump%20to%20give%2030-day%20notice%20before%20any%20demolition%20of%20Kennedy%20Center%0A%0AA%20federal%20judge%20ordered%20the%20Kennedy%20Center%20provide%20a%2030-day%20notice%20before%20any%20demolition%20or%20other%20major%20changes%20to%20the%20center%20can%20begin.%0A%0ACheck%20out%20this%20story%20on%20usatoday.com%3A%20https%3A%2F%2Fwww.usatoday.com%2Fstory%2Fnews%2Fpolitics%2F2026%2F09%2F17%2Fkennedy-center-demolition-trump-judge-notice%2F91811453007%2F"><svg class=gnt_ss_a_svg><use xlink:href=#gnt_svg_share_email /></svg></a><button class="gnt_ss_a gnt_ss_a__sa" data-ss-a=s data-t-l=:i|v|c|shareapi aria-label="Share natively" data-g-r=base_si><svg class=gnt_ss_a_svg><use xlink:href=#gnt_svg_shareapi /></svg></button></div><div class="gnt_tb gnt_tbb" data-g-r=lazy data-gl-method=llx><div id=gnt_tbw_1></div></div><div data-g-r=lazy data-gl-method=flp class=gnt_flp><div class="gnt_m_dl flipp-ux-header gnt_flp_t" aria-label="Featured Weekly Ad">Featured Weekly Ad</div></div></article><div class=gnt_rr><div class="gnt_x__c gnt_rr_xpst"><aside aria-label=advertisement class="gnt_x__lbl gnt_x__pf"><div id=ad-slot-7103-usatoday-poster-news-politics-7-ac1 class="gnt_x_sl gnt_x_p"></div></aside></div><form class="gnt_m gnt_m_nls" data-g-r=base_sp onmousedown=event.stopPropagation() onmouseup=event.stopPropagation() onsubmit="g$.el.nfsh(event, this)" data-c-nlsbc=8872UT-E-NLETTER02 data-c-nlt="Daily Briefing, in your inbox" da