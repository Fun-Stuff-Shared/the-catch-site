---
const { presentation } = Astro.props;
---
<aside class="rail">
  <section>
    <h2>Provenance</h2>
    <dl class="kv">
      <div><dt>Source</dt><dd>{presentation.sourceLabel}<span class="doc-title">{presentation.documentTitle}</span>{presentation.sourceUrl && <a href={presentation.sourceUrl}>Open source document</a>}</dd></div>
      {presentation.archiveCapture && <div><dt>Archive capture</dt><dd class="nw">Archive capture held in record custody, dated {presentation.archiveCapture.date}</dd></div>}
      <div><dt>Record tier</dt><dd><span class="tier-chip">{presentation.tierLabel}</span></dd></div>
      <div><dt>Event date</dt><dd class="nw">{presentation.eventDate}</dd></div>
      <div><dt>Method</dt><dd><a href="/methodology">Methodology</a></dd></div>
    </dl>
  </section>
  {presentation.history.length > 0 && <section>
    <h2>Record history</h2>
    <ol class="ledger">
      {presentation.history.map((entry) => <li class={entry.status === "Corrected" ? "event-corrected" : undefined}><span class="stamp">{entry.status}{entry.date && entry.date !== "Date unavailable" && <> &middot; {entry.date}</>}</span><p>{entry.text}</p></li>)}
    </ol>
  </section>}
  <section>
    <h2>Verification</h2>
    <dl class="kv">
      {presentation.firstRetrievedAt && <div><dt>First retrieved</dt><dd class="nw">{presentation.firstRetrievedAt}</dd></div>}
    </dl>
  </section>
</aside>
