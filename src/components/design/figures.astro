---
import BarChart from '../story/BarChart.astro';
import StepChart from '../story/StepChart.astro';
import ShareBar from '../story/ShareBar.astro';
import DataTable from '../story/DataTable.astro';
import Correction from '../story/Correction.astro';
import '../../styles/story.css';
const bars = [{ label: 'Room A', value: 20 }, { label: 'Room B', value: 30 }, { label: 'Room C', value: 50 }];
const parts = bars.map(row => ({ label: row.label, value: row.value }));
---
<p>Fictional reading-room figures, not reporting. The same components and values appear on each surface.</p>
{['sheet', 'ink'].map(surface => <section class:list={['figure-sample', { 'ink-panel': surface === 'ink' }]} aria-label={`Charts on ${surface === 'ink' ? 'black' : 'the sheet'}`}>
  <h3>{surface === 'ink' ? 'Black panel' : 'Document sheet'}</h3>
  <BarChart bars={bars} width={320} height={150} caption="Fictional seats: A 20; B 30; C 50. Source: sample fixture." ariaLabel="Fictional seats by room: A 20, B 30, C 50" highlightLast />
  <StepChart start={{ date: '2024-01-01', value: 2 }} changes={[{ date: '2025-01-01', value: 3 }]} end={{ date: '2026-01-01', value: 3 }} annotations={[{ date: '2025-01-01', value: 3, text: '3% from 2025', accent: true }]} yearLabels={['2024', '2025']} width={320} height={130} yRange={[1, 4]} caption="Fictional fee: 2% in 2024, 3% from 2025. Source: sample fixture." />
  <ShareBar caption="Fictional seats by room · 100 total" parts={parts} />
</section>)}
<DataTable columns={['Fictional room', 'Seats']} rows={bars.map(row => [row.label, row.value])} caption="Text equivalent · fictional seats" />
<Correction id="fictional-correction" date="2026-01-02" dateLabel="January 2, 2026" previous="Room A: 25 seats" corrected="Room A: 20 seats">
  <p>The fictional draft counted five seats twice. The table and charts above use the corrected count. This is an example, not a published correction.</p>
</Correction>

<style>
  p { max-width: var(--measure); }
  .figure-sample { padding: var(--space-6); margin-block: var(--space-6); border: 1px solid var(--rule); }
  h3 { font: 700 1.2rem/1.3 var(--display); margin: 0 0 var(--space-6); }
  .figure-sample :global(svg) { width: 100%; max-width: 32rem; }
  .figure-sample :global(.rate-chart) { max-width: 32rem; }
</style>
