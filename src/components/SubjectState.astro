---
import { formatDate } from "../lib/presentation.mjs";
import { valueText } from "../lib/v2.mjs";
const { story, supporting = false } = Astro.props;
const standing = (claim) => claim.state === "established" ? (claim.level ? `${claim.level[0].toUpperCase()}${claim.level.slice(1).replace(/_/g, " ")}` : "Established") : `${claim.state[0].toUpperCase()}${claim.state.slice(1)}`;
const speakers = (view) => {
  const groups = new Map();
  for (const statement of view.statements) {
    if (!groups.has(statement.speaker)) groups.set(statement.speaker, []);
    groups.get(statement.speaker).push(statement);
  }
  return [...groups].sort(([a], [b]) => a.localeCompare(b));
};
---
<details class="record-ledger" data-record-ledger data-layer="fact" data-v2-snapshot={story.snapshot} open={!supporting}>
  <summary>What the sources say <span class="series-count">{story.views.reduce((sum, view) => sum + view.statements.length, 0)}</span></summary>
  {story.views.map((view) => <section data-v2-subject={view.id}>
    <h3>{view.label}</h3>
    {view.claims.map((claim) => <article class="ledger-row" data-v2-claim={claim.id} data-v2-state={claim.state}>
      <h4 data-extracted>{claim.attribute}</h4>
      {claim.value && <p class="ledger-excerpt" data-extracted>{valueText(claim.value)}</p>}
      <p class="ledger-source">{standing(claim)} · {claim.kind}{claim.as_of && <> · as of {formatDate(claim.as_of)}</>}</p>
    </article>)}
    {speakers(view).map(([speaker, statements]) => <div data-v2-speaker={speaker}>
      <h4 data-extracted>{speaker}</h4>
      <ul>{statements.map((statement) => <li data-v2-statement={statement.id} data-v2-status={statement.status}>
        <blockquote data-source-copy>{statement.quote}</blockquote>
        {statement.status !== "live" && <p>This statement was withdrawn.</p>}
        {statement.as_of && <p class="ledger-source">As of {formatDate(statement.as_of)}</p>}
      </li>)}</ul>
    </div>)}
    <h4>Sources</h4>
    <ul>{view.sources.map((source) => <li data-v2-source={source.artifact}><span data-extracted>{source.source ?? source.artifact}</span>{source.published_at && <> · {formatDate(source.published_at)}</>} · {source.statements} {source.statements === 1 ? "statement" : "statements"}</li>)}</ul>
  </section>)}
</details>
