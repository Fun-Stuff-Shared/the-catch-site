---
const { article, articleId, count } = Astro.props;
const publishers = [...new Set(article.map((row) => row.publisher).filter(Boolean))];
const sourceUrl = article.find((row) => row.source_url)?.source_url;
const articleTitle = article.find((row) => row.article_title)?.article_title
  ?? article.find((row) => row.claim_class === "core")?.proposition
  ?? article.find((row) => row.proposition)?.proposition
  ?? "News source article";
const publishedAt = article.find((row) => row.published_at)?.published_at;
const sourceDetails = [publishers.join(", "), publishedAt].filter(Boolean).join(" · ");
---
<header class="matter-header news-article-header">
  <p class="matter-kicker">News source article</p>
  <h1>{articleTitle}</h1>
  <p class="source-byline">
    {sourceDetails && <>{sourceDetails} &middot; </>}
    {count} {count === 1 ? "recorded statement" : "recorded statements"}
    {sourceUrl && <> &middot; <a href={sourceUrl} rel="noreferrer">Open source article</a></>}
  </p>
  <p class="news-article-id">Archive reference: {articleId}</p>
</header>
