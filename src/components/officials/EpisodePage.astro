---
import BaseLayout from "../../layouts/BaseLayout.astro";
import OfficialKpis from "./OfficialKpis.astro";
import StatementList from "./StatementList.astro";
import VoteList from "./VoteList.astro";
import VoteTable from "./VoteTable.astro";
import { votesForEpisode, keyVotesForEpisode } from "../../lib/official-votes.mjs";
import "../../styles/figure-story.css";
const { episode } = Astro.props;
const votes = votesForEpisode(episode);
const keyVotes = keyVotesForEpisode(episode);
---
<BaseLayout title={`${episode.title} | The Catch`} current="Officials"><div slot="locator" class="locator"><a href="/officials/">OFFICIALS</a><a href="/officials/marco-rubio/">Marco Rubio</a><span>{episode.kicker}</span></div><div class="content"><main class="story"><p class="story-kicker"><a href="/officials/marco-rubio/">Marco Rubio</a> &middot; {episode.kicker}</p><h1>{episode.title}</h1><p class="story-dek">{episode.dek}</p><OfficialKpis votes={votes} keyVotes={keyVotes} statements={episode.statements} /><nav class="story-toc" aria-label="In this story"><p class="toc-label">In this story</p><ol><li><a href="#statements">What he said</a></li><li><a href="#votes">What he did</a></li><li><a href="#all-votes">Every recorded vote</a></li></ol></nav><section id="statements"><StatementList statements={episode.statements} /></section><section id="votes"><div class="lane did"><p class="lane-label">What he did</p><VoteList votes={keyVotes} /></div></section><section id="all-votes"><h2>Every recorded vote in this episode</h2><VoteTable votes={votes} keyRcs={episode.key_votes.map((vote) => vote.rc)} /></section></main></div></BaseLayout>
