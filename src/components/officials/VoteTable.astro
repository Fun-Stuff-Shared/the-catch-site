---
const { votes, keyRcs = [] } = Astro.props;
const keys = new Set(keyRcs);
const cloture = votes.filter((vote) => vote.threshold === "3/5").map((vote) => vote.rc);
const descriptionFor = (vote) => vote.purpose && vote.purpose !== "No Statement of Purpose on File."
  ? vote.purpose
  : [vote.question, vote.measure || vote.title].filter(Boolean).join(" · ");
---
<div class="tblwrap"><table><thead><tr><th>Date</th><th>Roll call</th><th>What was voted on</th><th>Rubio</th><th>Result</th></tr></thead><tbody>{votes.map((vote) => <tr class={keys.has(vote.rc) ? "key" : undefined}><td class="num">{vote.date}</td><td class="num"><a href={vote.url} rel="noreferrer">{vote.rc}</a></td><td>{descriptionFor(vote)}</td><td>{vote.cast}</td><td class="num">{vote.result} {vote.yeas}-{vote.nays}</td></tr>)}</tbody></table><p class="tbl-note">{cloture.length ? `Roll calls ${cloture.join(", ")} required three-fifths to advance.` : "No listed roll call required three-fifths to advance."}</p></div>
