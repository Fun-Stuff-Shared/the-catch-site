---
import RevisionTimeline from "./story/RevisionTimeline.astro";
import { eventPath, slotLabel, figureText } from "../lib/state.mjs";
import { formatDate } from "../lib/presentation.mjs";
import { recordById, outletRecordByUrl } from "../lib/record-manifests.mjs";
const { view, supporting = false } = Astro.props;
const event = view.event ?? view;
const evidence = new Map((view.evidence ?? []).map((row) => [row.id, row]));
const occurrences = new Map((view.occurrences ?? []).map((row) => [row.id, row]));
const documents = (view.edges ?? []).filter((edge) => edge.label === "cites" && edge.accepted !== false && edge.refusal == null && !edge.retire);
const slots = Object.entries(view.current_state ?? {});
const retirementReason = ({ no_accepted_occurrence: "No supported facts were recorded.", unfinished_legacy_identity: "The entry was incomplete." })[view.reason] ?? view.reason;
const sourcePath = (source) => {
  const hash = (value) => String(value ?? '').replace(/^sha256:/, '');
  const record = recordById.get(source.id) ?? recordById.get(source.source_id) ?? [...recordById.values()].find(record => record.story === eventPath(event.id) && (!source.url || record.url === source.url) && source.text_sha256 && hash(record.text_sha256) === hash(source.text_sha256));
  if (record && (record.id === source.id || source.text_sha256 && hash(record.text_sha256) === hash(source.text_sha256))) return `/records/${record.id}/`;
  return outletRecordByUrl.has(source.url) ? `/records/${outletRecordByUrl.get(source.url).id}/` : source.url;
};
---
      <details class="record-ledger" data-record-ledger data-layer="fact" data-state-derived open={!supporting}>
        <summary>{slots.length === 0 ? "Tracked figures" : slots.some(([, slot]) => !slot.figure && slot.quote_span) ? "Figures and source passages" : "Figures in the source documents"}{slots.length > 0 && <> <span class="series-count">{slots.length}</span></>}</summary>
        {slots.length ? slots.map(([id, slot]) => {
          const source = evidence.get(occurrences.get(slot.occurrence_id)?.evidence_id);
          const href = source ? sourcePath(source) : null;
          const computed = slot.figure?.kind === "computed";
          const label = slot.slot === 'nonfarm_payroll_revision_may_june' ? 'Payroll revisions for May and June' : slotLabel(slot.slot);
          return <article class="ledger-row" data-state-slot={id}>
            <h3>{label}</h3>
            {slot.figure && <strong class="ledger-value" data-state-figure={slot.occurrence_id} data-state-figure-role="current" data-figure-value={String(slot.figure.value)} data-figure-unit={slot.figure.unit ?? ""}>{figureText(slot.figure.value, slot.figure.unit)}</strong>}
            {computed && <div class="ledger-calculation" data-computed>
              <p>Computed: {slot.figure.inputs.map(input => input.unit === 'date' ? formatDate(input.value) : input.value).join(slot.figure.formula === 'date_difference_days' ? ' minus ' : ' + ')} = {figureText(slot.figure.value, slot.figure.unit)}.</p>
              {slot.figure.inputs.map(input => {
                const record = evidence.get(input.evidence_id);
                return <details class="ledger-source-passage"><summary>{input.unit === 'date' ? formatDate(input.value) : figureText(input.value, input.unit)} · {record?.publisher}</summary>
                  <blockquote data-source-copy>{input.quote_span}</blockquote>
                  {record && <a href={sourcePath(record)}>Read the source</a>}
                </details>;
              })}
            </div>}
            {!slot.figure && !slot.quote_span && <p>{slot.withdrawn ? "The recorded value was withdrawn." : slot.disputed ? "This record does not yet establish one current value." : "A current value has not been established."}</p>}
            {!slot.figure && slot.quote_span && <p class="ledger-excerpt" data-source-copy>{slot.quote_span}</p>}
            {!computed && href && <a class="ledger-source" href={href} data-passage={slot.quote_span || undefined} aria-label={`Read the source for ${label}`}>{source.publisher} <span aria-hidden="true">↗</span></a>}
            {!href && source?.publisher && <p class="ledger-source">{source.publisher} · No document link in this record.</p>}
            {slot.figure && !computed && slot.quote_span && <details class="ledger-source-passage"><summary>Recorded passage</summary><blockquote data-source-copy>{slot.quote_span}</blockquote></details>}
          </article>;
        }) : <p>The figures on this page come from the saved records cited beside them. The state record has not yet read this story's sources, so it tracks no values for it; when it does, they appear here with their source passages.</p>}
      </details>
      {view.follows && <section data-layer="fact"><h2>Since the previous story</h2>
        <p><a href={eventPath(view.follows)}>Read the previous story</a></p>
        {(view.changed_since_previous ?? []).map((change) => <p data-state-comparison>{slotLabel(change.name)}: <strong data-state-figure={change.previous.occurrence_id} data-state-figure-event={view.follows} data-figure-value={String(change.previous.value)} data-figure-unit={change.unit}>{figureText(change.previous.value, change.unit)}</strong> previously; <strong data-state-figure={change.current.occurrence_id} data-figure-value={String(change.current.value)} data-figure-unit={change.unit}>{figureText(change.current.value, change.unit)}</strong> in this story. <span data-source-copy>{change.current.sentence}</span></p>)}
        {(view.same_name_not_compared ?? []).map((change) => <p>{slotLabel(change.name)}: {change.reason}</p>)}
        {(view.new_slots ?? []).map((slot) => <p>{slotLabel(slot.name)}: first tracked in this story. <span data-source-copy>{slot.sentence}</span></p>)}
      </section>}
      <RevisionTimeline timeline={view.revision_timeline} occurrences={view.occurrences} />
      {documents.length > 0 && <section data-layer="proof"><h2>Documents</h2><ul>{documents.map((edge) => {
        const document = evidence.get(edge.to_evidence_id);
        return <li><a href={`/records/${document.id}/`} data-source-copy>{document.title ?? document.publisher}</a> · {edge.role === "primary_record" ? "Original record" : "Reference"}{edge.reason && <>. {edge.reason}</>}</li>;
      })}</ul></section>}
      <section data-layer="proof"><h2>Sources</h2><ul>{[...evidence.values()].map((source) => <li><a href={sourcePath(source)} data-source-copy>{source.publisher}</a> · {formatDate(source.asserted_at)}{source.title && <> · <span data-source-copy>{source.title}</span></>}</li>)}</ul></section>
