---
import { labelsForNewsClaim } from "../lib/stage2-public-labels.mjs";
import { outletRecordByUrl } from "../lib/record-manifests.mjs";
const { claim, context = false } = Astro.props;
const sourceLabel = claim.publisher;
const paywalled = claim.source_tier === "paywalled";
const corroboratingOutlets = claim.corroboration_outlets ?? [];
const slugFor = (articleId) => encodeURIComponent(articleId).replace(/%/g, "-").toLowerCase();
const publicLabels = labelsForNewsClaim(claim);
const record = outletRecordByUrl.get(claim.source_url);
const corroborationLabel = {
  corroborated_2plus: "Corroborated by 2+ independent sources",
  corroborated_1: "Checked: one independent source found",
  single_source_unchecked: "Single source: not yet checked",
  check_ran_empty: "Checked: no independent source found",
}[claim.corroboration_status];
---
<article class:list={["ev-item", context ? "k-rep" : "k-doc"]}>
  <div class="ev-tags">
    {publicLabels.map(({ axis, label }) => <span class="tag t-doc stage2-public-label" data-public-axis={axis}>{label}</span>)}
    {corroborationLabel && <span class="tag t-stmt news-corroboration-status">{corroborationLabel}</span>}
    {paywalled && <span class="tag t-stmt">Paywalled source</span>}
    {sourceLabel && <span class="tag t-stmt">{sourceLabel}</span>}
  </div>
  <h2 class="news-claim-title">{claim.proposition}</h2>
  <blockquote>{claim.quote}</blockquote>
  {corroboratingOutlets.length > 0 && <p class="news-corroboration">Also reported by {corroboratingOutlets.map((outlet, index) => <>{index > 0 && ", "}{outlet.article_id ? <a href={`/news/${slugFor(outlet.article_id)}/`}>{outlet.name}</a> : outlet.name}</>)}</p>}
  <p class="ev-src">
    {sourceLabel}
    {claim.context_type && <>{sourceLabel && " · "}{claim.context_type.replaceAll("_", " ")}</>}
    {record && <> &middot; <a href={`/records/${record.id}/`}>Open record</a></>}
  </p>
</article>
