---
import PayrollChart from './PayrollChart.astro';
import { formatDate } from '../lib/presentation.mjs';
const { story, lead = false, related = [], visual = false, showSeries = false } = Astro.props;
const { kind: visualKind, ...chartProps } = story.visual ?? {};
---
<article class:list={['story-link', { 'story-link-lead': lead }]} data-story-item data-date={story.date} data-series={story.series} data-topic={story.topic} data-search={`${story.title} ${story.summary} ${story.topic} ${story.keywords ?? ''}`.toLowerCase()}>
  <div class="story-meta"><span>{story.topic}</span>{story.synthetic && <span class="sample-mark">Sample</span>}<time datetime={story.date}>{formatDate(story.date)}</time></div>
  <h2><a href={story.href}>{story.title}</a></h2>
  {story.summary && <p>{story.summary}</p>}
  {visual && visualKind === 'payrolls' && <div data-story-visual><PayrollChart compact {...chartProps} /></div>}
  <a class="read-link" href={story.href} aria-label={`Read: ${story.title}`}>Read the story <span aria-hidden="true">↗</span></a>
  {showSeries && story.series?.startsWith('/events/') && <a class="follow-series-link" href={story.series}>Follow this series <span aria-hidden="true">→</span></a>}
  {related.length > 0 && <div class="related-developments" data-related-stories><p>Earlier in this series</p><ul>{related.slice(0, 2).map(item => <li><time datetime={item.date}>{formatDate(item.date)}</time><h3><a href={item.href}>{item.title}</a></h3>{item.summary && <p class="related-summary">{item.summary}</p>}</li>)}</ul></div>}
</article>
