---
interface Props {
  points: Array<{ label: string; date: string }>;
  intervals: Array<{ days: number }>;
  highlight?: { label: string; days: number };
  ariaLabel?: string;
}

const { points, intervals, highlight, ariaLabel = "Dated sequence" } = Astro.props;
---
<figure class="date-line">
  <svg viewBox={`0 0 760 ${highlight ? 152 : 100}`} role="img" aria-label={ariaLabel}>
    <line x1="44" y1="58" x2="716" y2="58" class="date-line-rule" />
    {points.map((point, index) => {
      const x = 44 + (672 * index) / Math.max(points.length - 1, 1);
      const interval = intervals[index];
      return <>
        <circle cx={x} cy="58" r="4" class="date-line-point" />
        <text x={x} y="26" text-anchor="middle" class="chart-axis">{point.date}</text>
        <text x={x} y="88" text-anchor="middle" class="chart-note">{point.label}</text>
        {interval && <text x={x + (672 / Math.max(points.length - 1, 1)) / 2} y="48" text-anchor="middle" class="chart-note">{interval.days} {interval.days === 1 ? "day" : "days"}</text>}
      </>;
    })}
    {highlight && <>
      <path d="M44 116v10h672v-10" class="date-line-bracket" />
      <text x="380" y="146" text-anchor="middle" class="chart-note-accent">{highlight.label}: {highlight.days} days</text>
    </>}
  </svg>
</figure>
