---
const { timeline, checkedAt } = Astro.props;
const confirmations = timeline?.confirmations ?? [];
const changes = timeline?.changes ?? [];
const changesCheckedAt = (timeline?.changes_checked_at ?? checkedAt).slice(0, 10);
const plainDate = (value) => new Intl.DateTimeFormat("en-US", { month: "long", day: "numeric", timeZone: "UTC" }).format(new Date(`${value}T00:00:00Z`));
---
<section class="revision-timeline" data-layer="fact" data-revision-confirmations={confirmations.length} data-revision-changes={changes.length}>
  <h2>Who reported this</h2>
  {confirmations.length > 0
    ? <ul>{confirmations.map((row) => <li data-revision-confirmation>{row.sentence} {row.reports.map((report, index) => <>{index ? "; " : ""}<a href={report.url}>{report.publisher}</a> {report.verb} on {report.dates.map(plainDate).join(" and ")}</>)}
      {(row.quotes ?? []).length > 0 && <ul>{row.quotes.map((quote) => <li data-revision-quote>{quote.text} {quote.reports.map((report, index) => <>{index ? "; " : ""}<a href={report.url}>{report.publisher}</a> {report.verb} on {report.dates.map(plainDate).join(" and ")}</>)}</li>)}</ul>}
    </li>)}</ul>
    : <p data-revision-no-confirmations>This page does not yet list who reported each figure.</p>}
  <h2>What changed since</h2>
  {changes.length > 0
    ? <ul>{changes.map((row) => <li data-revision-change>{row.sentence} <a href={row.earlier_evidence_url}>Earlier report</a>; <a href={row.later_evidence_url}>Later report</a>.</li>)}</ul>
    : <p data-revision-no-changes>No reported fact about this event has changed since this page was first published (checked {changesCheckedAt}).</p>}
</section>
