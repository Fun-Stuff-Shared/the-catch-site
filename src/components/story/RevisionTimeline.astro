---
import QuotedText from "./QuotedText.astro";
const { timeline, occurrences = [] } = Astro.props;
const quotes = new Map(occurrences.map((row) => [row.id, row.quote_span]));
const confirmations = timeline?.confirmations ?? [];
const changes = timeline?.changes ?? [];
const plainDate = (value) => new Intl.DateTimeFormat("en-US", { month: "long", day: "numeric", timeZone: "UTC" }).format(new Date(`${value}T00:00:00Z`));
---
<section class="revision-timeline" data-layer="fact" data-revision-confirmations={confirmations.length} data-revision-changes={changes.length}>
  {confirmations.length > 0 && <details class="source-history"><summary>Source history</summary>
    <ul>{confirmations.map((row) => <li data-revision-confirmation><QuotedText text={row.sentence} quotes={[row.value, ...(row.quotes ?? []).map((quote) => quote.text)]} /> {row.reports.map((report, index) => <>{index ? "; " : ""}<a href={report.url}>{report.publisher}</a> {report.verb} on {report.dates.map(plainDate).join(" and ")}</>)}
      {(row.quotes ?? []).length > 0 && <ul>{row.quotes.map((quote) => <li data-revision-quote><span data-source-copy>{quote.text}</span> {quote.reports.map((report, index) => <>{index ? "; " : ""}<a href={report.url}>{report.publisher}</a> {report.verb} on {report.dates.map(plainDate).join(" and ")}</>)}</li>)}</ul>}
    </li>)}</ul>
  </details>}
  {changes.length > 0 && <><h2>What changed since</h2>
    <ul>{changes.map((row) => <li data-revision-change data-state-transition><QuotedText text={row.sentence} quotes={[quotes.get(row.earlier_occurrence_id), quotes.get(row.later_occurrence_id)]} /> <a href={row.earlier_evidence_url}>Earlier report</a>; <a href={row.later_evidence_url}>Later report</a>.</li>)}</ul></>}
</section>
