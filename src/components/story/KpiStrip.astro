---
/**
 * KPI strip: a row of key figures at the top of a story.
 * Props:
 *   kpis: Array<{ value: string, unit?: string, label: string, live?: boolean, cites?: Array<{ c?: string, s?: string, passage?: string }> }>
 *   liveId?: string  — prefix for live-counter element IDs (default: "kpi")
 */
import Cite from "../Cite.astro";

interface Props {
  kpis: Array<{ value: string; unit?: string; label: string; live?: boolean; cites?: Array<{ c?: string; s?: string; passage?: string }> }>;
  liveId?: string;
}
const { kpis, liveId = "kpi" } = Astro.props;
---
<div class="kpi-strip">
  {kpis.map((k) => (
    <div class="kpi">
      <span class="kpi-value" id={k.live ? `${liveId}-days` : undefined}>
        {k.value}<small>{k.unit ? ` ${k.unit}` : ""}</small>
      </span>
      <span class:list={["kpi-label", { "kpi-has-cites": k.cites?.length }]} id={k.live ? `${liveId}-days-label` : undefined}>
        {k.label}{k.cites?.map((c) => <Cite c={c.c} s={c.s} passage={c.passage} />)}
      </span>
    </div>
  ))}
</div>

<style>
  .kpi-has-cites :global(.src-ref + .src-ref)::before {
    content: ", ";
    white-space: pre;
    color: var(--muted, #6b7280);
    font-size: 0.72em;
  }
</style>
