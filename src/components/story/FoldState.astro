---
const { state } = Astro.props;
const entries = Object.values(state.current_state);
const occurrences = new Map(state.evidence.flatMap((record) => record.occurrences ?? []).map((occurrence) => [occurrence.id, occurrence]));
const figures = entries.filter((entry) => entry.occurrence_id && entry.figure);
const quotes = entries.filter((entry) => entry.occurrence_id && !entry.figure);
const disputes = entries.filter((entry) => entry.disputed);
const date = (iso) => iso ? new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" }) : "undated";
---
<section id="fold" class="fold-state" data-derived-section>
  <p class="sec-kicker">From the record</p><h2>What the saved record says</h2>
  {figures.length > 0 && <div class="kpi-strip">{figures.map((entry) => <div class="kpi" data-derived-figure data-occurrence-id={entry.occurrence_id} data-figure-value={entry.figure.value} data-figure-unit={entry.figure.unit ?? ""}><span class="kpi-value">{entry.figure.value}<small>{entry.figure.unit ? ` ${entry.figure.unit}` : ""}</small></span><span class="kpi-label">{entry.speaker ?? "Source record"} · {date(entry.as_of)}</span></div>)}</div>}
  {quotes.map((entry) => <blockquote data-quote-anchor data-occurrence-id={entry.occurrence_id}><p>{entry.quote_span}</p><footer>{entry.speaker ?? "Source record"} · {date(entry.as_of)}</footer></blockquote>)}
  {disputes.length > 0 && <section><h3>Where sources disagree</h3>{disputes.map((entry) => <div><p>Sources disagree, {entry.heads.length} competing values.</p><ul>{entry.heads.map((id) => <li>{occurrences.get(id)?.quote_span ?? "A saved source statement"}</li>)}</ul></div>)}</section>}
  <section class="fold-timeline"><h3>Timeline from the record</h3><ol>{state.timeline.map((change) => <li>{change.roots ? `${change.roots} independent sources line up on this point.` : "The record changed on this point."}</li>)}</ol></section>
  <section class="fold-records"><h3>Records in this reading</h3>{state.evidence.map((record, index) => <details><summary>Saved source {index + 1}</summary><ul>{record.occurrences.map((occurrence) => <li>{occurrence.quote_span} <span>{occurrence.speaker ?? "Source record"} · {date(occurrence.as_of)}</span></li>)}</ul></details>)}</section>
</section>
