---
/**
 * In-this-story table of contents with scrollspy.
 * Props:
 *   sections: Array<{ id: string, label: string }>
 */
interface Props {
  sections: Array<{ id: string; label: string }>;
}
const { sections } = Astro.props;
---
<nav class="story-toc" aria-label="In this story">
  <details class="toc-disclosure" open><summary><span>In this story</span><span class="toc-current" aria-hidden="true"></span></summary>
  <ol>
    {sections.map((s) => <li><a href={`#${s.id}`}>{s.label}</a></li>)}
  </ol>
</details></nav>
