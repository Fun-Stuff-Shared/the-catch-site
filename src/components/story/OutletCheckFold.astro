---
interface Props {
  count: number;
  method: string;
}

const { count, method } = Astro.props;
---
<section class="outlet-check-fold">
  <h3>{count} other report{count === 1 ? "" : "s"}</h3>
  <p class="oc-verdict"><strong>Checks out.</strong> Each was checked the same way: {method}</p>
  <slot />
</section>
