---
interface Props {
  count: number;
  method: string;
}

const { count, method } = Astro.props;
---
<section class="outlet-check-fold">
  <h3>{count === 1 ? "One other report" : `${count} other reports`}</h3>
  <p class="oc-verdict"><strong>Checks out.</strong> {count === 1 ? "It was checked the same way" : "Each was checked the same way"}: {method}</p>
  <slot />
</section>
