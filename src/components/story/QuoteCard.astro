---
/**
 * Quote card: a person's or an ad's words as a record. The paragraph before the
 * card introduces the speaker; the card names the speaker again in its header.
 * Props:
 *   speaker: string - who said it (a person, or the ad or document that carries it)
 *   when: string    - date or date and time
 *   where: string   - venue (Senate floor, X post, 30-second spot)
 *   label?: string  - the record's short name, shown at the foot
 */
interface Props { speaker: string; when: string; where: string; label?: string; }
const { speaker, when, where, label } = Astro.props;
if (!speaker?.trim()) throw new Error("QuoteCard needs a speaker");
---
<figure class="quote-card" data-layer="fact">
  <figcaption class="qc-head"><span class="qc-speaker">{speaker}</span><span class="qc-sep">&middot;</span><span class="qc-when">{when}</span><span class="qc-sep">&middot;</span><span class="qc-where">{where}</span></figcaption>
  <blockquote class="qc-words"><slot /></blockquote>
  {label && <p class="qc-label">{label}</p>}
</figure>
<style is:global>
  .quote-card { margin: 1.5rem 0; padding: 0; }
  .quote-card .qc-head { font: 500 .78rem/1.5 var(--sans); color: var(--slate); margin: 0 0 .65rem; }
  .quote-card .qc-speaker { color: var(--ink, #1a1a1a); }
  .quote-card .qc-sep { margin: 0 .4rem; }
  .quote-card .qc-words { position: relative; margin: 0; padding-left: 1.5rem; font-family: var(--serif); font-size: 1.05rem; line-height: 1.55; }
  .quote-card .qc-words::before { content: '“'; position: absolute; left: -.15rem; top: -.3rem; font: 3.5rem/1 var(--serif); color: var(--red); }
  .quote-card .qc-words p { margin: 0 0 .5rem; }
  .quote-card .qc-label { margin: .5rem 0 0; font: 500 .75rem/1.3 var(--sans); color: var(--slate); }
</style>
