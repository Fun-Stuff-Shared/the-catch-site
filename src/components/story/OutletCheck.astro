---
import { recordById } from "../../lib/record-manifests.mjs";

interface Props {
  outlet?: string;
  claim: string;
  verdict?: string;
  chip?: string;
  status?: "ok" | "warn" | "note";
  date?: string;
  folded?: boolean;
}
const { outlet, claim, verdict, chip, status = "ok", date, folded = false } = Astro.props;
const sourceMarkup = Astro.slots.has("default") ? await Astro.slots.render("default") : "";
const sourceId = sourceMarkup.match(/data-record-href="\/records\/([^/]+)\//)?.[1];
const recordDate = sourceId ? recordById.get(sourceId)?.date : undefined;
const displayDate = date ?? (recordDate
  ? new Intl.DateTimeFormat("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" }).format(new Date(`${recordDate}T12:00:00Z`))
  : undefined);
const sentence = verdict?.match(/^.*?[.!?](?=\s|$)/)?.[0] ?? verdict ?? "";
const record = verdict ? verdict.slice(sentence.length).trim() : "";
const restatesChip = chip ? sentence.toLowerCase().startsWith(chip.toLowerCase()) : false;
const verdictWord = chip ? (restatesChip ? sentence.slice(0, chip.length) : `${chip.charAt(0).toUpperCase()}${chip.slice(1)}.`) : undefined;
const firstSentence = restatesChip ? sentence.slice(chip.length) : sentence;
---
{folded ? (
  <p class="oc-folded">
    {outlet && <strong>{outlet}</strong>}{displayDate && `, ${displayDate}`}, <span set:html={claim} /> {verdict && <span set:html={verdict} />}<slot />
  </p>
) : (
  <article class={`outlet-check ${status}`}>
    {outlet && <h3>{outlet}{displayDate && `, ${displayDate}`}</h3>}
    <p class="oc-claim"><span set:html={claim} /></p>
    {verdict && (
      <p class="oc-verdict">
        {verdictWord && <strong>{verdictWord}</strong>}{firstSentence && <span set:html={restatesChip ? firstSentence : ` ${firstSentence}`} />}
      </p>
    )}
    {record && <p class="oc-record"><span set:html={record} /></p>}
    {sourceMarkup && <p class="oc-sources"><slot /></p>}
  </article>
)}
