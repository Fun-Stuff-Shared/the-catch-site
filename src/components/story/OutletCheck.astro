---
import Cite from "../Cite.astro";
import { recordById } from "../../lib/record-manifests.mjs";
import { claim as ledgerClaim, storyId } from "../../lib/claims.mjs";

interface Props {
  outlet?: string;
  claim: string;
  verdict?: string;
  chip?: string;
  status?: "ok" | "warn" | "note";
  date?: string;
  folded?: boolean;
  cites?: Array<{ c?: string; s?: string; passage?: string }>;
}
const { outlet, claim, verdict, chip, status = "ok", date, folded = false, cites } = Astro.props;
const claimIds = cites?.map((c) => c.c).filter(Boolean).join(" ") || undefined;
const sourceMarkup = Astro.slots.has("default") ? await Astro.slots.render("default") : "";
const pageEvent = (Astro.url.pathname.match(/^\/events\/(.+?)\/?$/) || [])[1];
const firstCite = cites?.[0];
const sourceId = sourceMarkup.match(/data-record-href="\/records\/([^/]+)\//)?.[1]
  ?? (firstCite?.c ? ledgerClaim(pageEvent && storyId(pageEvent), firstCite.c).evidence[0]?.record : firstCite?.s);
const recordDate = sourceId ? recordById.get(sourceId)?.date : undefined;
const parsedRecordDate = /^\d{4}-\d{2}-\d{2}$/.test(recordDate ?? "") ? new Date(`${recordDate}T12:00:00Z`) : undefined;
const validRecordDate = parsedRecordDate && !Number.isNaN(parsedRecordDate.getTime()) && parsedRecordDate.toISOString().slice(0, 10) === recordDate;
const displayDate = date ?? (validRecordDate
  ? new Intl.DateTimeFormat("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" }).format(parsedRecordDate)
  : undefined);
const sentence = verdict?.match(/^.*?[.!?](?=\s|$)/)?.[0] ?? verdict ?? "";
const record = verdict ? verdict.slice(sentence.length).trim() : "";
const restatesChip = chip ? sentence.toLowerCase().startsWith(chip.toLowerCase()) : false;
const verdictWord = chip ? (restatesChip ? sentence.slice(0, chip.length) : `${chip.charAt(0).toUpperCase()}${chip.slice(1)}.`) : undefined;
const firstSentence = restatesChip ? sentence.slice(chip.length) : sentence;
---
{folded ? (
  <p class:list={["oc-folded", { "oc-has-cites": cites?.length }]}>
    {outlet && <strong>{outlet}</strong>}{displayDate && `, ${displayDate}`}, <span set:html={claim} /> {verdict && <span set:html={verdict} />}{cites?.map((c) => <Cite c={c.c} s={c.s} passage={c.passage} />)}<slot />
  </p>
) : (
  <article class={`outlet-check ${status}`}>
    {outlet && <h3>{outlet}{displayDate && `, ${displayDate}`}</h3>}
    <p class="oc-claim" data-claims={claimIds}><span set:html={claim} />{!verdict && !!cites?.length && <span class="oc-cites">{cites.map((c) => <Cite c={c.c} s={c.s} passage={c.passage} />)}</span>}</p>
    {verdict && (
      <p class="oc-verdict" data-claims={claimIds}>
        {verdictWord && <strong>{verdictWord}</strong>}{firstSentence && <span set:html={restatesChip ? firstSentence : ` ${firstSentence}`} />}
        {!record && !!cites?.length && <span class="oc-cites">{cites.map((c) => <Cite c={c.c} s={c.s} passage={c.passage} />)}</span>}
      </p>
    )}
    {record && <p class="oc-record" data-claims={claimIds}><span set:html={record} />{!!cites?.length && <span class="oc-cites">{cites.map((c) => <Cite c={c.c} s={c.s} passage={c.passage} />)}</span>}</p>}
    {sourceMarkup && <p class="oc-sources"><slot /></p>}
  </article>
)}

<style>
  .oc-cites :global(.src-ref + .src-ref)::before,
  .oc-has-cites :global(.src-ref + .src-ref)::before {
    content: ", ";
    white-space: pre;
    color: var(--muted, #6b7280);
    font-size: 0.72em;
  }
</style>
