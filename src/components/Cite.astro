---
import { citeNumber } from "../lib/record-manifests.mjs";
import { claim, ledger, storyId } from "../lib/claims.mjs";
const { c, s, passage } = Astro.props;
// The footnote number is the page's own list; a source shared with another story keeps this page's numbering.
const pageEvent = (Astro.url.pathname.match(/^\/events\/(.+?)\/?$/) || [])[1];
const story = pageEvent && storyId(pageEvent);
// A story with a claim ledger cites claims; each claim's evidence becomes its citations.
if (story && ledger(story) && !c) throw new Error(`cite_needs_claim:${story}:${s}`);
const evidence = c ? claim(story, c).evidence : [{ record: s, passage }];
const cites = evidence.map((e) => {
  const cite = citeNumber(e.record, pageEvent);
  if (!cite) throw new Error(`cite_unknown_source:${e.record}`);
  if (pageEvent && cite.event !== pageEvent) throw new Error(`cite_outside_page_sources:${e.record} on ${pageEvent} (found in ${cite.event})`);
  return { ...e, n: cite.n };
});
---
{cites.map((e) => <sup class="src-ref"><a href={`#src-${e.n}`} data-record-href={`/records/${e.record}/`} data-passage={e.passage} data-claim={c} aria-label={`Source ${e.n}: read the evidence`}>{e.n}</a></sup>)}
