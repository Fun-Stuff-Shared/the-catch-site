{state.status === "retired" ? <StateEvent view={state} /> : <BaseLayout title={`${event.title} | The Catch`} current="Events">
  <div slot="locator" class="locator"><a href="/events/">Series</a><a href="/events/ed-sheeran-tour/">Ed Sheeran's Loop Tour</a><span>September 14, 2026</span></div>
  <div class="content">
    <main class="story" id="story-root">
      <p class="story-kicker" data-layer="fact"><a href="/events/ed-sheeran-tour/">Ed Sheeran's Loop Tour</a> &middot; September 14, 2026 &middot; updated {event.updated}</p>
