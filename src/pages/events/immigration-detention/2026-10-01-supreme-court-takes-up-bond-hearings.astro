import "../../../styles/story.css";
import ReadingModes from "../../../components/ReadingModes.astro";
import Cite from "../../../components/Cite.astro";
import SourcedBlock from "../../../components/SourcedBlock.astro";
import QuoteCard from "../../../components/story/QuoteCard.astro";
import DataTable from "../../../components/story/DataTable.astro";
import StorySources from "../../../components/StorySources.astro";
import StoryState from "../../../components/StoryState.astro";
import StateEvent from "../../../components/StateEvent.astro";
import { readPublishedState, eventPath } from "../../../lib/state.mjs";
import { event, computed, chronology, split, counts } from "../../../data/immigration-detention-2026-10-01-supreme-court-takes-up-bond-hearings.mjs";
const state = readPublishedState().events.get("event-immigration-detention-2026-10-01-supreme-court-takes-up-bond-hearings");
