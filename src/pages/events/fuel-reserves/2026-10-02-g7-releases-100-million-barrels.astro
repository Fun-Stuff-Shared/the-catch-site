---
<BaseLayout title={`${event.title} | The Catch`} current="Events">
  <div slot="locator" class="locator"><a href="/events/">Series</a><a href="/events/fuel-reserves/">Fuel reserves</a><span>October 2, 2026</span></div>
  <div class="content">
    <main class="story" id="story-root">
      <p class="story-kicker" data-layer="fact">Energy · October 2, 2026</p>
      <h1 data-layer="fact">{event.title}</h1>
