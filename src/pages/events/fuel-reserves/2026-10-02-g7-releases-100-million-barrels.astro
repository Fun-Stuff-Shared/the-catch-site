<BaseLayout title={`${event.title} | The Catch`} current="Events">
  <div slot="locator" class="locator"><a href="/events/">Series</a><a href="/events/fuel-reserves/">Fuel reserves</a><span>October 2, 2026</span></div>
  <div class="content">
    <main class="story" id="story-root">
      <p class="story-kicker" data-layer="fact">Energy &middot; October 2, 2026 &middot; updated {event.updatedLabel}</p>
      <h1 data-layer="fact">{event.title}</h1>
      <p class="story-dek" data-layer="fact">{event.dek}</p>
      <ReadingModes />
      <nav class="story-toc" aria-label="In this story">
        <details class="toc-disclosure" open data-layer="fact"><summary><span>In this story</span><span class="toc-current" aria-hidden="true"></span></summary>
          <ol>
            <li><a href="#what-happened">What happened</a></li>
            <li><a href="#whose-barrels">Whose barrels</a></li>
            <li><a href="#why-diesel">Why diesel is short</a></li>
            <li><a href="#the-sides">Washington and Europe</a></li>
            <li><a href="#the-catch">The catch</a></li>
