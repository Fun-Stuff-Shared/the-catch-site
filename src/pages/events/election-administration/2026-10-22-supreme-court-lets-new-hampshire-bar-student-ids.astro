---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import "../../../styles/story.css";
import ReadingModes from "../../../components/ReadingModes.astro";
import Cite from "../../../components/Cite.astro";
import QuoteCard from "../../../components/story/QuoteCard.astro";
import DecisionTimeline from "../../../components/story/DecisionTimeline.astro";
import DateLine from "../../../components/story/DateLine.astro";
import KpiStrip from "../../../components/story/KpiStrip.astro";
import StorySources from "../../../components/StorySources.astro";
import StoryState from "../../../components/StoryState.astro";
import StateEvent from "../../../components/StateEvent.astro";
import { readPublishedState, eventPath } from "../../../lib/state.mjs";
import { claim } from "../../../lib/claims.mjs";
import { event, computed, chronology, timing, figures } from "../../../data/election-administration-2026-10-22-supreme-court-lets-new-hampshire-bar-student-ids.mjs";
const story = "election-administration--2026-10-22-supreme-court-lets-new-hampshire-bar-student-ids";
const short = (id) => claim(story, id).short;
const state = readPublishedState().events.get("event-election-administration-2026-10-22-supreme-court-lets-new-hampshire-bar-student-ids");
if (!state) throw new Error("Missing publication selection: event-election-administration-2026-10-22-supreme-court-lets-new-hampshire-bar-student-ids");
if (state.status === "merged") return Astro.redirect(eventPath(state.survivor), 301);
---
{state.status === "retired" ? <StateEvent view={state} /> : <BaseLayout title={`${event.title} | The Catch`} current="Events">
  <div slot="locator" class="locator"><a href="/events/">Series</a><a href="/events/election-administration/">Election administration</a><span>October 22, 2026</span></div>
  <div class="content">
    <main class="story" id="story-root">
      <p class="story-kicker" data-layer="fact">Election administration &middot; October 22, 2026 &middot; updated {event.updated}</p>
      <h1 data-layer="fact">{event.title}</h1>
      <p class="story-dek" data-layer="fact">{event.dek}</p>
      <ReadingModes />
      <nav class="story-toc" aria-label="In this story" data-layer="fact">
        <details class="toc-disclosure" open><summary><span>In this story</span><span class="toc-current" aria-hidden="true"></span></summary>
        <ol>
          <li><a href="#what-happened">What happened</a></li>
          <li><a href="#student">A student at the polls on November 3</a></li>
          <li><a href="#why-now">From the law to the lawsuit</a></li>
          <li><a href="#why-the-court">Why the Court stepped in</a></li>
          <li><a href="#the-sides">What each side says</a></li>
          <li><a href="#the-catch">The Catch</a></li>
          <li><a href="#next">What happens next</a></li>
          <li><a href="#records">The records</a></li>
        </ol>
        </details>
      </nav>

      <section id="what-happened">
        <h2 data-layer="fact">What happened</h2>
        <p data-layer="narrative" data-answer="1">A New Hampshire law, HB 323, has kept student IDs off the list of IDs a poll worker must accept since June 2, and no court has blocked it.<Cite c="hb323-what-it-did" /><Cite c="hb323-not-enjoined" /> What Judge Joseph Laplante of the federal court in New Hampshire blocked, in a lawsuit brought by the Coalition for Open Democracy, was narrower: Secretary of State David Scanlan's instruction that election officials could not consider a student ID even as backup evidence of who a voter is.<Cite c="hb323-not-enjoined" /><Cite c="suit-filed" /> Laplante ordered the state to tell officials they could weigh a student ID along with other evidence.<Cite c="injunction-terms" /> On October 22 the Supreme Court paused his order at the state's request, with Justice Ketanji Brown Jackson the only justice recorded as dissenting.<Cite c="stay-granted" /><Cite c="jackson-only-noted-dissent" /></p>
        <p data-layer="narrative" data-answer="2">The next day the state went back to the rules it used in the September primary: a student ID cannot be used to prove identity when registering, voting absentee or checking in on election day.<Cite c="state-reverts-oct23" /> A registered student without a government photo ID can still get a ballot on November 3 if a local election official personally knows them and signs an attestation.<Cite c="registered-route-personal-knowledge" /> A student registering that day cannot be vouched for that way, but officials can confirm their identity, with their permission, from New Hampshire motor-vehicle or vital records.<Cite c="no-vouching-at-registration" /><Cite c="state-records-route" /></p>
        <p data-layer="narrative" data-answer="3">The order gives one reason: lower federal courts should not change election rules on the eve of an election, and Laplante ruled {computed.daysInjunctionToElection} days before this one.<Cite c="order-ground-purcell" /><Cite c="order-32-days" /> It does not decide whether the law or Scanlan's instruction is lawful.<Cite c="order-no-merits" /> The pause lasts through the state's appeal and any petition to the Supreme Court, and the case is expected to go to trial.<Cite c="stay-duration" /><Cite c="trial-ahead" /></p>
      </section>

      <section id="student">
        <h2 data-layer="fact">A student at the polls on November 3</h2>
        <p data-layer="narrative">A college student may register to vote in the New Hampshire town where they live while at school.<Cite c="student-domicile" /> Any voter who shows a driver's license from any state, a non-driver ID or voter ID card, a U.S. military ID, or a U.S. passport or passcard gets a ballot without further checks.<Cite c="accepted-ids" /> For a student who has none of those, what is left depends on whether they are already registered.</p>
        <figure class="story-figure" data-layer="fact">
          <figcaption><strong>A student without a listed ID, on November 3</strong></figcaption>
          <div class="routes">
            <div class="route">
              <p class="route-title">Already registered</p>
              <dl>
                <dt>Student ID</dt><dd>Not accepted<Cite c="state-reverts-oct23" /></dd>
                <dt>An official who knows them</dt><dd>Can vouch, with a signed attestation<Cite c="registered-route-personal-knowledge" /></dd>
                <dt>State records</dt><dd>The law has supervisors trained to use registration data<Cite c="state-records-route" /></dd>
                <dt>Other documents</dt><dd>{short("other-evidence-unsettled")}<Cite c="other-evidence-unsettled" /></dd>
                <dt>An affidavit</dt><dd>Cannot prove identity<Cite c="affidavit-history" /></dd>
                <dt>Free state voter ID</dt><dd>{short("voter-id-mailed")}<Cite c="voter-id-mailed" /></dd>
              </dl>
            </div>
            <div class="route">
              <p class="route-title">Registering that day</p>
              <dl>
                <dt>Student ID</dt><dd>Does not count for identity<Cite c="registering-proof" /></dd>
                <dt>An official who knows them</dt><dd>No longer counts, since Sept. 8<Cite c="no-vouching-at-registration" /></dd>
                <dt>State records</dt><dd>Motor-vehicle or vital records can confirm identity, with permission<Cite c="state-records-route" /></dd>
                <dt>Other documents</dt><dd>{short("registering-open-question")}<Cite c="registering-open-question" /></dd>
                <dt>An affidavit</dt><dd>{short("citizenship-affidavit")}<Cite c="citizenship-affidavit" /></dd>
                <dt>Free state voter ID</dt><dd>{short("voter-id-mailed")}<Cite c="voter-id-mailed" /></dd>
              </dl>
            </div>
          </div>
        </figure>
        <p data-layer="narrative">The state itself has given two answers on whether a registered voter can use other documents. In the record it gave Laplante, it said supervisors at the polls apply the same any-other-evidence standard used at registration; in asking for the stay, it argued that only the listed IDs count. The Secretary's election-day page now names only personal knowledge.<Cite c="other-evidence-unsettled" /> A registered voter a supervisor turns away can appeal to the superior court that day.<Cite c="appeal-same-day" /></p>
        <p data-layer="narrative">No affidavit can stand in for proof of identity. A 2024 law, HB 1569, ended the affidavits voters had used, including to prove identity, and a federal judge's ruling in May, in an earlier case the same group helped bring, restored only the affidavit for citizenship and the one for answering a challenge.<Cite c="affidavit-history" /> A student voting absentee instead must send a copy of a listed ID or have the application notarized.<Cite c="absentee-same-list" /></p>
        <p data-layer="narrative">How many students this reaches is not known. The challengers' expert estimated that about {computed.youngLackingId} New Hampshire residents aged 18 to 24, {computed.youngLackingIdShare} percent, lack a qualifying ID, but he did not estimate how many of them hold a student ID.<Cite c="young-lacking-id" /> In the September primary, run under the same rules, the deputy secretary of state received {computed.primaryTurnedAwayWord} reports of students turned away.<Cite c="primary-turned-away" /><Cite c="state-reverts-oct23" /></p>
        <figure class="story-figure" data-layer="fact">
          <KpiStrip kpis={figures} />
          <p class="chart-source">From the district court record.<Cite c="young-lacking-id" /><Cite c="primary-turned-away" /><Cite c="no-reliance-count" /></p>
        </figure>
      </section>

      <section id="why-now">
        <h2 data-layer="fact">From the law to the lawsuit</h2>
        <p data-layer="narrative">State Rep. Donald McFarlane, who sponsored HB 323, has said he did so because colleges do not have the same controls as government agencies when they issue ID cards.<Cite c="sponsor-reason" /> Student IDs had counted since the state's voter ID law took effect in 2012.<Cite c="student-ids-since-2012" /> Three weeks after Gov. Kelly Ayotte signed the bill, Scanlan's office announced that from June 2 student IDs could not be used as proof of ID to register, to request an absentee ballot or to check in to vote.<Cite c="hb323-what-it-did" /><Cite c="april-directive" /></p>
        <figure class="story-figure" data-layer="fact">
          <figcaption><strong>From the law to the Supreme Court</strong></figcaption>
          <DecisionTimeline entries={chronology} heading="What happened" />
        </figure>
        <p data-layer="narrative">The Coalition for Open Democracy sued in August, and Laplante refused to change anything for the September primary, citing the rule against late changes.<Cite c="suit-filed" /><Cite c="primary-no-relief" /> For the general election he split the case in two. On the law, he found at this early stage that the state's interests in counting only eligible votes and running orderly elections were weighty enough to justify taking student IDs off the list.<Cite c="hb323-justified-preliminary" /> On Scanlan's instruction, he found the state had offered no reason specific to barring student IDs even as backup evidence, and Scanlan's own deputy testified he saw no factual reason a student ID could not be reasonable evidence of who a voter is.<Cite c="no-interest-for-directive" /> Laplante and then the federal appeals court above him, the First Circuit, by 2 to 1, refused to pause his order.<Cite c="lower-courts-refused" /></p>
      </section>

      <section id="why-the-court">
        <h2 data-layer="fact">Why the Court stepped in</h2>
        <p data-layer="narrative">The unsigned order quotes the Court's own past words: "lower federal courts should ordinarily not alter the election rules on the eve of an election." Here, it said, the district court "did not point to anything that would justify deviating from that principle."<Cite c="order-ground-purcell" /> The rule traces to Purcell v. Gonzalez, a 2006 case in which, as Jackson summarizes it, the Court said a late court order could itself cause voter confusion or give people a reason to stay away from the polls.<Cite c="purcell-explained" /></p>
        <div class="story-figure" data-layer="fact">
          <DateLine points={timing.points} intervals={timing.intervals} highlight={timing.highlight} ariaLabel={`Laplante's order came ${computed.daysInjunctionToElection} days before the November 3 election, and the Supreme Court's pause ${computed.daysStayToElection} days before it`} />
          <p class="chart-source">Dates from the orders and the election calendar.<Cite c="order-32-days" /><Cite c="stay-granted" /></p>
        </div>
        <p data-layer="narrative">New Hampshire argued that re-educating local election officials and the public in that time was practically impossible, and that even a plausible reading of state law by the judge should have waited.<Cite c="state-purcell-case" /> The order cites the Court's September ruling on <a href="/events/missouri-house-map/2026-09-03-map-never-became-law/">Missouri's congressional map</a>, where ballots had already been printed and mailed and voting had begun.<Cite c="onder-precedent" /> Laplante had found that general-election voting in New Hampshire had not meaningfully begun when he ruled.<Cite c="voting-not-begun-oct2" /></p>
      </section>

      <section id="the-sides">
        <h2 data-layer="fact">What each side says</h2>
        <h3 data-layer="fact">The state</h3>
        <p data-layer="narrative">Scanlan says the legislature, in HB 323 and a later bill, SB 223, meant that student IDs should not count even as reasonable evidence of identity.<Cite c="state-case" /></p>
        <h3 data-layer="fact">The challengers</h3>
        <p data-layer="narrative">The Coalition for Open Democracy says no statute was ever blocked: the injunction held the Secretary to the legislature's statutes, and the stay reverses the rules a second time in a month.<Cite c="coalition-case" /></p>
        <QuoteCard speaker="Coalition for Open Democracy" when="October 19, 2026" where="Opposition to the stay, Supreme Court">
          <p>"It would reverse the rules for a second time in a month."<Cite c="coalition-case" /></p>
        </QuoteCard>
        <h3 data-layer="fact">The dissent</h3>
        <p data-layer="narrative">Jackson wrote that Laplante's order left the state election rule untouched and was designed to correct misinformation, and that she would not have disturbed it.<Cite c="jackson-reasoning" /></p>
        <QuoteCard speaker="Justice Ketanji Brown Jackson" when="October 22, 2026" where="Dissent from the order">
          <p>"the District Court’s injunction was reasonably designed to address alleged misinformation, not to change the law."<Cite c="jackson-reasoning" /></p>
        </QuoteCard>
      </section>

      <section id="the-catch">
        <aside class="the-catch" data-layer="fact">
          <p class="tt-label">The Catch</p>
          <ol>
            <li>
              <h3>The Court did not approve a new ban</h3>
              <p data-layer="narrative">Several of the first reports told the order as the Court approving a ban on student IDs. CBS News headlined that the Supreme Court "rules New Hampshire can ban use of student IDs," and UPI wrote that the Court "ruled."<Cite c="catch-cbs-rules" /> New Hampshire's attorney general said the order reinstated the state's law, and the Union Leader wrote that the Court found it inappropriate for lower courts to "set aside state laws."<Cite c="catch-reinstating-law" /> No court set the law aside. HB 323 has kept student IDs off the accepted list since June 2 through every ruling in the case, and what the Court put back is Scanlan's instruction that a student ID cannot count even as backup evidence.<Cite c="hb323-not-enjoined" /> The order rules only on timing, not on whether the law or the instruction is lawful.<Cite c="order-no-merits" /></p>
            </li>
            <li>
              <h3>Not "unsuccessful," and not 8-1</h3>
              <p data-layer="narrative">USA Today called the state's emergency appeal "unsuccessful"; the Court granted it.<Cite c="catch-usatoday-unsuccessful" /> A post on X called the order 8-1, but the order records only Jackson's dissent and no other justice's vote.<Cite c="catch-8-1" /></p>
            </li>
            <li>
              <h3>The guidance said the opposite</h3>
              <p data-layer="narrative">UPI wrote that Scanlan's guidance "said student IDs could be used when people seek ballots." His April guidance said they cannot be used.<Cite c="catch-upi-reversed" /></p>
            </li>
          </ol>
        </aside>
      </section>

      <section id="next">
        <h2 data-layer="fact">What happens next</h2>
        <p data-layer="narrative">The pause holds while the First Circuit hears the state's appeal. If either side then asks the Supreme Court to take the case, it ends automatically if the Court declines and otherwise lasts until the Court rules.<Cite c="stay-duration" /> In the district court, the case is expected to go to a full trial on whether the law and the instruction are lawful; the records give no date.<Cite c="trial-ahead" /></p>
        <p data-layer="narrative">It could end first on a different question: whether the Coalition can bring the case at all. Laplante assumed it could without deciding, relying on Chief Judge Elliott's ruling in the affidavit case, and that ruling is itself on appeal.<Cite c="standing-open" /> The state says it will run radio and television announcements telling voters that student IDs cannot be used to prove identity.<Cite c="state-ads" /></p>
      </section>

      <section id="records">
      <StorySources event={event.slug} />
      <StoryState view={state} supporting />
      </section>
    </main>
  </div>
</BaseLayout>}

<style>
  .routes { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .route { border: 1px solid var(--rule); border-top: 2px solid var(--rule-strong); padding: 0.9rem 1rem; font-family: var(--sans); }
  .route-title { font-weight: 700; color: var(--ink); margin: 0 0 0.5rem; }
  .route dl { margin: 0; }
  .route dt { font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--slate); margin-top: 0.7rem; }
  .route dd { margin: 0.15rem 0 0; color: var(--ink); }
  @media (max-width: 640px) { .routes { grid-template-columns: 1fr; } }
</style>
