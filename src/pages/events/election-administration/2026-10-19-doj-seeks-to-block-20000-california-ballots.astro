---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import "../../../styles/story.css";
import ReadingModes from "../../../components/ReadingModes.astro";
import Cite from "../../../components/Cite.astro";
import QuoteCard from "../../../components/story/QuoteCard.astro";
import DataTable from "../../../components/story/DataTable.astro";
import KpiStrip from "../../../components/story/KpiStrip.astro";
import DecisionTimeline from "../../../components/story/DecisionTimeline.astro";
import OutletCheck from "../../../components/story/OutletCheck.astro";
import StorySources from "../../../components/StorySources.astro";
import StoryState from "../../../components/StoryState.astro";
import StateEvent from "../../../components/StateEvent.astro";
import { publishedState, eventPath } from "../../../lib/state.mjs";
import { event, figures, computed, timeline, listFigures, orderTable } from "../../../data/election-administration-2026-10-19-doj-seeks-to-block-20000-california-ballots.mjs";
const state = publishedState().events.get("event-election-administration-2026-10-19-doj-seeks-to-block-20000-california-ballots");
if (!state) throw new Error("Missing publication selection: event-election-administration-2026-10-19-doj-seeks-to-block-20000-california-ballots");
if (state.status === "merged") return Astro.redirect(eventPath(state.survivor), 301);
---
{state.status === "retired" ? <StateEvent view={state} /> : <BaseLayout title={`${event.title} | The Catch`} current="Events">
  <div slot="locator" class="locator"><a href="/events/">Series</a><a href="/events/election-administration/">Election administration</a><span>October 19, 2026</span></div>
  <div class="content">
    <main class="story" id="story-root">
      <p class="story-kicker" data-layer="fact">Election administration &middot; October 19, 2026 &middot; updated {event.updated}</p>
      <h1 data-layer="fact">{event.title}</h1>
      <p class="story-dek" data-layer="fact">{event.dek}<Cite c="ca9-motion-filed" /><Cite c="constructive-denial" /><Cite c="carter-hearing" /><Cite c="county-letters" /><Cite c="county-letters-count" /></p>
      <ReadingModes />
      <nav class="story-toc" aria-label="In this story" data-layer="fact">
        <details class="toc-disclosure" open><summary><span>In this story</span><span class="toc-current" aria-hidden="true"></span></summary>
        <ol>
          <li><a href="#what-happened">What happened</a></li>
          <li><a href="#the-catch">The Catch</a></li>
          <li><a href="#the-order">What would happen to a voter on the list</a></li>
          <li><a href="#the-list">How the list was made</a></li>
          <li><a href="#why-now">Why the list came in October</a></li>
          <li><a href="#the-28">The 28 charged</a></li>
          <li><a href="#coverage">What the coverage got wrong</a></li>
          <li><a href="#next">What happens next</a></li>
          <li><a href="#records">The records</a></li>
        </ol>
        </details>
      </nav>

      <section id="what-happened">
        <h2 data-layer="fact">What happened</h2>
        <p data-layer="narrative">The Justice Department asked a federal appeals court on Oct. 23 to order California to set aside the mail ballots of people on a list of about {figures.listed} voters it calls likely noncitizens, while it appeals.<Cite c="ca9-motion-filed" /> The trial judge, David O. Carter of the federal court in Los Angeles, has not ruled. He received the case on Oct. 21 and set a hearing for Oct. 27, a week before Nov. 3, Election Day, the date by which DOJ's own request had asked him to act.<Cite c="carter-hearing" /><Cite c="doj-asked-nov-3" /> DOJ then asked him to rule by noon the next day. When he did not, it appealed, arguing that the judge's silence amounted to a denial.<Cite c="doj-asked-noon" /><Cite c="constructive-denial" /></p>
        <p data-layer="narrative">Also on Oct. 23, the U.S. attorney's office in Los Angeles sent county election officials lists of voters in their counties that it calls likely noncitizens. The letters ask officials to commit within 48 hours to working with DOJ and the Department of Homeland Security to sort the citizens from the noncitizens, to send identifying records including Social Security numbers, and to set aside the ballot of anyone whose citizenship cannot be verified.<Cite c="county-letters" /> At least {figures.countiesAtLeast} counties received the letters, according to the Los Angeles County registrar's office; NBC News reported letters to 57 of the state's 58 counties.<Cite c="county-letters-count" /> Bill Essayli, the first assistant U.S. attorney in Los Angeles, warned that any official who knowingly processes a noncitizen's ballot "is opening themselves to legal jeopardy."<Cite c="essayli-jeopardy" /></p>
        <p data-layer="narrative">DOJ sued California, its secretary of state, Shirley Weber, and the Los Angeles County registrar, Dean Logan, on Oct. 15, arguing that because federal law bars noncitizens from voting, counting their ballots violates the Constitution's Supremacy Clause.<Cite c="suit-filed" /> Officials at two immigration agencies, U.S. Citizenship and Immigration Services and Homeland Security Investigations, describe the people on DOJ's list as registered California voters. In sworn statements to the court, one calls them "highly likely" to be noncitizens and the other says he "reasonably believe[s]" they are.<Cite c="list-highly-likely" /> The order DOJ wants would hold each one's mail ballot until their citizenship is confirmed by more than their own sworn registration, and it names no deadline.<Cite c="proposed-order" /> Los Angeles County told the court that of {figures.sample} names it checked, {figures.notMailed} had not been mailed a ballot for this election, because their registrations were canceled or inactive.<Cite c="la-sample-112" /> The Ninth Circuit gave California and the county until noon on Saturday, Oct. 24, to answer.<Cite c="ca9-deadline" /></p>
      </section>

      <section id="the-catch">
        <aside class="the-catch" data-layer="fact">
          <p class="tt-label">The Catch</p>
          <ol>
            <li>
              <h3>Essayli calls the {figures.listed} verified. The sworn declarations say "highly likely" and "reasonably believe."<Cite c="essayli-verified" /><Cite c="list-highly-likely" /></h3>
              <p data-layer="narrative">Essayli wrote on X on Oct. 16 that the {figures.listed} were noncitizens "confirmed by a review of federal databases," and on Oct. 20 that "we verified that at least 20,000 noncitizens are receiving ballots."<Cite c="essayli-verified" /> Fox News put "verified" in its Oct. 22 headline on its interview with him: "DOJ has verified 20,000 noncitizens on California voter rolls, federal prosecutor says."<Cite c="fox-headline" /></p>
              <QuoteCard speaker="Bill Essayli, first assistant U.S. attorney in Los Angeles" when="October 20, 2026" where="Post on X">
                <p>"we verified that at least 20,000 noncitizens are receiving ballots."<Cite c="essayli-verified" /></p>
              </QuoteCard>
              <p data-layer="narrative">The two officials who built the list, Nicolas Bartell of USCIS and Eric McLoughlin of Homeland Security Investigations, put it differently in the sworn declarations DOJ filed in court on Oct. 21. McLoughlin wrote that he "reasonably believe[s]" the people on it are noncitizens. Bartell called them "highly likely to be noncitizen aliens."<Cite c="list-highly-likely" /></p>
              <QuoteCard speaker="Nicolas Bartell, USCIS" when="October 21, 2026" where="Sworn declaration filed in court">
                <p>The people on the list are "highly likely to be noncitizen aliens."<Cite c="list-highly-likely" /></p>
              </QuoteCard>
              <p data-layer="narrative">Essayli has used those softer words too. About three hours after his "confirmed" post on Oct. 16, he wrote of "suspected noncitizens," and on Oct. 23 of "who we believe are noncitizens."<Cite c="essayli-suspected" /><Cite c="essayli-believe" /> Trent McCotter, the acting deputy attorney general, said on Oct. 19 that some names on the list may turn out to be citizens: "we're not perfect."<Cite c="mccotter-not-perfect" /> USCIS itself found about {figures.discrepancies} records on the list with what it called minor data discrepancies.<Cite c="discrepancies-189" /></p>
            </li>
            <li>
              <h3>More than half the names Los Angeles checked were never mailed a ballot</h3>
              <p data-layer="narrative">DOJ describes everyone on the list as having been sent a mail ballot. The HSI official who built the list swore that he believes they got ballots because, as he understands California law, the state mails one to every registered voter.<Cite c="roster-aug-2025" /> When Los Angeles County checked {figures.sample} of the names against its own records, most had canceled or inactive registrations and had been mailed nothing.<Cite c="la-sample-112" /></p>
              <figure class="story-figure" data-layer="fact">
                <figcaption><strong>The {figures.sample} names Los Angeles County checked</strong><span>Whether the county had mailed each person a ballot for the Nov. 3 election.</span></figcaption>
                <KpiStrip kpis={[{ value: String(figures.notMailed), label: "mailed no ballot: registration canceled or inactive" }, { value: String(figures.mailed), label: "mailed a ballot" }]} />
                <p class="chart-source">From the declarations of the county's Monica Flores and Aman Bhullar, filed Oct. 20.<Cite c="la-sample-112" /></p>
              </figure>
              <p data-layer="narrative">In its brief, the county says {figures.usBornAll} percent of all the sampled voters have a U.S. birthplace on their records, which it calls "a strong indicator of citizenship status." Its ballot counts for the same sample add up to {figures.notMailed + figures.mailed}, not {figures.sample}.<Cite c="la-sample-birthplace" /><Cite c="la-sample-112" /></p>
              <p data-layer="narrative">The county took its {figures.sample} from the {figures.inLa} listed names with Los Angeles addresses and has not said how it chose them; by its count, about {figures.outsideLa} people on the list are registered in other counties.<Cite c="la-7035" /><Cite c="la-sample-112" /><Cite c="logan-county-line" /> DOJ says it asked the county for the specific people it calls wrongly listed and has had no answer.<Cite c="doj-asked-sample" /> The list also holds all {figures.charged} people charged with crimes on Oct. 19.<Cite c="charged-28" /></p>
            </li>
          </ol>
        </aside>
      </section>

      <section id="the-order">
        <h2 data-layer="fact">What would happen to a voter on the list</h2>
        <p data-layer="narrative">Under DOJ's proposed order, California and Los Angeles County would set aside every mail ballot from a person on the list and could not count it until that person's citizenship was confirmed by something more than their own sworn registration. A ballot from a noncitizen would not be counted, and a citizen's would go through the state's steps for provisional ballots.<Cite c="proposed-order" /> Los Angeles County answers that a voter whose ballot is held would get no notice, no way to respond, no standard for the decision and no deadline, and that once the count closes, a mistake may be impossible to undo.<Cite c="logan-due-process" /></p>
        <figure class="story-figure" data-layer="fact">
          <figcaption><strong>The order, and the county's answer to it</strong></figcaption>
          <DataTable columns={["", "DOJ's proposed order", "Los Angeles County's objection"]} rows={orderTable} />
          <p class="chart-source">From DOJ's proposed order and the county's motion to dismiss, both filed Oct. 21.<Cite c="proposed-order" /><Cite c="logan-due-process" /></p>
        </figure>
        <h3 data-layer="fact">DOJ's case</h3>
        <p data-layer="narrative">DOJ's case for acting now is that an illegal vote, once counted and mixed with lawful ones, cannot be pulled out later, because a ballot taken out of its envelope can no longer be tied to the voter. Los Angeles County had processed {figures.processed} mail ballots by Oct. 20.<Cite c="doj-harm" /><Cite c="ballots-untraceable" /> DOJ says it cannot investigate thousands of people itself before the election ends, and it calls the {figures.listed} only the floor, the smallest the number of potential noncitizen voters in California could be.<Cite c="doj-cannot-investigate" /><Cite c="doj-floor" /></p>
        <h3 data-layer="fact">California's case</h3>
        <p data-layer="narrative">California answers that the order would break the National Voter Registration Act's ban on systematically removing voters in the 90 days before a federal election, and that the harm would fall on naturalized citizens.<Cite c="ca-nvra" /> State law already lets a mail ballot be challenged on citizenship, it says, and the California regulation DOJ cites for setting ballots aside covers recounts.<Cite c="ca-state-challenge" /> It adds that nothing in the order promises a held ballot will be counted in time.<Cite c="ca-no-guarantee" /> Aman Bhullar, who runs the county's election systems, told the court that changing those systems now to hold the listed ballots could also flag voters who are not on the list.<Cite c="bhullar-flag-others" /></p>
      </section>

      <section id="the-list">
        <h2 data-layer="fact">How the list was made</h2>
        <p data-layer="narrative">According to the two declarations, the list began with a copy of California's voter roll, current as of August 2025, that the fraud office at USCIS received from Homeland Security Investigations on or around May 8, 2026.<Cite c="may-8-roll" /><Cite c="roster-aug-2025" /> USCIS added data from a commercial data platform, matched the voters to immigration records, screened out people whom State Department or Social Security records showed to be citizens or dead, and had analysts review the matches by hand; HSI then narrowed it further.<Cite c="method" /> USCIS told the court that a match of that kind can produce data that is "incomplete, outdated, or mismatched," which is why analysts check the matches by hand.<Cite c="data-incomplete" /></p>
        <p data-layer="narrative">By DOJ's account, the review cut a preliminary list of over {figures.preliminary} names to just over {figures.listed}.<Cite c="funnel-175000" /> The list is far smaller than what DHS first told California. In July, Homeland Security Secretary Markwayne Mullin wrote that there "may be as many as 190,832" noncitizens on the state's rolls, and that the name, birth date, address and Social Security number of {figures.julyFourPoint} registrants matched a noncitizen's records.<Cite c="mullin-190832" /><Cite c="funnel-81336" /> DHS says the larger figure was a pool still awaiting review and the {figures.listed} is the part reviewed so far. No filing says how many of the {figures.listed} were among the {figures.julyFourPoint} close matches.<Cite c="dhs-subset" /><Cite c="funnel-81336" /></p>
        <figure class="story-figure" data-layer="fact">
          <figcaption><strong>The list's numbers, by who reported them</strong><span>DOJ's account of the cut, Los Angeles County's check of its share, and DHS's July letter, which no filing connects to the list.</span></figcaption>
          <DataTable columns={["DOJ's account", "What it counts"]} rows={listFigures.doj} />
          <DataTable columns={["Los Angeles County's check", "What it counts"]} rows={listFigures.la} />
          <DataTable columns={["DHS's July letter", "What it counts"]} rows={listFigures.july} />
          <p class="chart-source">From DOJ's emergency application, the county's declarations and Mullin's July 16 letter.<Cite c="funnel-175000" /><Cite c="la-7035" /><Cite c="la-sample-112" /><Cite c="mullin-190832" /><Cite c="funnel-81336" /></p>
        </figure>
        <p data-layer="narrative">In a separate case on Oct. 21, a federal judge in San Francisco found that the lists of suspected noncitizen voters DHS hands USCIS under a program it began in August are "voluminous and unreliable."<Cite c="cna-context" /> By Bartell's account, USCIS had the roll behind California's list on or around May 8.<Cite c="may-8-roll" /></p>
      </section>

      <section id="why-now">
        <h2 data-layer="fact">Why the list came in October</h2>
        <p data-layer="narrative">Weber asked DHS on July 23 to explain its method and say where its copy of the voter roll came from.<Cite c="weber-july" /> DOJ delivered its list on Oct. 13, after the Oct. 5 date by which California counties mail a ballot to every active voter. McCotter sent it to Los Angeles County on a thumb drive and gave officials 48 hours to set aside the ballots of anyone whose citizenship they could not confirm.<Cite c="oct13-demand" /><Cite c="ballots-mailed" /> Weber's state office says it was never given the list.<Cite c="weber-no-list" /> McCotter later said California "refused to look at that list." The county did not open the thumb drive, but it reviewed the same list when DOJ emailed it the next day.<Cite c="mccotter-refused-look" /><Cite c="county-reviewed" /></p>
        <p data-layer="narrative">Asked why DOJ did not act sooner, Essayli told Fox News that investigators did not know exactly which voters would receive ballots until the ballots were sent.<Cite c="essayli-timing" /> DOJ's own declarations say the list was drawn from a roll current as of August 2025, which USCIS had on or around May 8. That was {computed.daysRollToList} days before DOJ delivered the list on Oct. 13, and months before counties mailed ballots on Oct. 5.<Cite c="may-8-roll" /><Cite c="roster-aug-2025" /><Cite c="oct13-demand" /><Cite c="ballots-mailed" /></p>
        <p data-layer="narrative">Reuters reported in September, from a Sept. 1 DHS email, that the White House had pushed agencies to speed their review of state voter rolls. In the email, a DHS official offered to take slow progress to the White House chief of staff, and hundreds of USCIS fraud officers had been moved onto the work from August.<Cite c="reuters-pressure" /> President Trump's March 31 executive order on elections, the one that also launched the Postal Service's <a href="/events/mail-voting/2026-09-14-court-denies-stay/">mail-ballot rule</a>, tells the attorney general to prioritize investigating and, as appropriate, prosecuting officials who issue ballots to people not eligible to vote.<Cite c="eo-prosecute-officials" /> Sean Morales Doyle of the Brennan Center for Justice says the suit looks like groundwork for challenging results after Election Day.<Cite c="critics-groundwork" /></p>
        <figure class="story-figure" data-layer="fact">
          <figcaption><strong>From the voter roll to the appeal</strong><span>Dated steps in the filings, letters and DOJ's releases, 2026.</span></figcaption>
          <DecisionTimeline entries={timeline} heading="What happened" />
        </figure>
      </section>

      <section id="the-28">
        <h2 data-layer="fact">The 28 charged</h2>
        <p data-layer="narrative">On Oct. 19 DOJ charged {figures.charged} green-card holders, all of them on the list.<Cite c="charged-28" /> Prosecutors accuse 22 of them of voting in at least one election, five of registering without voting and one of casting a provisional ballot in 2020. Six are charged with voting as a noncitizen, a misdemeanor, and most of the rest with felonies that include lying on naturalization papers.<Cite c="charges-mix" /> Essayli says the arrests "prove our list is accurate."<Cite c="essayli-arrests-prove" /> One of the accused, Omar Muñoz, is charged with registering in 2019 and voting in four elections. He says he never registered or voted, and that someone once used his name and Social Security number.<Cite c="munoz-denies" /></p>
      </section>

      <section id="coverage">
        <h2 data-layer="fact">What the coverage got wrong</h2>
        <p data-layer="narrative">Of the county's two birthplace figures, ABC News reported the larger one, rounded up, as if it covered all 200 sampled voters.<Cite c="abc-subhead" /><Cite c="la-sample-birthplace" /></p>
        <div data-layer="fact">
        <OutletCheck outlet="ABC News" folded date="October 21, 2026" claim={`wrote in a subhead: "Of the 200 individuals in the sample, 40% say they were born in the U.S."`} verdict={`The county's figure is ${figures.usBornReporting} percent of the sampled records that gave a usable birthplace; across all the sampled voters, the county's brief puts it at ${figures.usBornAll} percent.`} chip="misread" status="warn"><Cite c="abc-subhead" /><Cite c="la-sample-birthplace" /></OutletCheck>
        </div>
      </section>

      <section id="next">
        <h2 data-layer="fact">What happens next</h2>
        <p data-layer="narrative">California and Los Angeles County answer the Ninth Circuit by noon on Saturday, Oct. 24.<Cite c="ca9-deadline" /> Carter hears DOJ's request on Oct. 27 and has said he will rule promptly after.<Cite c="carter-hearing" /> He also has DOJ's fallback request for a temporary order lasting up to 30 days or until the Ninth Circuit rules.<Cite c="doj-30-day" /> California argues that a hearing set before DOJ's own date cannot be a denial, and it has asked Carter to throw out the suit, saying the federal government has no right to bring it.<Cite c="ca-no-denial" /><Cite c="ca-mtd" /></p>
        <p data-layer="narrative">A separate suit by an immigrant-rights group and a California voter, aimed at the federal demands to withhold or set aside ballots, has a hearing Oct. 30 in Washington.<Cite c="trujillo-hearing" /> Los Angeles County must submit its final results by Dec. 3, and the state certifies the election by Dec. 11.<Cite c="certification" /></p>
      </section>

      <section id="records">
      <StorySources event={event.slug} />
      <StoryState view={state} supporting />
      </section>
    </main>
  </div>
</BaseLayout>}
