---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { records } from "../../lib/export.mjs";
import { eventPath, warrantedEvents } from "../../lib/events.mjs";
import { formatDate } from "../../lib/presentation.mjs";
import { event as fomcEvent } from "../../data/fomc20260617.mjs";

const groups = warrantedEvents(records).filter((group) => group.slug !== fomcEvent.slug);
---
<BaseLayout title="Events | The Catch" current="Events">
  <div slot="locator" class="locator"><span>EVENTS</span><span>The record, in context</span></div>
  <div class="content">
    <main class="method-main">
      <h1>Events</h1>
      <p class="lede">Each event gathers the primary records around one story, across all its dates, checks the
      coverage against them, and tells you what actually happened.</p>
      <ul class="matters-grid">
        <li><a href="/events/fed-rate/">
          <span class="mt-status st-blue">Standing</span>
          <span class="mt-title">The federal funds rate</span>
          <span class="mt-finding">Hold running since December 2025 &middot; latest story: June 2026 decision</span>
          <span class="mt-meta">Open the standing record</span></a></li>
        {groups.map((group) => <li><a href={eventPath(group.slug)}><span class="mt-status st-blue">{formatDate(group.date)}</span><span class="mt-title">{group.title}</span><span class="mt-finding">{group.records.length} {group.records.length === 1 ? "record" : "records"}</span><span class="mt-meta">Open event record</span></a></li>)}
      </ul>
    </main>
  </div>
</BaseLayout>
