---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { readdirSync, readFileSync } from "node:fs";
import { join } from "node:path";

const manifestDir = join(process.cwd(), "checks/manifests");
const events = readdirSync(manifestDir)
  .filter((name) => name.endsWith(".json"))
  .map((name) => JSON.parse(readFileSync(join(manifestDir, name), "utf8")))
  .filter((manifest) => manifest.story || manifest.event)
  .map((manifest) => {
    const route = manifest.story || (manifest.event ? `/events/${manifest.event}/` : null);
    if (!route) throw new Error(`event manifest has no route: ${JSON.stringify(manifest)}`);
    return {
      route,
      title: manifest.title || manifest.event || route,
      finding: manifest.dek || "Open the event record",
      date: manifest.date || manifest.generated_at || "",
    };
  })
  .sort((a, b) => b.date.localeCompare(a.date) || a.route.localeCompare(b.route));
---
<BaseLayout title="Events | The Catch" current="Events">
  <div slot="locator" class="locator"><span>EVENTS</span><span>The record, in context</span></div>
  <div class="content">
    <main class="method-main">
      <h1>Events</h1>
      <p class="lede">Each event gathers the primary records around one story, checks the coverage against them,
      and tells you what actually happened.</p>
      <ul class="matters-grid">
        {events.map((event) => <li><a href={event.route}><span class="mt-status st-blue">{event.date.slice(0, 10) || "Event"}</span><span class="mt-title">{event.title}</span><span class="mt-finding">{event.finding}</span><span class="mt-meta">Open event record</span></a></li>)}
      </ul>
    </main>
  </div>
</BaseLayout>
