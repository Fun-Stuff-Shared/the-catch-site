import "../../../styles/story.css";
import ReadingModes from "../../../components/ReadingModes.astro";
import Cite from "../../../components/Cite.astro";
import SourcedBlock from "../../../components/SourcedBlock.astro";
import StorySources from "../../../components/StorySources.astro";
import StoryState from "../../../components/StoryState.astro";
import StateEvent from "../../../components/StateEvent.astro";
import BarChart from "../../../components/story/BarChart.astro";
import DataTable from "../../../components/story/DataTable.astro";
import DecisionTimeline from "../../../components/story/DecisionTimeline.astro";
import OutletCheck from "../../../components/story/OutletCheck.astro";
import OutletCheckFold from "../../../components/story/OutletCheckFold.astro";
import CheckedBlock from "../../../components/story/CheckedBlock.astro";
import QuoteCard from "../../../components/story/QuoteCard.astro";
import { readPublishedState, eventPath } from "../../../lib/state.mjs";
import {
  event, financeCoveredCad, supportPackage, listItems, listItemsAug25, listRate50, listRate25, listRate15,
  oic0785Items, oic0786Items, oicUnionItems, oicOverlap, financeRateMismatches,
  oic0785Schedule1, oic0785Schedule2, oic0785Schedule3,
  oic0786Schedule1, oic0786Schedule11, oic0786Schedule2, oic0786Schedule21,
  census2025, computed, rateBars, moneyRows, timeline, orderCountRows,
  bbcCovered, bbcSupport, detroitCovered, fxUsdCad20260825, annexDairyBanItems, annexMotorBanItems,
  annexAlcoholBanItems, annexAutoAddItems, annexAutoRemoveItems, annexAlcoholScopeAddItems, annexAlcoholScopeRemoveItems,
  removedCodes, addedCodes, listCountDrop, annexJulyItems, annexJulyDairyItems, annexJulyAlcoholItems, annexJulyMotorItems,
  gsaDirectedUsd, daysJulyProcToOriginalEffective, daysSeptModifyToEffective,
  rollbackConsumer2025, rollbackOther2025, springUpdateTariffFreePct,
  springUpdateAvgTariffCanada, springUpdateAvgTariffGlobal,
} from "../../../data/canadatariffs202609.mjs";
