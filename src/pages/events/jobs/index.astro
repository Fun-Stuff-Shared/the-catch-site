---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { subject } from "../../../data/subjects/jobs.mjs";
import { manifests, recordById } from "../../../lib/record-manifests.mjs";
import { event } from "../../../data/jobs202607.mjs";
const manifest = manifests.find((item) => item.event === event.slug);
---
<BaseLayout title={`${subject.title} | The Catch`} current="Events">
  <div slot="locator" class="locator"><span>EVENTS</span><span>{subject.title}</span></div>
  <div class="content"><main class="subject"><h1>{subject.title}</h1><p class="dek">{subject.dek}</p><section class="current"><h2>What holds now</h2><div class="kpis">{subject.current.map((item) => <a href={`/records/${item.record_id}/`}><strong>{item.value}<small> {item.unit}</small></strong><span>{item.label} <em>set {item.as_of}</em></span></a>)}</div></section><section><h2>Events</h2><details open><summary><time>{event.date}</time><span>{event.title}</span></summary><p>{event.dek}</p>{manifest.sub_events.map((subEvent) => <section class="subevent" id={subEvent.section_anchor}><h3>{subEvent.date} · {subEvent.label}</h3><ul>{subEvent.records.map((id) => { const record = recordById.get(id); return <li><a href={`/records/${id}/`}>{record.title}</a><small>{record.publisher} · “{record.quote}”</small></li>; })}</ul></section>)}<a class="story" href={`/events/${event.slug}/`}>Read the full story</a></details></section></main></div>
</BaseLayout>
<style>.subject{max-width:52rem;margin:0 auto;padding:2rem 1.25rem 4rem}h1,h2,h3{font-family:"Newsreader",Georgia,serif}h1{font-size:clamp(2rem,4vw,2.8rem);margin:0}.dek{font:1.1rem/1.5 "Newsreader",Georgia,serif;color:#3c434b}.current h2,section>h2{border-bottom:1px solid #e3e0da;padding-bottom:.5rem}.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr));gap:1px;background:#e3e0da}.kpis a{background:#fbfaf8;padding:1rem;color:inherit;text-decoration:none}.kpis strong{display:block;font:1.35rem "IBM Plex Mono",monospace}.kpis small,.kpis span,.kpis em{font:.75rem "Public Sans",sans-serif;color:#5b6470}.kpis em{display:block;margin-top:.25rem}details{border-bottom:1px solid #e3e0da;padding:1rem 0}summary{cursor:pointer;font:700 1.15rem/1.3 "Newsreader",Georgia,serif}summary time{font:.75rem "IBM Plex Mono",monospace;color:#5b6470;margin-right:.6rem}.subevent{margin:1.4rem 0}.subevent h3{font-size:1rem}.subevent ul{list-style:none;padding:0}.subevent li{border-top:1px solid #e3e0da;padding:.6rem 0}.subevent small{display:block;font:.78rem/1.4 "Public Sans",sans-serif;color:#5b6470;margin-top:.2rem}.story{font-family:"Public Sans",sans-serif}</style>
