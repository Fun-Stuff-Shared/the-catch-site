---
import BaseLayout from "../../layouts/BaseLayout.astro";
import newsData from "../../data/news-data.json";

const rows = newsData.rows;
const articleMap = new Map();
for (const row of rows) {
  if (!articleMap.has(row.article_id)) articleMap.set(row.article_id, []);
  articleMap.get(row.article_id).push(row);
}
const articles = [...articleMap.entries()]
  .map(([articleId, articleRows]) => ({ articleId, rows: articleRows }))
  .sort((a, b) => a.articleId.localeCompare(b.articleId));
const slugFor = (articleId) => encodeURIComponent(articleId).replace(/%/g, "-").toLowerCase();
const corrections = newsData.corrections.length;
const coreCount = rows.filter((row) => row.claim_class === "core").length;
const contextCount = rows.filter((row) => row.claim_class === "context").length;
const matchedToCitedPassageCount = rows.filter((row) => typeof row.quote === "string" && row.quote.trim()).length;
---
<BaseLayout title="News · The Catch" current="News">
  <div class="content">
    <main class="method-main">
      <p class="matter-kicker">News &middot; eligibility export</p>
      <h1>News records</h1>
      <p class="lede">Checked claims grouped by the article they came from. Each article opens to its claims, source quotes, and attached context.</p>
      <section class="news-summary" aria-label="News coverage summary">
        <h2>Current coverage</h2>
        <div class="news-counts">
          <span><b>{articles.length}</b> articles</span>
          <span class="news-count-separator" aria-hidden="true">&middot;</span>
          <span><b>{rows.length}</b> eligible claims</span>
          <span class="news-count-separator" aria-hidden="true">&middot;</span>
          <span><b>{coreCount}</b> core</span>
          <span class="news-count-separator" aria-hidden="true">&middot;</span>
          <span><b>{contextCount}</b> context</span>
          <span class="news-count-separator" aria-hidden="true">&middot;</span>
          <span><b>{matchedToCitedPassageCount}</b> matched to cited passage</span>
          <span class="news-count-separator" aria-hidden="true">&middot;</span>
          <span><b>{corrections}</b> corrections</span>
        </div>
      </section>
      {articles.length === 0 ? <p class="lede">No eligible news articles are currently available.</p> : <section class="news-article-index">
        <h2>Articles</h2>
        <ul class="matters-grid">
          {articles.map(({ articleId, rows: articleRows }) => {
            const first = articleRows[0];
            const publishers = [...new Set(articleRows.map((row) => row.publisher).filter(Boolean))];
            const articleTitle = articleRows.find((row) => row.article_title)?.article_title
              ?? articleRows.find((row) => row.claim_class === "core")?.proposition
              ?? articleRows.find((row) => row.proposition)?.proposition
              ?? "News article record";
            const publishedAt = articleRows.find((row) => row.published_at)?.published_at;
            const articleMeta = [publishers.join(", "), publishedAt].filter(Boolean).join(" · ");
            return <li><a href={`/news/${slugFor(articleId)}/`}>
              <span class="mt-status st-blue">{articleRows.length} {articleRows.length === 1 ? "eligible claim" : "eligible claims"}</span>
              <span class="mt-title">{articleTitle}</span>
              {articleMeta && <span class="mt-finding">{articleMeta}</span>}
              <span class="mt-meta">{articleRows.filter((row) => row.claim_class === "core").length} core &middot; {articleRows.filter((row) => row.claim_class === "context").length} context</span>
            </a></li>;
          })}
        </ul>
      </section>}
      <section class="news-corrections">
        <h2>Corrections</h2>
        {corrections === 0 ? <p class="m-note">No corrections recorded.</p> : <p class="m-note">{corrections} correction {corrections === 1 ? "is" : "are"} recorded in the visible ledger.</p>}
      </section>
      <p class="m-note">This page is generated from the pinned eligibility export and renders only rows marked eligible.</p>
    </main>
  </div>
</BaseLayout>
