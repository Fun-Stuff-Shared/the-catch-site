---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import NewsArticleHeader from "../../../components/NewsArticleHeader.astro";
import NewsClaimCard from "../../../components/NewsClaimCard.astro";
import newsData from "../../../data/news-data.json";

const humanCorroboration = (label) => label === "cross_publisher" ? "Reported by multiple outlets" : label === "single_source" ? "Single source" : "Corroboration unavailable";
export function getStaticPaths() {
  const slugFor = (articleId) => encodeURIComponent(articleId).replace(/%/g, "-").toLowerCase();
  const grouped = new Map();
  for (const row of newsData.rows) {
    if (!grouped.has(row.article_id)) grouped.set(row.article_id, []);
    grouped.get(row.article_id).push(row);
  }
  return [...grouped.entries()].map(([articleId, rows]) => ({ params: { slug: slugFor(articleId) }, props: { articleId, rows } }));
}
const { articleId, rows } = Astro.props;
const core = rows.filter((row) => row.claim_class === "core");
const attached = new Map();
for (const row of core) {
  for (const context of row.attached_context_claims ?? []) {
    if (!attached.has(context.claim_id)) attached.set(context.claim_id, { ...context, corroboration_label: row.corroboration_label });
  }
}
for (const row of rows.filter((item) => item.claim_class === "context")) {
  if (!attached.has(row.claim_id)) attached.set(row.claim_id, row);
}
const contextRows = [...attached.values()];
const corrections = newsData.corrections.filter((correction) => core.some((row) => row.claim_id === correction.claim_id));
---
<BaseLayout title={`News article · The Catch`} current="News">
  <div class="content">
    <main class="main">
      <NewsArticleHeader article={rows} articleId={articleId} count={rows.length} />
      <section class="news-claims" aria-label="Core claims">
        <h2 class="news-section-title">Core claims</h2>
        {core.length === 0 ? <p class="m-note">No core claims are present in this article record.</p> : core.map((claim) => <NewsClaimCard claim={claim} corroborationLabel={humanCorroboration(claim.corroboration_label)} />)}
      </section>
      <section class="news-context" aria-label="Attached context">
        <h2 class="news-section-title">Attached context</h2>
        {contextRows.length === 0 ? <p class="m-note">No attached context entries are present.</p> : contextRows.map((claim) => <NewsClaimCard claim={claim} context={true} corroborationLabel={humanCorroboration(claim.corroboration_label)} />)}
      </section>
      <section class="news-corrections">
        <h2 class="news-section-title">Corrections</h2>
        {corrections.length === 0 ? <p class="m-note">No corrections recorded for this article.</p> : corrections.map((correction) => <p>{correction.correction_text ?? "Correction recorded."}</p>)}
      </section>
      <p class="m-note"><a href="/news/">Back to all news articles</a></p>
    </main>
  </div>
</BaseLayout>
