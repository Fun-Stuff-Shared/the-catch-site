---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { records } from "../../lib/record-manifests.mjs";
export function getStaticPaths() { return records.map((record) => ({ params: { id: record.id }, props: { record } })); }
const { record } = Astro.props;
const usedIn = record.subject === "news" ? [] : [record.story, `/events/${record.subject}/`];
---
<BaseLayout title={`${record.title} | The Catch`} current="Records">
  <div slot="locator" class="locator"><span>RECORD</span><span>{record.publisher}</span></div>
  <div class="content"><main class="record-page"><p class="record-kicker">A record is the original document behind a story.</p><h1>{record.title}</h1><p class="record-sub">{record.publisher} · {record.date}</p><section class="excerpt"><p class="excerpt-label">The document says</p><blockquote>{record.quote}</blockquote></section><p class="record-note">This passage is checked against the saved copy of the document.</p><p class="original"><a href={record.url} rel="noreferrer">Read the original</a>{record.pinned_path && <> <span>·</span> <a href={`/records/pins/${record.id}/`}>Open the saved copy</a></>}</p><section class="used"><h2>Used in</h2><ul>{usedIn.map((href, index) => <li><a href={href}>{index === 0 ? "This event story" : "Its standing record"}</a></li>)}</ul>{record.subEvents.length > 0 && <p>{record.subEvents.map((subEvent) => subEvent.label).join(", ")}.</p>}</section></main></div>
</BaseLayout>
<style>.record-page{max-width:44rem;margin:0 auto;padding:2rem 1.25rem 4rem}.record-kicker,.excerpt-label{font:.72rem "IBM Plex Mono",monospace;letter-spacing:.07em;text-transform:uppercase;color:#5b6470}h1{font:700 clamp(1.8rem,4vw,2.6rem)/1.1 "Newsreader",Georgia,serif;margin:.5rem 0}.record-sub,.record-note,.original,.used{font:.9rem/1.55 "Public Sans",sans-serif;color:#454c55}.excerpt{background:#fbfaf8;border:1px solid #e3e0da;border-top:3px solid #2e7d5b;padding:1rem 1.25rem;margin:1.5rem 0}blockquote{margin:.4rem 0 0;font:1.15rem/1.55 "Newsreader",Georgia,serif}.used{border-top:1px solid #e3e0da;margin-top:2rem;padding-top:1rem}.used h2{font:700 1.3rem "Newsreader",Georgia,serif;margin:0}.used ul{padding-left:1.2rem}</style>
