---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { records } from "../../lib/record-manifests.mjs";
const ordered = [...records].sort((a, b) => b.date.localeCompare(a.date) || a.id.localeCompare(b.id));
const subjects = [...new Set(ordered.map((record) => record.subject))];
---
<BaseLayout title="Records | The Catch" current="Records">
  <div slot="locator" class="locator"><span>RECORDS</span><span>Original documents</span></div>
  <div class="content"><main class="records-index"><h1>Records</h1><p class="lede">A record is the original document behind an event. Start with the document, then see where its words are used.</p><nav aria-label="Record subjects" class="subjects">{subjects.map((subject) => <a href={`#${subject}`}>{subject.replaceAll("-", " ")}</a>)}</nav>{subjects.map((subject) => <section id={subject}><h2>{subject.replaceAll("-", " ")}</h2><ul>{ordered.filter((record) => record.subject === subject).map((record) => <li><a href={`/records/${record.id}/`}><span>{record.title}</span><small>{record.publisher} · {record.date}</small></a></li>)}</ul></section>)}</main></div>
</BaseLayout>
<style>.records-index{max-width:48rem;margin:0 auto;padding:2rem 1.25rem 4rem}h1{font:700 clamp(2rem,4vw,2.8rem)/1.1 "Newsreader",Georgia,serif;margin:0 0 .5rem}.lede{font:1.1rem/1.55 "Newsreader",Georgia,serif;color:#3c434b;max-width:42rem}.subjects{display:flex;gap:.5rem;flex-wrap:wrap;margin:1.5rem 0 2rem}.subjects a{font:.78rem "Public Sans",sans-serif;color:#22604a}section{margin-top:2rem}h2{font:700 1.4rem "Newsreader",Georgia,serif;border-bottom:1px solid #e3e0da;padding-bottom:.45rem;text-transform:capitalize}ul{list-style:none;padding:0;margin:0}li{border-bottom:1px solid #e3e0da}li a{color:inherit;display:block;padding:.85rem 0;text-decoration:none}li span{display:block;font:700 1.05rem/1.3 "Newsreader",Georgia,serif}small{display:block;color:#5b6470;font:.78rem "Public Sans",sans-serif;margin-top:.2rem}</style>
