---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import immigration from "../../../data/officials/marco-rubio/episodes/immigration-2013.json";
import zika from "../../../data/officials/marco-rubio/episodes/zika-2016.json";
import { votesForEpisode, keyVotesForEpisode } from "../../../lib/official-votes.mjs";
const episodes = [zika, immigration].map((episode) => ({ ...episode, votes: votesForEpisode(episode), keyVotes: keyVotesForEpisode(episode) }));
const voteCount = episodes.reduce((total, episode) => total + episode.votes.length, 0);
const keyVoteCount = episodes.reduce((total, episode) => total + episode.keyVotes.length, 0);
---
<BaseLayout title="Marco Rubio | The Catch" current="Officials"><div slot="locator" class="locator"><a href="/officials/">OFFICIALS</a><span>Marco Rubio</span></div><div class="content"><main class="subject"><p class="subject-kicker">Standing record · Marco Rubio</p><h1>Marco Rubio: what he said and how he voted</h1><p class="subject-dek">Secretary of State since 2025; U.S. Senator from Florida from 2011 to 2025. Each episode pairs a statement with every recorded Senate roll call on the same measure.</p><div class="kpi-strip"><div class="kpi"><span class="kpi-value">{episodes.length}</span><span class="kpi-label">episodes</span></div><div class="kpi"><span class="kpi-value">{voteCount}</span><span class="kpi-label">roll calls listed</span></div><div class="kpi"><span class="kpi-value">{keyVoteCount}</span><span class="kpi-label">key votes</span></div></div><section><h2>The episodes</h2><ol class="decision-timeline">{episodes.map((episode) => <li><span class="dt-date">{episode.statements[0]?.date}</span><div class="dt-body"><p class="dt-head"><a href={`/officials/marco-rubio/${episode.slug}/`}>{episode.title}</a></p><p class="dt-sub">{episode.dek} <span class="chip chip-ok">{episode.votes.length} roll calls</span></p></div></li>)}</ol></section><section><h2>Patterns in the record</h2><p class="subject-dek">Beyond single episodes: recurring positions found across his statements, posts, bills, and all 4,612 recorded Senate votes, with the places where the record pulls in two directions. <a href="/officials/marco-rubio/patterns/">See the patterns</a>.</p></section><p class="subject-note">The vote lists are generated from the Senate’s roll-call XML. Statements link to their checked source bytes. These pages show what was said and what was voted, without assigning motive.</p></main></div></BaseLayout>
<style>
  .subject { max-width: 52rem; margin: 0 auto; padding: 1.5rem 1.25rem 4rem; }.subject-kicker,.dt-date,.kpi-label{font-family:"IBM Plex Mono",monospace;font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;color:#5b6470}.subject h1,.subject h2,.dt-head{font-family:"Newsreader",Georgia,serif}.subject h1{font-size:clamp(1.9rem,4.5vw,2.6rem);margin:0}.subject-dek,.dt-sub,.subject-note{font-family:"Newsreader",Georgia,serif;font-size:1.08rem;line-height:1.5}.kpi-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#e3e0da;border:1px solid #e3e0da}.kpi{background:#fbfaf8;padding:.85rem}.kpi-value{font-family:"IBM Plex Mono",monospace;font-size:1.4rem}.decision-timeline{list-style:none;padding:0}.decision-timeline li{display:grid;grid-template-columns:9.5rem 1fr;gap:1rem;border-bottom:1px solid #e3e0da;padding:1rem 0}.dt-head{font-size:1.15rem;margin:0}.dt-sub{margin:.25rem 0}.chip{font-family:"IBM Plex Mono",monospace;font-size:.66rem;padding:.1rem .45rem;background:#e7f2ec;color:#22604a}@media(max-width:640px){.kpi-strip{grid-template-columns:1fr}.decision-timeline li{grid-template-columns:1fr}}
</style>
