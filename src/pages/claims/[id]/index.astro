---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Locator from "../../../components/Locator.astro";
import StatusBlock from "../../../components/StatusBlock.astro";
import EvidenceStack from "../../../components/EvidenceStack.astro";
import CorrectionPanel from "../../../components/CorrectionPanel.astro";
import RecordRail from "../../../components/RecordRail.astro";
import { allClaims, records } from "../../../lib/export.mjs";
import { presentationFor, splitHeadline } from "../../../lib/presentation.mjs";


export function getStaticPaths() {
  return allClaims.flatMap((record) => record.reader_slug === record.claim_id
    ? [{ params: { id: record.reader_slug }, props: { record, legacy: false } }]
    : [
      { params: { id: record.reader_slug }, props: { record, legacy: false } },
      { params: { id: record.claim_id }, props: { record, legacy: true } },
    ]);
}

const { record, legacy = false } = Astro.props;
const presentation = presentationFor(record);
const headlineBase = splitHeadline(presentation.matterTitle).base;
const docSiblings = presentation.relatedClaims
  .map((related) => {
    const sibling = records.find((item) => item.reader_slug === related.reader_slug);
    const headline = sibling?.reader_headline ?? related.reader_headline ?? related.title ?? "";
    return { reader_slug: related.reader_slug, ...splitHeadline(headline) };
  })
  .filter((related) => related.base === headlineBase);
const eventRecordCount = record.event_slug ? records.filter((item) => item.event_slug === record.event_slug).length : 0;
---
{record.record_kind === "alias" ? <>
  <BaseLayout title="Record merged | The Catch" canonicalPath={record.redirect.target} redirectPath={record.redirect.target}>
    <div class="content"><main class="method-main"><h1>This record has been merged</h1><p class="lede">This decision is now served as a single record covering all of its source documents.</p><p><a href={record.redirect.target}>Continue to the record</a></p></main></div>
  </BaseLayout>
</> : legacy ? <>
  <BaseLayout title={`${presentation.pageTitle} | The Catch`} canonicalPath={`/claims/${record.reader_slug}/`} redirectPath={`/claims/${record.reader_slug}/`}>
    <div class="content"><main class="method-main"><h1>This record has moved</h1><p class="lede">Opening the permanent record address.</p><p><a href={`/claims/${record.reader_slug}/`}>Continue to the record</a></p></main></div>
  </BaseLayout>
</> : <BaseLayout title={`${presentation.pageTitle} | The Catch`}>
  <Locator slot="locator" record={record} presentation={presentation} />
  {record.publication_status === "pulled" ? <div class="content"><main class="main"><section class="status contradicted"><div class="kicker">Claim status</div><div class="finding">{presentation.verificationStatus}</div><p class="scope">Withdrawal date: {presentation.eventDate}</p></section><CorrectionPanel record={record} presentation={presentation} /></main><RecordRail presentation={presentation} /></div> : <div class="content"><main class="main"><p class="matter-kicker">Record</p><p class="source-byline">{presentation.sourceByline}</p><h1 class="proposition">{presentation.matterTitle}</h1>{presentation.findingLine && <p class="finding-line">{presentation.findingLine}</p>}{presentation.instances.length > 0 && <div class="instances"><span class="inst-label">Claimed by</span>{presentation.instances.map((instance) => <span class="inst"><b>{instance.speaker}</b>, {instance.role}, {instance.date}</span>)}</div>}<StatusBlock record={record} presentation={presentation} /><CorrectionPanel record={record} presentation={presentation} /><EvidenceStack evidence={presentation.evidence} viewer={presentation.evidenceViewer} normalizationNote={presentation.checkedPropositionNote} />{(docSiblings.length > 0 || (presentation.eventPath && eventRecordCount > 1)) && <section class="related-records"><h2>Related records</h2>{docSiblings.length > 0 && <p>This decision is also recorded in {docSiblings.map((related, index) => <>{index > 0 && ", "}<a href={`/claims/${related.reader_slug}/`}>the {related.docLabel ?? "companion record"}</a></>)}.</p>}{presentation.eventPath && eventRecordCount > 1 && <p>This record is part of <a href={presentation.eventPath}>{presentation.eventTitle}</a>, an event record with {eventRecordCount} entries.</p>}</section>}{presentation.coverageRows.length > 0 && <section class="event-coverage" aria-label="Coverage"><h2>Coverage</h2><p class="coverage-intro">How this event is being reported. Shown separately from the checked record.</p><ul class="coverage-list">{presentation.coverageRows.map((item) => <li class="coverage-item"><a href={item.source_url} rel="noreferrer"><span class="coverage-outlet">{item.outlet}</span><span class="coverage-headline">{item.headline}</span>{item.dateLabel && <span class="coverage-date">{item.dateLabel}</span>}</a></li>)}</ul></section>}<p class="body-note">The record preserves the source wording, its location, and the dated history of review.</p></main><RecordRail presentation={presentation} /></div>}
</BaseLayout>}
