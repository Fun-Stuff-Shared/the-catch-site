---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArchiveNav from "../components/ArchiveNav.astro";
import { records } from "../lib/export.mjs";
import { archiveGroups } from "../lib/date-archive.mjs";
import RecordCardList from "../components/RecordCardList.astro";
import { eventGroups, eventPath, warrantedEvents } from "../lib/events.mjs";
import { formatDate } from "../lib/presentation.mjs";

const archive = archiveGroups(records);
const events = eventGroups(records).slice().reverse();
const warrantedSlugs = new Set(warrantedEvents(records).map((group) => group.slug));
const latestEvent = events[0];
const earlierEvents = events.slice(1);
const ungrouped = records.filter((record) => !record.event_slug);
const latestRecords = latestEvent ? latestEvent.records : records;
---
<BaseLayout title="The Catch">
  <div class="content">
    <main class="method-main">
      <h1>The Catch</h1>
      <p class="lede">Verified public record surface.</p>
      {records.length === 0 && (
        <p class="lede">
          The first records are in preparation. The <a href="/methodology">methodology</a> is
          published; every record will carry its source quote, verification status, and full
          correction history from day one.
        </p>
      )}
      <ArchiveNav archive={archive} />
      {latestEvent && <section aria-label="Latest event">
        <h2 class="home-section">Latest{latestEvent.title ? `: ${latestEvent.title}` : ""}</h2>
        {latestEvent.date && <p class="source-byline">{formatDate(latestEvent.date)} · {latestRecords.length} {latestRecords.length === 1 ? "record" : "records"}</p>}
      </section>}
      <RecordCardList records={latestRecords} />
      {earlierEvents.length > 0 && <section aria-label="Earlier events">
        <h2 class="home-section">Earlier events</h2>
        <ul class="event-index">
          {earlierEvents.map((event) => <li><a href={warrantedSlugs.has(event.slug) ? eventPath(event.slug) : `/claims/${event.records[0].reader_slug}/`}><span class="ei-title">{event.title}</span><span class="ei-meta">{event.date ? `${formatDate(event.date)} · ` : ""}{event.records.length} {event.records.length === 1 ? "record" : "records"}</span></a></li>)}
        </ul>
      </section>}
      {ungrouped.length > 0 && <RecordCardList records={ungrouped} />}
    </main>
  </div>
</BaseLayout>
