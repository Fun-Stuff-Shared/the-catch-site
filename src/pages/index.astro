---
import BaseLayout from "../layouts/BaseLayout.astro";
import { readdirSync, readFileSync } from "node:fs";
import { join } from "node:path";
import { event as juneRate } from "../data/fomc20260617.mjs";
import { event as julyRate } from "../data/fomc20260729.mjs";
import { event as julyJobs } from "../data/jobs202607.mjs";

const manifestDir = join(process.cwd(), "checks", "manifests");
const manifestRoutes = new Set(readdirSync(manifestDir)
  .filter((name) => name.endsWith(".json"))
  .map((name) => JSON.parse(readFileSync(join(manifestDir, name), "utf8")))
  .map((manifest) => manifest.story || `/events/${manifest.event}/`));
const event = [juneRate, julyRate, julyJobs]
  .filter((item) => manifestRoutes.has(`/events/${item.slug}/`))
  .sort((a, b) => String(b.date).localeCompare(String(a.date)))[0];
const monthLabel = new Date(event.date).toLocaleDateString("en-US", { month: "long", year: "numeric", timeZone: "UTC" });
---
<BaseLayout title="The Catch" current="Home">
  <div slot="locator" class="locator"><span>THE CATCH</span><span>Checked claims, kept permanently</span></div>
  <div class="content">
    <main class="front">
      <p class="front-lede">We capture what powerful institutions actually said and did, quote it from the
      primary record, and check the coverage against it. Corrections are permanent, dated, and public.</p>

      <section class="front-feature">
        <p class="ff-kicker">Latest story &middot; {monthLabel}</p>
        <h2><a href={`/events/${event.slug}/`}>{event.title}</a></h2>
        <p class="ff-dek">{event.dek}</p>
        <div class="ff-kpis">
          {event.kpis.map((k) => (
            <span class="ff-kpi"><b>{k.value}{k.unit === "%" ? "%" : ""}{k.unit && k.unit !== "%" && k.unit !== "pctile" ? ` ${k.unit}` : ""}</b> {k.label}</span>
          ))}
        </div>
        <p class="ff-link"><a href={`/events/${event.slug}/`}>Read the story &rarr;</a> <span class="ff-sep">&middot;</span> <a href="/events/fed-rate/">The federal funds rate, the standing record</a></p>
      </section>

      <section class="front-cols">
        <div class="fc">
          <h3><a href="/officials/">Officials</a></h3>
          <p>Public officials' own words beside their recorded actions, with the sources and limits of each episode.</p>
        </div>
        <div class="fc">
          <h3><a href="/records/">Records</a></h3>
          <p>The primary documents themselves: statements, minutes, filings, quoted and linked.</p>
        </div>
        <div class="fc">
          <h3><a href="/methodology">Methodology</a></h3>
          <p>How records are captured, quoted, checked, and corrected.</p>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  .front { max-width: 46rem; margin: 0 auto; padding: 1.5rem 1.25rem 4rem; }
  .front-lede { font-family: "Newsreader", Georgia, serif; font-size: 1.2rem; line-height: 1.55; color: #3c434b; margin: 1.75rem 0 2rem; }
  .front-feature { border: 1px solid #e3e0da; border-top: 3px solid #c98a1b; background: #fbfaf8; padding: 1.25rem 1.5rem 1.1rem; }
  .ff-kicker { font-family: "IBM Plex Mono", monospace; font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; color: #5b6470; margin: 0 0 0.5rem; }
  .ff-sep { color: #b9b4aa; margin: 0 0.3rem; }
  .front-feature h2 { font-family: "Newsreader", Georgia, serif; font-weight: 700; font-size: clamp(1.4rem, 3.5vw, 1.9rem); line-height: 1.18; margin: 0 0 0.5rem; text-wrap: balance; }
  .front-feature h2 a { color: inherit; text-decoration: none; }
  .front-feature h2 a:hover { text-decoration: underline; }
  .ff-dek { font-family: "Newsreader", Georgia, serif; font-style: italic; font-size: 1.02rem; line-height: 1.5; color: #3c434b; margin: 0 0 0.9rem; }
  .ff-kpis { display: flex; flex-wrap: wrap; gap: 0.4rem 1.2rem; margin-bottom: 0.9rem; }
  .ff-kpi { font-family: "Public Sans", system-ui, sans-serif; font-size: 0.8rem; color: #5b6470; }
  .ff-kpi b { font-family: "IBM Plex Mono", monospace; font-size: 0.95rem; color: #14181b; }
  .ff-link { margin: 0; }
  .ff-link a { font-family: "Public Sans", system-ui, sans-serif; font-weight: 600; font-size: 0.9rem; }
  .front-cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; margin-top: 2rem; }
  .fc h3 { font-family: "Newsreader", Georgia, serif; font-size: 1.15rem; margin: 0 0 0.35rem; }
  .fc p { font-family: "Public Sans", system-ui, sans-serif; font-size: 0.85rem; line-height: 1.5; color: #5b6470; margin: 0; }
</style>
