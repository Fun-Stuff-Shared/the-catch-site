---
import BaseLayout from '../layouts/BaseLayout.astro';
import StoryLink from '../components/StoryLink.astro';
import { storyCatalog, series } from '../lib/discovery.mjs';
const stories = storyCatalog();
const topics = [...new Set(stories.map(s => s.topic))];
---
<BaseLayout title="The Catch" current="Home" localSearch>
  <main class="discovery" id="main-content">
    <h1 class="sr-only">Latest reporting</h1>
    <div class="discovery-controls">
      <div class="topic-filters" aria-label="Filter stories by topic"><button data-topic-filter="" aria-pressed="true">All topics</button>{topics.map(topic => <button data-topic-filter={topic} aria-pressed="false">{topic}</button>)}</div>
      <form class="story-search" role="search"><label class="sr-only" for="story-query">Search stories</label><input id="story-query" name="q" type="search" placeholder="Search stories" autocomplete="off" /><button type="submit" aria-label="Search stories"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></button></form>
    </div>
    <div class="discovery-layout"><section aria-label="Stories"><p id="search-status" class="search-status" role="status" aria-live="polite"></p><div class="story-feed">{stories.map((story, i) => <StoryLink story={story} lead={i === 0} />)}</div><div class="search-empty" hidden><h3>No stories found</h3><p>Try another word or choose a different topic.</p><button data-clear-search>Clear search and filters</button></div><nav class="feed-pagination" aria-label="Story pages" hidden><button data-prev-page>Previous</button><span data-page-label></span><button data-next-page>Next</button></nav></section>
    <aside class="series-aside"><h2>Follow a series</h2>{series.slice(0, 4).map(s => <div><h3><a href={s.path}>{s.title}</a></h3><p>{s.description}</p></div>)}<a class="read-link" href="/events/">Browse series <span aria-hidden="true">↗</span></a><div class="reading-note"><h3>Choose your depth</h3><p>The story gives you context. Just the facts keeps it brief. Show the work opens the evidence.</p><a href="/events/jobs/july-2026/">Try the three views</a></div></aside></div>
  </main>
</BaseLayout>
<script>
  import '../scripts/discovery';
</script>
