---
import EvidenceReader from "../components/EvidenceReader.astro";
const { title, current = "Records", canonicalPath = null, redirectPath = null, noindex = false } = Astro.props;
const navItems = [["Latest", "/", "Home"], ["Series", "/events/", "Events"], ["People", "/officials/", "Officials"], ["How we check", "/methodology/", "Methodology"]];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex" />}
    {canonicalPath && <link rel="canonical" href={canonicalPath} />}
    {redirectPath && <meta http-equiv="refresh" content={`0; url=${redirectPath}`} />}
    <link rel="stylesheet" href="/assets/the-catch.css" />
    <link rel="stylesheet" href="/assets/reader.css" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="sheet">
      <header class="band">
        <div class="band-inner">
          <a class="wordmark" href="/">The Catch<b>.</b></a>
          <span class="desc">A permanent record of checked claims</span>
          <button class="nav-toggle" aria-expanded="false" aria-controls="site-navigation">Menu <span aria-hidden="true">☰</span></button>
          <nav id="site-navigation" aria-label="Main navigation">
            {navItems.map(([label, href, key]) => <a href={href} aria-current={key === current ? "page" : undefined}>{label}</a>)}
          </nav>
          <button class="search-toggle" aria-label="Search" aria-expanded="false" aria-controls="global-search"><span>Search</span><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></button>
          <form class="global-search" id="global-search" action="/" role="search"><label class="sr-only" for="story-query">Search stories</label><input id="story-query" name="q" type="search" placeholder="Search stories" autocomplete="off" /><button type="submit" aria-label="Search stories"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></button></form>
          <section id="search-results" class="search-results" aria-label="Matching stories" hidden><p role="status" aria-live="polite" data-search-message></p><ul data-search-matches></ul><a data-all-results href="/">View all results</a></section>
        </div>
      </header>
      <slot name="locator" />
      <slot />
      <footer class="colophon">
        <p>Published records carry their review status on the page. Work that has not been published is clearly labeled. Corrections and withdrawals are permanent, dated, and public.</p>
        <p><a href="/">The Catch</a> <a href="/methodology">How we check</a> <a href="/records/">Source library</a></p>
      </footer>
    </div>
    <EvidenceReader />
  </body>
</html>

<script>
  import '../scripts/story-toc';
  import '../scripts/global-search';
  const searchToggle = document.querySelector<HTMLButtonElement>('.search-toggle');
  const searchInput = document.querySelector<HTMLInputElement>('#story-query');
  const openSearch = () => { searchToggle?.setAttribute('aria-expanded', 'true'); searchInput?.focus(); };
  searchToggle?.addEventListener('click', () => { if (searchToggle.getAttribute('aria-expanded') === 'true') searchToggle.setAttribute('aria-expanded','false'); else { closeMenu(); openSearch(); } });
  document.addEventListener('keydown', e => { if(e.key === 'Escape' && searchToggle?.getAttribute('aria-expanded') === 'true') { searchToggle.setAttribute('aria-expanded','false'); searchToggle.focus(); } });
  const menu = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const closeMenu = () => { menu?.setAttribute('aria-expanded', 'false'); };
  menu?.addEventListener('click', () => { searchToggle?.setAttribute('aria-expanded','false'); menu.setAttribute('aria-expanded', String(menu.getAttribute('aria-expanded') !== 'true')); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && menu?.getAttribute('aria-expanded') === 'true') { closeMenu(); menu.focus(); } });
  document.addEventListener('click', e => { if (!(e.target as Element).closest('.band')) { closeMenu(); searchToggle?.setAttribute('aria-expanded', 'false'); } });
  const main = document.querySelector('main');
  if(main && !main.id) main.id = 'main-content';
  document.querySelector('.skip-link')?.setAttribute('href', '#' + (main?.id ?? 'main-content'));
  if(new URLSearchParams(location.search).get('focus') === 'search') openSearch();
</script>
