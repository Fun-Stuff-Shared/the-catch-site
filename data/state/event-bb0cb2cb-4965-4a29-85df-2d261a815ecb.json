          "event_id": "event-bb0cb2cb-4965-4a29-85df-2d261a815ecb",
          "evidence_id": "1dd3d8fbc2dc41575ad381806b63c3093db0decb071187ae38b4d80d09c6eca5",
          "figure": null,
          "id": "occurrence-1dd3d8fbc2dc41575ad381806b63c3093db0decb071187ae38b4d80d09c6eca5-f6386cfd65663656",
          "judge": "openai-codex/gpt-5.6-luna",
          "quote_span": "The act specifically established the State Digital Equity Capacity Grant Program, which provides formula funding to states based on various factors such as broadband availability, demographics, and covered populations, and the Digital Equity Competitive Grant Program , which supports organizations implementing community-based digital inclusion initiatives.",
