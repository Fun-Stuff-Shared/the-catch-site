          "asserted_at": "2026-08-26T20:52:58Z",
          "checkable_against": "Digital Equity Act statutory definition of covered populations",
          "claim_type": "actual",
          "envelope_seq": 347064,
          "event_id": "event-bb0cb2cb-4965-4a29-85df-2d261a815ecb",
          "evidence_id": "1dd3d8fbc2dc41575ad381806b63c3093db0decb071187ae38b4d80d09c6eca5",
          "figure": null,
          "id": "occurrence-1dd3d8fbc2dc41575ad381806b63c3093db0decb071187ae38b4d80d09c6eca5-ab845da2e04716f6",
          "judge": "openai-codex/gpt-5.6-luna",
          "quote_span": "The act’s “covered populations” definition also includes a range of impacted populations beyond racial groups, including older adults, incarcerated individuals, veterans, people with disabilities, rural residents, individuals who face a language barrier, and those living in households with incomes at or below 150% of the poverty level.",
