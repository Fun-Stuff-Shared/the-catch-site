          "name": "first round date",
          "value": "2026-12-13",
          "unit": "date",
          "sentence": "The delay, announced Tuesday after a Council of Ministers meeting, suspends the first round of presidential and legislative elections scheduled for Dec. 13, 2026.",
          "occurrence_id": "occurrence-3a96e233960e3f27c5852f825a6093e6c1cf86e8dcc1a09e66ae1378fd190730-278019089095b57b"
