          "name": "prior flight duration",
          "value": "30",
          "unit": "hours",
          "sentence": "The last crew, which took off from the United States, took more than 30 hours to reach the station.",
          "occurrence_id": "occurrence-5896396131e4ef68bdd8acda35b9e3baba29c87a389d55fcc9be0f5cc340dc91-7222f47df6477559"
        },
        {
          "slot_id": "slot-a03577e5-7620-474c-867e-825eb1613003",
          "name": "record flight duration",
          "value": "3",
          "unit": "hours",
          "sentence": "A Russian Soyuz spacecraft set the overall record for a flight to the ISS in October 2020, reaching the station in just over three hours.",
          "occurrence_id": "occurrence-5896396131e4ef68bdd8acda35b9e3baba29c87a389d55fcc9be0f5cc340dc91-c8c319ad7b6d28e5"
        },
        {
