          "value": "6",
          "unit": "trials",
          "sentence": "Flowers was tried in the killings six times.",
          "occurrence_id": "occurrence-6036db947c0c2244b73eff915f915ec850a612bbec5e4f54cbb4d43421582d1b-ad12db990a299d1c"
