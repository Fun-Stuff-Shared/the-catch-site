      "label": "Supreme Court throws out Curtis Flowers conviction and death sentence",
      "status": "published",
      "reason": null,
      "period": "2019-06",
      "follows": "event-c42da59f-a362-4586-977c-c8c545fec3f9",
      "slots": [
        {
          "slot_id": "slot-68e73194-ddd5-449b-ad99-5cc72255e64b",
          "name": "decision vote",
          "value": "7-2",
          "unit": "vote",
          "sentence": "Justice Brett Kavanaugh wrote in the high court’s 7-2 decision in 2019 that the removal of Black prospective jurors deprived Flowers of a fair trial.",
          "occurrence_id": "occurrence-6036db947c0c2244b73eff915f915ec850a612bbec5e4f54cbb4d43421582d1b-ba2e99be12926e74"
        },
        {
          "slot_id": "slot-341e06ef-4e60-47b0-848b-778eaad18302",
          "name": "jurors removed",
          "value": "41",
          "unit": "prospective Black jurors removed",
          "sentence": "Kavanaugh noted that Evans had removed 41 of the 42 prospective Black jurors over the six trials.",
          "occurrence_id": "occurrence-6036db947c0c2244b73eff915f915ec850a612bbec5e4f54cbb4d43421582d1b-05f2ea1a4d302e54"
        }
