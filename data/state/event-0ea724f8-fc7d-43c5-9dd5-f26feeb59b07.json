          "checkable_against": "U.S. Department of Education, 90 Fed. Reg. 30896 (July 11, 2025)",
          "claim_type": "actual",
          "envelope_seq": 369460,
          "event_id": "event-0ea724f8-fc7d-43c5-9dd5-f26feeb59b07",
