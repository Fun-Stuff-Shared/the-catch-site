          "checkable_against": "HUD 90 Fed. Reg. 54364 (November 26, 2025)",
          "claim_type": "actual",
          "envelope_seq": 369692,
          "event_id": "event-0ea724f8-fc7d-43c5-9dd5-f26feeb59b07",
