        {
          "slot_id": "slot-7ca42352-0716-4233-b926-4a8f0559b955",
          "name": "time",
          "value": null,
          "unit": null,
          "sentence": "As most of Moldova slept, around 4.20 a.m. on Sept. 18, residents on the eastern periphery of Chișinău, the capital, reported a bright flash and a sizable explosion.",
          "occurrence_id": "occurrence-1e98b56fa0e5d504edf20f6c37dae3db23c2dce0f77135ac6ddf3e44a81398e8-06a53c69770200d9"
        },
        {
          "slot_id": "slot-2ac5b660-21bc-412e-a92a-9a3271543032",
          "name": "location",
          "value": null,
          "unit": null,
          "sentence": "Police searched for hours to determine the cause before finding the remnants of a drone, including a jet engine, scattered across a harvested field near the village of Colonița.",
          "occurrence_id": "occurrence-1e98b56fa0e5d504edf20f6c37dae3db23c2dce0f77135ac6ddf3e44a81398e8-21bd023d63da32d8"
        },
        {
